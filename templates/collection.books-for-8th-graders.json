    "ssky_faqs_BaRxaJ": {
      "type": "ssky-faqs",
      "blocks": {
        "heading_4grPjJ": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Frequently Asked Questions</h2>",
            "heading_size": "h1",
            "heading_weight": "bold"
          }
        },
        "faq_Qxwx7L": {
          "type": "faq",
          "settings": {
            "text": "<h5>Are These Books Suitable for Advanced Middle School Readers?</h5>",
            "text_size": "regular",
            "text_weight": "bold",
            "answer": "<p>Yes. Our books for 8th graders are written for students ready for deeper ideas and stronger themes. Advanced readers enjoy the thoughtful topics and engaging stories. The writing style keeps reading clear without feeling childish or overly academic.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_hEfftp": {
          "type": "faq",
          "settings": {
            "text": "<h5>Can My Child Read These Books on Their Own?</h5>",
            "text_size": "regular",
            "text_weight": "bold",
            "answer": "<p>Yes. Our books are designed for independent reading. Clear chapter structure and steady pacing help teens stay engaged without feeling overwhelmed. Many families start by reading together and then encourage independent reading as confidence grows.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
