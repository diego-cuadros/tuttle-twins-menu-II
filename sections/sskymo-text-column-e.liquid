{%- liquid
  assign column_with_border = false
  assign column_with_border_padding = false
  assign column_with_border_vtwo = false
  if section.settings.column_with_border == true
    assign column_with_border = true
    if section.settings.column_with_border_padding == true
      assign column_with_border_padding = true
    endif
    if section.settings.column_with_border_vtwo == true
      assign column_with_border_vtwo = true
    endif
  endif
-%}
{%- style -%}
  .ssky-text-column-{{ section.id }} .ssky-text-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<div class="ssky-text-column-{{ section.id }}">
  <div class="ssky-text-column gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width{%- if column_with_border %} ssky-text-column__layout-border{%- if column_with_border_padding %} ssky-text-column__layout-border-padding{%- endif -%}{%- if column_with_border_vtwo %} ssky-text-column__layout-border-v2{%- endif -%}{%- endif -%}">
      <div class="ssky-text-column__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
        {%- for americas_text_column in shop.metaobjects.americas_text_column.values limit: 9 -%}
          {%- if americas_text_column.main_heading != blank -%}
            {%- assign heading_length = americas_text_column.main_heading | metafield_text | size -%}
            <h2
              class="ssky-text-block__heading rte inline-richtext h1{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 1"
              {% endif %}
            >
              {{ americas_text_column.main_heading }}
            </h2>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="ssky-text-column__block-set--top">
          {%- for americas_text_column in shop.metaobjects.americas_text_column.values limit: 9 -%}
            <div
              class="ssky-text-column__block gradient color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading rte h5{%- if column_with_border %} h6{%- unless column_with_border_vtwo %} primary-blue{%- endunless -%}{%- endif -%}">
                  {{ americas_text_column.column_title | metafield_tag }}
                </h4>
                <div class="ssky-text-column__text rte text-body-large">
                  {{ americas_text_column.column_description | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TTm Americas text column",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.border"
    },
    {
      "type": "checkbox",
      "id": "column_with_border",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "column_with_border_padding",
      "label": "t:sections.all.ssky_layouts.extension.borderpadding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "column_with_border_vtwo",
      "label": "t:sections.all.ssky_layouts.extension.bordervtwo",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Americas text column"
    }
  ]
}
{% endschema %}
