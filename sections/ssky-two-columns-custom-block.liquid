{%- style -%}
  .ssky-two-col-custom-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .ssky-two-col-custom-section-{{ section.id }} h2 {
    font-size: 35px;
    margin-top: 0;
  }
  .ssky-two-col-custom-blocks-{{ section.id }} {
    display: grid;
    column-gap: {{section.settings.colspacing}}px;
    row-gap: {{section.settings.rowspacing}}px;
    grid-template-columns: 1fr;    
    {% if section.settings.narrow_width %}
      max-width: 1100px;
    {% endif %}
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .ssky-first-col-custom-block {
    background: {{section.settings.bg_color}};
    color: {{section.settings.text_color}};
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .ssky-first-col-custom-block h3 {
    color: {{section.settings.text_color}};
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block h3 {
    font-size: 25px;
    text-align: center;
    margin-top: 0;
    margin-bottom: 30px;
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .ssky-second-col-custom-block {
    background: {{section.settings.bg_color_b}};
    color: {{section.settings.text_color_b}};
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .ssky-second-col-custom-block h3 {color: {{section.settings.text_color_b}};}
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block {
    padding: {{-section.settings.container_padding-}};
    {% if section.settings.rounded %}
      border-radius: 50px;
    {% endif %}
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-content {
    padding: 0;
    margin: 0;
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block li {
    display: flex;
    align-items: {% if section.settings.align_center %}center{% else %}start{% endif %};
    gap: 10px;
    margin: 0 0 24px;
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block li .icon-block > * {
    width: {{- section.settings.icon_size -}}px;
    height: {{- section.settings.icon_size -}}px;
  }
  .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block li .text-block p {
    margin: 0;
  }
  @media screen and (min-width: 750px) {
    .ssky-two-col-custom-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .ssky-two-col-custom-blocks-{{ section.id }} {grid-template-columns: repeat(2, 1fr);}
    .ssky-two-col-custom-blocks-{{ section.id }} .col-custom-block h3 {margin-bottom: 40px}
  }
{%- endstyle -%}

<div class="ssky-two-col-custom-section-{{ section.id }} page-width">
  {% if section.settings.main_heading != blank %}
   <h2 class="center">{{- section.settings.main_heading -}}</h2>
  {% endif %}
  <div class="ssky-two-col-custom-blocks-{{ section.id }}">
    <div class="ssky-first-col-custom-block col-custom-block">
    {% if section.settings.heading != blank %}
      <h3>{{- section.settings.heading -}}</h3>
    {% endif %}
    <ul class="ssky-first-col-content col-custom-content">
      {%- for block in section.blocks -%}
        {% if block.settings.text != blank %}
          <li>
            {% if section.settings.icon or section.settings.icon_svg != blank %}
              <div class="ssky-first-col-icon icon-block">
                {% if section.settings.icon %}
                  {{ section.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy'}}
                {% else %}
                  {{ section.settings.icon_svg}}
                {% endif %}
              </div>
            {% endif %}            
            <div class="ssky-first-col-text text-block rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}">
              {{ block.settings.text}}
            </div> 
          </li>
        {% endif %}
      {%- endfor -%}
    </ul>
  </div>
  <div class="ssky-second-col-custom-block col-custom-block">
    {% if section.settings.heading_b != blank %}
      <h3>{{- section.settings.heading_b -}}</h3>
    {% endif %}
    <ul class="ssky-second-col-content col-custom-content">
      {%- for block in section.blocks -%}
        {% if block.settings.text_b != blank %}
          <li>
            {% if section.settings.icon_b or section.settings.icon_svg_b != blank %}
              <div class="ssky-first-col-icon icon-block">
                {% if section.settings.icon_b %}
                  {{ section.settings.icon_b | image_url: width: 100 | image_tag: loading: 'lazy'}}
                {% else %}
                  {{ section.settings.icon_svg_b}}
                {% endif %}
              </div>
            {% endif %}            
            <div class="ssky-first-col-text text-block rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}">
              {{ block.settings.text_b}}
            </div> 
          </li>
        {% endif %}     
      {%- endfor -%}
    </ul>
  </div>
  </div>
</div>

{% schema %}
{
  "name": "TT 2 Col Custom block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main heading"
    },
    {
      "type": "header",
      "content": "First column settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#04AED8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "paragraph",
      "content": "Select Icon type"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Image icon"
    },
    {
      "type": "liquid",
      "id": "icon_svg",
      "label": "SVG HTML"
    },
    {
      "type": "header",
      "content": "Second column settings"
    },
    {
      "type": "text",
      "id": "heading_b",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "bg_color_b",
      "label": "Background color",
      "default": "#BCECF6"
    },
    {
      "type": "color",
      "id": "text_color_b",
      "label": "Text color",
      "default": "#3F3939"
    },
    {
      "type": "paragraph",
      "content": "Select Icon type"
    },
    {
      "type": "image_picker",
      "id": "icon_b",
      "label": "Image icon"
    },
    {
      "type": "liquid",
      "id": "icon_svg_b",
      "label": "SVG HTML"
    },
    {
      "type": "header",
      "content": "Layout\/Design settings"
    },
    {
      "type": "range",
      "id": "colspacing",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Column spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "rowspacing",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Section spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "default": false,
      "label": "Narrow width"
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": true,
      "label": "Rounded corner"
    },
    {
      "type": "checkbox",
      "id": "align_center",
      "default": false,
      "label": "Center align Icon and Text"
    },
    {
      "type": "text",
      "id": "container_padding",
      "default": "70px 45px 38px",
      "label": "Column container padding"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "text_with_icon",
      "name": "t:sections.ssky_text_block.blocks.text_with_icon.name",
      "settings": [
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "regular",
              "label": "t:sections.all.text_size.options__0.label"
            },
            {
              "value": "medium",
              "label": "t:sections.all.text_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.all.text_size.options__2.label"
            },
            {
              "value": "extra-large",
              "label": "t:sections.all.text_size.options__3.label"
            }
          ],
          "default": "regular",
          "label": "t:sections.all.text_size.label"
        },
        {
          "type": "select",
          "id": "text_weight",
          "options": [
            {
              "value": "regular",
              "label": "t:sections.all.text_weight.options__0.label"
            },
            {
              "value": "medium",
              "label": "t:sections.all.text_weight.options__1.label"
            },
            {
              "value": "semibold",
              "label": "t:sections.all.text_weight.options__2.label"
            },
            {
              "value": "bold",
              "label": "t:sections.all.text_weight.options__3.label"
            }
          ],
          "default": "regular",
          "label": "t:sections.all.text_weight.label"
        },
        {
          "type": "header",
          "content": "t:sections.ssky_text_block.blocks.text_with_icon.settings.icon_one"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.ssky_text_block.blocks.text_with_icon.settings.text.label",
          "default": "t:sections.ssky_text_block.blocks.text_with_icon.settings.text.default"
        },
        {
          "type": "color",
          "id": "custom_color",
          "label": "Custom text color"
        },
        {
          "type": "header",
          "content": "t:sections.ssky_text_block.blocks.text_with_icon.settings.icon_two"
        },
        {
          "type": "richtext",
          "id": "text_b",
          "label": "t:sections.ssky_text_block.blocks.text_with_icon.settings.text.label"
        },
        {
          "type": "color",
          "id": "custom_color_b",
          "label": "Custom text color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TT 2 Col Custom block"
    }
  ]
}
{% endschema %}