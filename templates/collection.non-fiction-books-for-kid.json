      "blocks": {
        "heading_wWRMjW": {
          "type": "heading",
          "settings": {
            "heading": "<p>Frequently Asked Questions</p>",
            "heading_size": "h1",
            "heading_weight": "bold"
          }
        },
        "faq_KJyBEe": {
          "type": "faq",
          "settings": {
            "text": "<p>What Are Some Good History Books for Kids?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Great history books for kids weave stories with facts. Look for books that tell interesting stories about historical people and events in a way that is appropriate for their age. That's exactly what our America's History books do, empowering children to learn, grow, and start thinking critically.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_t9FyqB": {
          "type": "faq",
          "settings": {
            "text": "<p>What Is The Most Popular Book for 7‑Year‑Olds?</p>",
            "text_size": "medium",
