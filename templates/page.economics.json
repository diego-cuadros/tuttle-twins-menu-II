    "ssky_text_image_block_WV86MP": {
      "type": "ssky-text-image-block",
      "blocks": {
        "section_header_y8iJJG": {
          "type": "section_header",
          "settings": {
            "section_heading": "<p>Most School Curriculum Does Not Equip <br/>Your Children With the Business Skills <br/>They Will Need in the Future</p>",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "subheading": "",
            "text_style_subheading": "large-bold",
            "color_class_subheading": "primary-blue",
            "caption": "",
            "text_style": "large-bold",
            "color_class": "primary-blue"
          }
        },
        "text_4JMYGr": {
          "type": "text",
          "settings": {
            "text": "<p>Our children are entering a more global and entrepreneurial world than ever before. Isn’t it about time we start preparing them for this exciting change?<br/><br/>Maybe you wonder how your children are going to survive and thrive in a world full of socialism, victimhood, and attacks on entrepreneurs.<br/><br/>You want to find a curriculum that helps you teach them economic concepts in a way that can be easily understood. You also want your child to learn how to think rather than what to think, and develop the mental agility needed to navigate media and political rhetoric.</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        }
      },
      "block_order": [
        "section_header_y8iJJG",
        "text_4JMYGr"
      ],
      "settings": {
        "background_position": "center center",
        "background_size": "cover",
        "background_overlay": false,
        "background_overlay_color": "#000000",
        "background_overlay_opacity": 50,
        "image": "shopify://shop_images/free-market-1015x1024.webp",
