        "faq_BjEDfn": {
          "type": "faq",
          "settings": {
            "text": "<p>What Should My 10‑Year‑Old Be Reading?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>At age 10, kids can grasp more serious topics and ask \"why\". Our American history books are a fantastic fit because they encourage kids to ask questions about the history that shaped our world, and answer them at the same time.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_jrbhqQ": {
