{% comment %}
  DO NOT modify this file, its classes, or CSS. It is a universal module.
{% endcomment %}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign merging_with_section_below = false
  assign show_as_card = false
  assign narrow_width = false
  if block.settings.merging_with_section_below == true
    assign merging_with_section_below = true
  elsif block.settings.show_as_card == true
    assign show_as_card = true
  elsif block.settings.narrow_width == true
    assign narrow_width = true
  endif
  if block.settings.image != blank
    if block.settings.image_size == 'small'
      assign image_width = '25%'
      assign text_width = '75%'
    elsif block.settings.image_size == 'smallplus'
      assign image_width = '30%'
      assign text_width = '70%'
    elsif block.settings.image_size == 'medium'
      assign image_width = '50%'
      assign text_width = '50%'
    elsif block.settings.image_size == 'large'
      assign image_width = '70%'
      assign text_width = '30%'
    endif
  else
    assign image_width = '100%'
    assign text_width = '100%'
  endif
-%}
{%- style -%}
  {%- if block.settings.background_image != blank -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      position: relative;
      background-image: url({{ block.settings.background_image | image_url }});
      background-position: {{ block.settings.background_position }};
      background-size: {{ block.settings.background_size }};
      background-repeat: no-repeat;
    }
    
    {%- if block.settings.background_overlay -%}
      .ssky-text-image-block-{{ block.id }} .ssky-text-image-block:after {
        content: '';
        display: block;
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: {{ block.settings.background_overlay_color }};
        opacity: {{ block.settings.background_overlay_opacity | divided_by: 100.0 }};
        pointer-events: none;
        z-index: 1;
      }
      
      .ssky-text-image-block-{{ block.id }} .ssky-text-image-block > * {
        position: relative;
        z-index: 2;
      }
    {%- endif -%}
  {%- endif -%}

  .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__image-column {
    width: 100%;
  }
  {% unless block.settings.rounded %}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__image-column .ssky-text-image-block__image > .media {
      border-radius: 0;
    }
  {% endunless %}
  @media screen and (min-width: 750px) {
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }
  {%- if block.settings.top_left -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif block.settings.top_right -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif block.settings.bottom_right -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif block.settings.bottom_left -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if block.settings.corner_color != blank -%}
    .ssky-text-image-block-{{ block.id }} {
      background-color: {{ block.settings.corner_color }};
    }
  {%- endif -%}
  {%- if merging_with_section_below -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block {
      z-index: 1;
    }
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
      padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
    }
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__layout-merging-color {
      background-color: {{ block.settings.merging_color }};
    }
    {%- if block.settings.overflow_image > 0 -%}
      @media screen and (min-width: 1140px) {
        .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__layout-merging {
          padding-top: {{ block.settings.overflow_image |  divided_by: 2 }}px
        }
        .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
          overflow: unset;
          padding-top: 0 !important;
        }
        .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__image {
          margin-top: -{{ block.settings.overflow_image }}px;
        }
        .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__blocks {
          padding-top: 3.2rem;
        }
      }
    {%- endif -%}
    {%- if block.settings.remove_bottom_space -%}
      @media screen and (min-width: 990px) {
        .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
          padding-bottom: 0;
        }
      }
    {%- endif -%}
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
      padding-top: {{ block.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
        padding-top: {{ block.settings.padding_top }}px;
        padding-bottom: {{ block.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__section-header {
      margin-bottom: 2rem;
    }
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}

  .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__text-promo {
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-promo__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .ssky-text-image-block-{{ block.id }} .ssky-text-promo__content {
      flex-direction: row;
      align-items: center;
    }

    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__wrapper {
      align-items: {{block.settings.content_alignment}};
    }

    .ssky-text-image-block-{{ block.id }} .ssky-text-promo__text-column {
      width: 50%;
      padding-right: 2rem;
    }

    .ssky-text-image-block-{{ block.id }} .ssky-text-promo__action-column {
      width: 50%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__image-column {
      width: {{image_width}};
      max-width: {{image_width}};
    }
    .ssky-text-image-block-{{ block.id }} .ssky-text-image-block__text-column {
      width: {{text_width}};
      max-width: {{text_width}};
    }
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-promo__secondary-link {
    margin-top: 1rem;
    text-align: center;
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-promo__secondary-link.primary {
    color: var(--color-primary);
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-promo__secondary-link.secondary {
    color: var(--color-secondary);
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-promo__secondary-link.tertiary {
    color: var(--color-tertiary);
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__heading {
    margin-bottom: 1rem;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__caption {
    margin-bottom: 1rem;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__text {
    margin-bottom: 1.5rem;
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__text.text-left {
    text-align: left;
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__text.text-center {
    text-align: center;
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__text.text-right {
    text-align: right;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__price {
    margin-bottom: 1.5rem;
  }
  
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__price.secondary-price {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons .button,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons button,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"] {
    background: transparent !important;
    border: none !important;
    border-width: 0 !important;
    border-style: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
    outline: none !important;
    padding: 0 !important;
    margin: 0 !important;
    text-decoration: underline;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons .button:before,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons .button:after,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons button:before,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons button:after,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:before,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:after {
    display: none !important;
    content: none !important;
    border: none !important;
  }

  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons .button:hover,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons button:hover,
  .ssky-text-image-block-{{ block.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:hover {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-image-block-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-text-image-block-{{ block.id }}">
  <div class="ssky-text-image-block content-container color-{{ block.settings.color_scheme }} gradient {{ block.settings.custom_class }}">
    {% content_for "block", type: "_itb-section-heading", id: "itb-section-heading" %}
    {%- if merging_with_section_below -%}
      <div class="ssky-text-image-block__layout-merging{%- if block.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above page-width{%- endif -%}">
        <div class="color-{{ block.settings.color_scheme_layout_merging }} gradient">
    {%- endif -%}
    {%- if show_as_card -%}<div class="page-width">{%- endif -%}
    <div class="ssky-text-image-block__wrapper {{ block.settings.image_position }} image-size-ssky-{{ block.settings.image_size }} page-width{%- if show_as_card %} color-{{ block.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-text-image-block__image-column">
        {% content_for "block", type: "_itb-text-promo-image", id: "itb-text-promo-image" %}
    
        <div class="ssky-text-image-block__image">
          <div
            class="{%- if block.settings.image != blank %}media{%- else %}placeholder{%- endif -%}{%- if block.settings.image_fit %} image-fit{%- endif -%}"
            style="padding-bottom:{%- if merging_with_section_below or narrow_width -%}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- elsif block.settings.image_size == 'small' -%}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 150 }}%;{%- else -%}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 100 }}%;{%- endif -%}"
          >
            {%- if block.settings.image != blank -%}
              {%- assign widths = '360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>
      <div class="ssky-text-image-block__text-column">
        {% content_for "block", type: "_itb-text-promo-text", id: "itb-text-promo-text" %}
        <div class="ssky-text-image-block__blocks ssky-text-block__blocks">
          {% content_for "blocks" %}
        </div>
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
    {%- if merging_with_section_below -%}
      </div>
      </div>
      <div
        class="ssky-text-image-block__layout-merging-color {%- if block.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above{%- endif -%}"
      ></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "TT Text image block",
  "blocks": [
    { "type": "@theme" }, 
    { "type": "_itb-divider-text" },
    { "type": "_itb-number-counter" },
    { "type": "_itb-text-column-icons" },
    { "type": "_itb-text-columns" },
    { "type": "_checkbox" },
    { "type": "_divider" },
    { "type": "@app" }
  ],
  "tag": "section",
  "class": "section",
  "settings": [
    {
    "type": "header",
    "content": "Background Image"
  },
  {
    "type": "image_picker",
    "id": "background_image",
    "label": "Background image"
  },
  {
    "type": "select",
    "id": "background_position",
    "options": [
      {
        "value": "top left",
        "label": "Top left"
      },
      {
        "value": "top center",
        "label": "Top center"
      },
      {
        "value": "top right",
        "label": "Top right"
      },
      {
        "value": "center left",
        "label": "Center left"
      },
      {
        "value": "center center",
        "label": "Center"
      },
      {
        "value": "center right",
        "label": "Center right"
      },
      {
        "value": "bottom left",
        "label": "Bottom left"
      },
      {
        "value": "bottom center",
        "label": "Bottom center"
      },
      {
        "value": "bottom right",
        "label": "Bottom right"
      }
    ],
    "default": "center center",
    "label": "Position"
  },
  {
    "type": "select",
    "id": "background_size",
    "options": [
      {
        "value": "cover",
        "label": "Cover"
      },
      {
        "value": "contain",
        "label": "Contain"
      },
      {
        "value": "auto",
        "label": "Original size"
      }
      ],
      "default": "cover",
      "label": "Size"
    },
    {
      "type": "checkbox",
      "id": "background_overlay",
      "label": "Add color overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "background_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 50
    },
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "label": "Rounded corner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "image_fit",
      "label": "t:sections.all.image_fit.label",
      "default": false,
      "info": "t:sections.all.image_fit.info"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "image-left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "image-right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "image-left",
      "label": "Image position"
    },
    {
      "type": "select",
      "id": "image_size",
      "options": [
        {
          "value": "small",
          "label": "SM"
        },
        {
          "value": "smallplus",
          "label": "SM+"
        },
        {
          "value": "medium",
          "label": "MD"
        },
        {
          "value": "large",
          "label": "LG"
        }
      ],
      "default": "medium",
      "label": "Image size"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "flex-start",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.narrow"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.merging"
    },
    {
      "type": "checkbox",
      "id": "merging_with_section_below",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_layout_merging",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "merging_color",
      "label": "Merging color",
      "default": "#bcecf6"
    },
    {
      "type": "range",
      "id": "overflow_image",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Overflow image from above",
      "info": "Use this when the text content is smaller than the image. Desktop only.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "merge_with_section_above",
      "label": "t:sections.all.ssky_layouts.extension.merging_above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_space",
      "label": "Remove bottom space",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.custom_class.header"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_class.label",
      "info": "t:sections.all.custom_class.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
