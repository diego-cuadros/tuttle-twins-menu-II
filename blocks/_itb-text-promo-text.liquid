{%- if block.settings.promo_heading != blank or block.settings.promo_subheading != blank -%}
  {%- style -%}
    .ssky-text-image-block__text-promo-{{ block.id }} {
      margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }  
    @media screen and (min-width: 750px) {
      .ssky-text-image-block__text-promo-{{ block.id }} {
        margin-top: {{ block.settings.margin_top }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
    }
    {% if block.settings.custom_css != blank %}
      {% assign tt_css = '.ssky-text-image-block__text-promo-' | append: block.id %}
      {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
    {% endif %}
  {%- endstyle -%}
  <div 
    class="ssky-text-image-block__text-promo ssky-text-image-block__text-promo-{{ block.id }} color-{{ block.settings.promo_color_scheme }} gradient" {{ block.shopify_attributes }}>
    <div class="ssky-text-promo__content">
      {%- if block.settings.promo_heading != blank -%}
        <h3 class="ssky-text-promo__heading">{{ block.settings.promo_heading }}</h3>
      {%- endif -%}
      
      {%- if block.settings.promo_subheading != blank -%}
        <div class="ssky-text-promo__subheading">{{ block.settings.promo_subheading }}</div>
      {%- endif -%}
      
      {%- if block.settings.promo_button_text != blank -%}
        <a 
          {% if block.settings.promo_button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ block.settings.promo_button_link }}"
          {% endif %}
          class="button{% if block.settings.promo_button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
        >
          {{ block.settings.promo_button_text | escape }}
        </a>
      {%- endif -%}
      
      {%- if block.settings.promo_button_text_2 != blank and block.settings.promo_button_link_2 != blank -%}
        <div class="ssky-text-promo__secondary-link">
          — OR —
          <a href="{{ block.settings.promo_button_link_2 }}">{{ block.settings.promo_button_text_2 }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
  {
    "name": "Promo text - text side",
    "settings": [
      {
        "type": "color_scheme",
        "id": "promo_color_scheme",
        "label": "Color scheme",
        "default": "scheme-4"
      },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "text",
        "id": "promo_heading",
        "label": "Heading"
      },
      {
        "type": "header",
        "content": "Subheading"
      },
      {
        "type": "text",
        "id": "promo_subheading",
        "label": "Subheading"
      },
      {
        "type": "header",
        "content": "Primary Buttons"
      },
      {
        "type": "text",
        "id": "promo_button_text",
        "label": "Button text"
      },
      {
        "type": "url",
        "id": "promo_button_link",
        "label": "Button link"
      },
      {
        "type": "checkbox",
        "id": "promo_button_style_secondary",
        "label": "Use secondary button style",
        "default": false
      },
      {
        "type": "text",
        "id": "promo_button_text_2",
        "label": "Second button text"
      },
      {
        "type": "url",
        "id": "promo_button_link_2",
        "label": "Second button link"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Promo text - text side" }
    ]
  }
{% endschema %}