      "blocks": {
        "text_column_97ey6r": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<p>14 Inspiring and Beautifully <br/>Illustrated Children’s Books</p>",
            "text": "<p>Educational stories that are entertaining and easy to understand</p>",
