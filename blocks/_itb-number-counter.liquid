{%- style -%}
  .ssky-text-block__ncounter-blocks-{{ block.id }} {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-block__ncounter-blocks-{{ block.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__ncounter-blocks-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-text-block__ncounter-blocks ssky-text-block__ncounter-blocks-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.text_a != blank -%}
    <div class="ssky-text-block__ncounter-block">
      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_a }}">
        {{ block.settings.number_a }}
      </div>
      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_a }}</div>
    </div>
  {%- endif -%}
  {%- if block.settings.text_b != blank -%}
    <div class="ssky-text-block__ncounter-block">
      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_b }}">
        {{ block.settings.number_b }}
      </div>
      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_b }}</div>
    </div>
  {%- endif -%}
  {%- if block.settings.text_c != blank -%}
    <div class="ssky-text-block__ncounter-block">
      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_c }}">
        {{ block.settings.number_c }}
      </div>
      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_c }}</div>
    </div>
  {%- endif -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const sskyncounterIst = document.querySelector(
        '.ssky-text-block__ncounter-blocks-{{ block.id }} .ssky-text-block__ncounter'
      );
      const sskyncounters = document.querySelectorAll(
        'ssky-text-block__ncounter-blocks-{{ block.id }} .ssky-text-block__ncounter'
      );
      const windowHeight = window.innerHeight;
      const duration = 2000;
      const countFunction = (sskyncounter, startTime) => {
        const countValue = +sskyncounter.getAttribute('data-target');
        const currentTime = Date.now();
        const elapsedTime = currentTime - startTime;
        const progress = Math.min(elapsedTime / duration, 1);
        const count = Math.ceil(progress * countValue);
        sskyncounter.innerText = count;
        if (progress < 1) {
          requestAnimationFrame(() => countFunction(sskyncounter, startTime));
        }
      };
      const starCount = () => {
        let sskyncounterIstPosition = sskyncounterIst.getBoundingClientRect().top;
        if (sskyncounterIstPosition < windowHeight - 200) {
          window.removeEventListener('scroll', starCount);
          const startTime = Date.now();
          sskyncounters.forEach((sskyncounter) => {
            countFunction(sskyncounter, startTime);
          });
        }
      };
      window.addEventListener('scroll', starCount);
    });
  </script>
</div>

{% schema %}
  {
    "name": "Number counter",
    "settings": [
      {
        "type": "header",
        "content": "Block one"
      },
      {
        "type": "number",
        "id": "number_a",
        "label": "Number",
        "default": 100
      },
      {
        "type": "text",
        "id": "text_a",
        "label": "Text",
        "default": "Order's Every day"
      },
      {
        "type": "header",
        "content": "Block two"
      },
      {
        "type": "number",
        "id": "number_b",
        "label": "Number"
      },
      {
        "type": "text",
        "id": "text_b",
        "label": "Text"
      },
      {
        "type": "header",
        "content": "Block three"
      },
      {
        "type": "number",
        "id": "number_c",
        "label": "Number"
      },
      {
        "type": "text",
        "id": "text_c",
        "label": "Text"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Number counter" }
    ]
  }
{% endschema %}