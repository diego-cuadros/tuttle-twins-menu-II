{%- style -%}
  .tt-milestones-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap | times: 0.75 | round: 0 }}px;
    justify-content: {{ block.settings.alignment }};
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    {%- if block.settings.background_color != blank -%}
      background-color: {{ block.settings.background_color }};
      padding: {{ block.settings.padding | times: 0.75 | round: 0 }}px;
      border-radius: {{ block.settings.border_radius }}px;
      {%- if block.settings.text_color != blank -%}
        color: {{ block.settings.text_color }};
      {%- endif -%}
    {%- endif -%}
    {%- if block.settings.width > 0 -%}
      width: {{ block.settings.width }}px;
      max-width: 100%;
    {%- endif -%}
  }

  @media screen and (min-width: 750px) {
    .tt-milestones-{{ block.id }} {
      gap: {{ block.settings.gap }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
      {%- if block.settings.background_color != blank -%}
        padding: {{ block.settings.padding }}px;
      {%- endif -%}
    }
  }

  /* Important: size the actual block wrappers */
  .tt-milestones-{{ block.id }} > * {
    flex: 1 1 0;
    min-width: {{ block.settings.min_width }}px;
  }

  /* Let the inner milestone fill its wrapper */
  .tt-milestones-{{ block.id }} .tt-milestone {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .tt-milestones-{{ block.id }} {
      flex-wrap: nowrap;
      gap: {{ block.settings.gap | times: 0.5 | round: 0 }}px;
      align-items: flex-start;
    }

    .tt-milestones-{{ block.id }} > * {
      flex: 1 1 0;
      min-width: 0;
    }

    .tt-milestones-{{ block.id }} .tt-milestone {
      width: 100%;
      height: 100%;
    }

    .tt-milestones-{{ block.id }} .tt-milestone img,
    .tt-milestones-{{ block.id }} .tt-milestone svg {
      max-width: 100%;
      height: auto;
    }
  }

  {%- if block.settings.stack_on_mobile -%}
    @media screen and (max-width: 749px) {
      .tt-milestones-{{ block.id }} {
        flex-direction: column;
        flex-wrap: nowrap;
      }

      .tt-milestones-{{ block.id }} > * {
        min-width: 100%;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign visibility_classes = ''
  if block.settings.hide_on_mobile
    assign visibility_classes = visibility_classes | append: ' hide-mobile'
  endif
  if block.settings.hide_on_tablet
    assign visibility_classes = visibility_classes | append: ' hide-tablet'
  endif
  if block.settings.hide_on_desktop
    assign visibility_classes = visibility_classes | append: ' hide-desktop'
  endif
-%}

<div class="tt-milestones tt-milestones-{{ block.id }}{{ visibility_classes }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Milestones",
  "blocks": [
    { "type": "tt-milestone" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" },
        { "value": "space-around", "label": "Space around" }
      ],
      "default": "flex-start",
      "label": "Alignment"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "min_width",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Min width per item",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "default": false,
      "label": "Stack on mobile"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Box styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Border radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "width",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 0,
      "info": "0 = full width"
    }
  ],
  "presets": [
    {
      "name": "Milestones",
      "blocks": [
        { "type": "tt-milestone", "settings": { "heading": "100+", "text": "Orders every day" } },
        { "type": "tt-milestone", "settings": { "heading": "1000+", "text": "5 Star Reviews" } },
        { "type": "tt-milestone" }
      ]
    }
  ]
}
{% endschema %}