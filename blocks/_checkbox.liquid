{%- style -%}
  .ssky-text-block__checkbox-{{ block.id }} {
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }  
  {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
    .ssky-text-block__checkbox-{{ block.id }} .ssky-text-block__checkbox[{{ block.shopify_attributes | replace: '"', "'" }}] {
      {%- if block.settings.custom_color != blank -%}
        color: {{ block.settings.custom_color }} !important;
      {%- endif -%}
      {%- if block.settings.alignment != blank -%}
        text-align: {{ block.settings.alignment }} !important;
      {%- endif -%}
    }
  {%- endif -%}
  @media screen and (min-width: 750px) {
    .ssky-text-block__checkbox-{{ block.id }} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__checkbox-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-text-block__checkbox-con ssky-text-block__checkbox-{{ block.id }}">
  <div class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
    <span class="svg-wrapper">
      {{- 'icon-checkmark.svg' | inline_asset_content -}}
    </span>
    <div class="rte">
      {{ block.settings.text }}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Checkbox",
    "settings": [
      {
        "type": "richtext",
        "id": "text",
        "label": "t:sections.ssky_text_block.blocks.checkbox.settings.text.label",
        "default": "t:sections.ssky_text_block.blocks.checkbox.settings.text.default"
      },
      {
        "type": "checkbox",
        "id": "text_large",
        "label": "t:sections.all.ssky_text_large.label",
        "default": true
      },
      {
        "type": "color",
        "id": "custom_color",
        "label": "Custom text color"
      },
      {
        "type": "select",
        "id": "alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "label": "Text alignment"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Checkbox" }
    ]
  }
{% endschema %}