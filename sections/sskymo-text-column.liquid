{%- style -%}
  .ssky-text-column-{{ section.id }} .ssky-text-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<div class="ssky-text-column-{{ section.id }}">
  <div class="ssky-text-column gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="ssky-text-column__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
        {%- for shield_your_kids in shop.metaobjects.shield_your_kids.values limit: 1 -%}
          {%- if shield_your_kids.heading != blank -%}
            {%- assign heading_length = shield_your_kids.heading | metafield_text | size -%}
            <h2
              class="ssky-text-block__heading rte inline-richtext h2{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 1"
              {% endif %}
            >
              {{ shield_your_kids.heading | metafield_tag }}
            </h2>
          {%- endif -%}

          <div class="ssky-text-column__block-set--top">
            <div
              class="ssky-text-column__block gradient color-scheme-2{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 2;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h5">
                  {{ shield_your_kids.column_one_heading }}
                </h4>
                <div class="ssky-text-column__text rte text-body-large">
                  {{ shield_your_kids.column_one_text | metafield_tag }}
                </div>
              </div>
            </div>

            <div
              class="ssky-text-column__block gradient color-scheme-3{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 3;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h5">
                  {{ shield_your_kids.column_two_heading }}
                </h4>
                <div class="ssky-text-column__text rte text-body-large">
                  {{ shield_your_kids.column_two_text | metafield_tag }}
                </div>
              </div>
            </div>

            <div
              class="ssky-text-column__block gradient color-scheme-4{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 4;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h5">
                  {{ shield_your_kids.column_three_heading }}
                </h4>
                <div class="ssky-text-column__text rte text-body-large">
                  {{ shield_your_kids.column_three_text | metafield_tag }}
                </div>
              </div>
            </div>
          </div>

          <div class="ssky-text-column__block-set--bottom ssky-text-block__checkbox-con">
            {%- for checkbox in shield_your_kids.checkboxes.value -%}
              <div
                class="ssky-text-block__checkbox text-body-large{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: 5;"
                {% endif %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                <div class="rte">
                  <strong>{{ checkbox }}</strong>
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- if shield_your_kids.button_label != blank -%}
            {% capture link_value %}{% render 'ssky-button-link', type: shield_your_kids %}{% endcapture %}
            <div
              class="ssky-text-block__buttons{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 5;"
              {% endif %}
            >
              <a
                {% if link_value == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ link_value | strip }}"
                {% endif %}
                class="button button--large button--primary"
              >
                {{- shield_your_kids.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TTm Shield your kids",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Shield your kids"
    }
  ]
}
{% endschema %}
