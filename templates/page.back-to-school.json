        },
        "text_with_icon_R7dDph": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Feel Confident as a Parent Teaching Your Children True Principles </strong><br/>Storytelling and illustrations unpack big concepts for easy understanding</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_WiUL4B": {
