            "narrow_width": true
          }
        },
        "testimonial_Dz4LmH": {
          "type": "testimonial",
          "settings": {
            "text": "<p>\"My son doesn't like to read, but he devours these books over and over again. Kudos to Connor and his team for finding the secret sauce to get my son interested in learning.\"</p>",
            "font_size": 16,
            "background": "#e5ebff",
