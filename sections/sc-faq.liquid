{% style %}
#section-{{ section.id }} {
  background-color: {{ section.settings.bg-color }};
  color: {{ section.settings.text-color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
#section-{{ section.id }} span,
#section-{{ section.id }} .title {
    color: {{ section.settings.title-color }};
}

@media (max-width: 991px) {
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
}
{% endstyle %}

<section class="sc-faq" id="section-{{ section.id }}">
  <div class="container">

    <div class="faq-main-block">

      <!-- LEFT CONTENT -->
      <div class="faq-content">
        {% if section.settings.title != blank %}
          <h2 class="title">{{ section.settings.title }}</h2>
        {% endif %}

        <div class="faq-wrapper">
          {% for block in section.blocks %}
            <div class="faq-item" {{ block.shopify_attributes }}>
              
              <button class="faq-question" aria-expanded="false">
                <span>{{ block.settings.question }}</span>
                <span class="faq-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="plus-icon">
                    <path d="M12.001 5V19.002" stroke="#05AED8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M19.002 12.002H5" stroke="#05AED8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="minus-icon">
                    <path d="M19.002 12.002H5" stroke="#05AED8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                </span>
              </button>

              <div class="faq-answer">
                <div class="faq-answer-inner">
                  {{ block.settings.answer }}
                </div>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

      <!-- RIGHT IMAGE -->
      {% if section.settings.image != blank %}
        <div class="faq-img-block">
          <img src="{{ section.settings.image | img_url: 'master' }}"  alt="{{ section.settings.title | escape }}" loading="lazy">
        </div>
      {% endif %}

    </div>

  </div>
</section>


<style>
/* Container */
.sc-faq .container { 
  max-width: 1272px;
  margin: 0 auto;
  padding: 0 20px;
}

/* 2 Column Layout */
.sc-faq .faq-main-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 55px;
  {% comment %} align-items: center; {% endcomment %}
}
.sc-faq .faq-main-block .faq-img-block {
    max-width: 549px;
    margin-left: auto;
}

/* Heading */
.sc-faq .title {
    font-style: normal;
    font-weight: 500;
    font-size: 40px;
    line-height: 1.1;
    margin: 0;
    margin-bottom: 40px;
}

/* FAQ Item */
.sc-faq .faq-item {
  background: #FFFFFF;
  border-radius: 4px;
  margin-bottom: 12px;
  overflow: hidden;
  cursor: pointer;
}

/* Question */
.sc-faq .faq-question {
  width: 100%;
  border: none;
  background: transparent;
  padding: 18px 20px;
  font-size: 18px;
  line-height: 1.3; 
  text-align: left;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-family: Poppins;
  font-weight: 500;
  gap: 32px;
}
.faq-item.active .faq-question {
    padding-bottom: 12px;
}

/* Icon */
.sc-faq .faq-icon {
  font-size: 22px;
  transition: transform 0.3s ease;
  color: #05AED8;
}

/* Answer */
.sc-faq .faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
  max-width: 550px;
}

.sc-faq .faq-answer-inner {
  padding: 0 20px 20px;
  font-size: 16px;
  line-height: 1.6;
}
.sc-faq .faq-answer-inner p {
    margin: 0;
}

/* Image */
.sc-faq .faq-img-block img {
  width: 100%;
  border-radius: 20px;
}


/* Default state */
.faq-icon .minus-icon {
  display: none;
}

.faq-item.active .plus-icon {
  display: none;
}

.faq-item.active .minus-icon {
  display: block;
}

@media (max-width: 1199px) {
  .sc-faq .faq-main-block {
    gap: 35px;
  }
  .sc-faq .title {
    font-size: 36px;
    margin-bottom: 32px;
  }
}

@media (max-width: 1024px) {
  .sc-faq .faq-main-block {
      gap: 20px;
  }
  .sc-faq .faq-question {
    padding: 16px 16px 16px 16px;
  }
  .sc-faq .faq-answer-inner {
    padding: 0 16px 16px;
  }
}

@media (max-width: 767px) { 
  .sc-faq .container {
    padding: 0 16px;
  }
  .sc-faq .faq-main-block {
    grid-template-columns: 1fr;
  }
  .sc-faq .faq-main-block .faq-img-block {
    max-width: 100%;
    display: none;
  }
  .sc-faq .title {
    font-size: 32px;
    margin-bottom: 24px;
  }
}

@media (max-width: 575px) {  
  .sc-faq .title {
    font-size: 28px;
  }
  .sc-faq .faq-answer-inner {
    margin-right: 40px; 
  }
}
</style>


<script>
{% comment %} document.addEventListener("DOMContentLoaded", function() {

  const section = document.querySelector("#section-{{ section.id }}");
  if (!section) return;

  const faqItems = section.querySelectorAll(".faq-item");

  faqItems.forEach(item => {
    const question = item.querySelector(".faq-question");
    const answer = item.querySelector(".faq-answer");

    question.addEventListener("click", function() {

      const isActive = item.classList.contains("active");

      // Close all items
      faqItems.forEach(otherItem => {
        otherItem.classList.remove("active");
        const otherAnswer = otherItem.querySelector(".faq-answer");
        const otherBtn = otherItem.querySelector(".faq-question");

        otherBtn.setAttribute("aria-expanded", "false");
        otherAnswer.style.maxHeight = null;
      });

      // Open clicked item
      if (!isActive) {
        item.classList.add("active");
        question.setAttribute("aria-expanded", "true");
        answer.style.maxHeight = answer.scrollHeight + "px";
      }

    });
  });

  /* Auto open first item */
  if (faqItems.length > 0) {
    const firstItem = faqItems[0];
    const firstAnswer = firstItem.querySelector(".faq-answer");
    const firstBtn = firstItem.querySelector(".faq-question");

    firstItem.classList.add("active");
    firstBtn.setAttribute("aria-expanded", "true");
    firstAnswer.style.maxHeight = firstAnswer.scrollHeight + "px";
  }

}); {% endcomment %}
document.addEventListener("DOMContentLoaded", function() {

  const section = document.querySelector("#section-{{ section.id }}");
  if (!section) return;

  const faqItems = section.querySelectorAll(".faq-item");

  function closeAllItems() {
    faqItems.forEach(item => {
      item.classList.remove("active");
      const answer = item.querySelector(".faq-answer");
      const button = item.querySelector(".faq-question");

      button.setAttribute("aria-expanded", "false");
      answer.style.maxHeight = null;
    });
  }

  function openItem(item) {
    const answer = item.querySelector(".faq-answer");
    const button = item.querySelector(".faq-question");

    item.classList.add("active");
    button.setAttribute("aria-expanded", "true");
    answer.style.maxHeight = answer.scrollHeight + "px";
  }

  // Click Event
  faqItems.forEach(item => {
    const question = item.querySelector(".faq-question");

    question.addEventListener("click", function() {

      const isActive = item.classList.contains("active");

      closeAllItems();

      if (!isActive) {
        openItem(item);
      }
    });
  });

  // Auto open first item
  if (faqItems.length > 0) {
    openItem(faqItems[0]);
  }

  // 🔥 Fix Height on Window Resize
  window.addEventListener("resize", function() {
    faqItems.forEach(item => {
      if (item.classList.contains("active")) {
        const answer = item.querySelector(".faq-answer");
        answer.style.maxHeight = answer.scrollHeight + "px";
      }
    });
  });

});
</script>


{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
        "type": "color",
        "id": "bg-color",
        "label": "Background Color"
    },
    {
        "type": "color",
        "id": "title-color",
        "label": "Title Color"
    },
    {
        "type": "color",
        "id": "text-color",
        "label": "Text Color"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ]
}
{% endschema %}