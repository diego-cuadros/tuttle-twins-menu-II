                            {% endif %}
                            {{ course_block.settings.listicle_text_1 }}
                          </li>
                        {% endif %}

                        {% if course_block.settings.listicle_text_2 != blank %}
                          <li class="ssky-courses-item {{ course_block.settings.listicle_marker }}" {% if course_block.settings.listicle_marker == 'dot' %}style="color:{{ course_block.settings.listicle_icon_color }};"{% endif %}>
