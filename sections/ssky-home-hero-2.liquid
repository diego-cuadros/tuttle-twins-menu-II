          "content": "Milestones Two - Reviews" 
        },
        { "type": "text", 
          "id": "title_b", 
          "label": "Title", 
          "default": "1000+" 
        },
        { "type": "image_picker", 
          "id": "review_stars", 
          "label": "Review Stars" 
        },
        { "type": "text", 
          "id": "text_b", 
          "label": "Text", 
          "default": "5 Star Reviews" 
        },

        { "type": "header", 
          "content": "Milestones Three - Icon" 
        },
        { "type": "image_picker", 
          "id": "icon", 
          "label": "Icon" 
        }
      ]
