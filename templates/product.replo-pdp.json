    "sc_pdp_image_text_gNd7B4": {
      "type": "sc-pdp-image-text",
      "blocks": {
        "icon_box_NVyr4p": {
          "type": "icon-box",
          "settings": {
            "icon": "shopify://shop_images/icon1.svg",
            "listing_title": "Fun to Read",
            "listing_content": "<p>The original book has great lessons, but we explain them in simple language with fun characters and clear examples kids can follow.</p>"
          }
        },
        "icon_box_ribwBU": {
          "type": "icon-box",
          "settings": {
            "icon": "shopify://shop_images/icon2.svg",
            "listing_title": "Designed to Stick",
            "listing_content": "<p>Instead of long, dense text, Tuttle Twins uses exciting stories that make the lessons stick and feel real in everyday life.</p>"
          }
        }
      },
      "block_order": [
        "icon_box_NVyr4p",
        "icon_box_ribwBU"
      ],
      "name": "PDP image text",
      "settings": {
        "bg_color": "#ffffff",
        "image": "shopify://shop_images/image-kids.webp",
        "mobile_image": "shopify://shop_images/mobile-img.webp",
        "heading": "Big Ideas Start Early.",
        "content": "<p>Give your kids stories that entertain and teach them how the world really works. </p><p></p><p>The Tuttle Twins Book Club delivers age-appropriate books each month that spark curiosity, critical thinking, and a love of learning without preaching or politics.</p>",
        "btn_text": "Shop Book Club",
        "btn_link": "#mainProduct_scrollTop",
        "padding-top": 80,
        "padding-bottom": 80,
        "padding-top-mobile": 32,
        "padding-bottom-mobile": 32
      }
    },
    "sc_faq_BG4eRc": {
      "type": "sc-faq",
      "blocks": {
        "faq_Am6f9M": {
          "type": "faq",
          "settings": {
            "question": "What ages are the books for?",
            "answer": "<p>Our “sweet spot” is ages 5–12, but we have books for every stage of growing up — from toddler board books that teach simple values, to storybooks and chapter books that make big ideas fun and easy to understand, all the way up to teen guides that explore real-world topics. Many parents love reading the books together with their kids, helping spark great conversations and making learning a family experience.</p>"
          }
        },
        "faq_Qfripi": {
          "type": "faq",
          "settings": {
            "question": "What kinds of concepts do the books teach?",
            "answer": "<p>These stories introduce kids to freedom-based ideas like individual liberty, free market economics, personal responsibility, critical thinking, entrepreneurship, and real-world history—wrapped up in fun, age-appropriate adventures.</p>"
          }
        },
        "faq_mM7N7p": {
          "type": "faq",
          "settings": {
            "question": "Are the activity workbooks downloadable or printed?",
            "answer": "<p>The activity workbooks are delivered as digital PDF files that you can download immediately after purchase. These printable companions to your physical books allow families to print as many copies as needed—perfect for multiple kids or reusing over time.</p>"
          }
        },
        "faq_bUREy8": {
          "type": "faq",
          "settings": {
            "question": "Is there a refund policy if it’s not the right fit?",
            "answer": "<p>Yes! The Tuttle Twins offer a 30-day, no-questions-asked refund policy. If you're not completely happy, just reach out, and you'll get your money back—risk-free.</p>"
          }
        }
      },
      "block_order": [
        "faq_Am6f9M",
        "faq_Qfripi",
        "faq_mM7N7p",
        "faq_bUREy8"
