{%- style -%}
  .ssky-text-block__divider-{{ block.id }} {
    display: block;
    margin:{{ block.settings.margin | times: 0.75 | round: 0 }}px auto;
    {%- if block.settings.contrast -%}border-color:rgb(var(--color-foreground));{%- endif -%}
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-block__divider-{{ block.id }} {
      margin:{{ block.settings.margin }}px auto;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__divider-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-text-block__divider ssky-text-block__divider-{{ block.id }}"></div>

{% schema %}
  {
    "name": "Divider",
    "settings": [
      {
        "type": "range",
        "id": "margin",
        "min": 8,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:sections.ssky_text_block.blocks.divider.settings.margin.label",
        "default": 16
      },
      {
        "type": "checkbox",
        "id": "contrast",
        "label": "t:sections.ssky_text_block.blocks.divider.settings.contrast.label"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Divider" }
    ]
  }
{% endschema %}