                                width="120"
                                height="120"
                                loading="lazy"
                                class="ssky-testimonials__stats-guarantee"
                              >
                            {% else %}
                              <div class="ssky-testimonials__stats-guarantee">
                                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                                  <circle cx="50" cy="50" r="48" fill="none" class="ssky-testimonials__stats-guarantee-circle" stroke-width="4"/>
                                  <circle cx="50" cy="50" r="42" fill="none" class="ssky-testimonials__stats-guarantee-circle" stroke-width="2"/>
                                  <foreignObject x="5" y="5" width="90" height="90">
                                    <div xmlns="http://www.w3.org/1999/xhtml" class="ssky-testimonials__stats-guarantee-label">
                                      <div>Money Back</div>
                                      <div>Guarantee</div>
                                      <div class="ssky-testimonials__stats-guarantee-days">30</div>
                                      <div>Days</div>
                                      <div>Money Back</div>
                                      <div>Guarantee</div>
                                    </div>
                                  </foreignObject>
                                </svg>
                              </div>
