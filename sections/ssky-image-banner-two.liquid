            {%- endfor -%}
          </div>

          <div class="banner__content-media-column">
            {%- for block in section.blocks -%}
              {%- if block.type == 'image_block' or block.type == 'youtube_video' or block.type == 'youtube_video_slider' -%}
                {%- case block.type -%}
                  {%- when 'image_block' -%}
                    <div class="banner__content-custom-image" {{ block.shopify_attributes }}>
                      {% if block.settings.image != blank %}
                        <img 
                          src="{{ block.settings.image | image_url: width: 800 }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                          class="custom-block-image"
                        >
                      {% endif %}
                    </div>
                  {%- when 'youtube_video' -%}
                    <div class="banner__content-video" {{ block.shopify_attributes }}>
                      <div class="banner__video-container">
                        <iframe 
                          width="100%"
                          height="100%"
                          src="https://www.youtube.com/embed/{{ block.settings.youtube_id }}?rel=0&showinfo=0&controls=1&autoplay={{ block.settings.autoplay }}" 
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                          allowfullscreen
                          title="YouTube video"
                        ></iframe>
                      </div>
                    </div>
                    {%- when 'youtube_video_slider' -%}
                      <div class="banner__content-video-slider" {{ block.shopify_attributes }}>
                        <div class="banner__video-slider" id="VideoSlider-{{ section.id }}-{{ block.id }}">
                          <div class="banner__video-slider-wrapper{% if block.settings.video_count == 1 %} single-video{% endif %}">
                            {% for i in (1..block.settings.video_count) %}
                              {% assign video_id_setting = 'youtube_id_' | append: i %}
                              {% assign thumbnail_setting = 'thumbnail_' | append: i %}
                              {% assign title_setting = 'title_' | append: i %}
                              {% if block.settings[video_id_setting] != blank %}
                                <div class="banner__video-slide{% if forloop.first %} active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                                  {% if block.settings.use_lightbox %}
                                    <a href="https://www.youtube.com/watch?v={{ block.settings[video_id_setting] }}" 
                                      class="banner__video-thumbnail"
                                      data-lity>
                                  {% else %}
                                    <div class="banner__video-thumbnail">
                                  {% endif %}
                                      {% if block.settings[thumbnail_setting] != blank %}
                                        <img 
                                          src="{{ block.settings[thumbnail_setting] | image_url: width: 800 }}"
                                          alt="{% if block.settings[title_setting] != blank %}{{ block.settings[title_setting] }}{% else %}Video thumbnail {{ i }}{% endif %}"
                                          loading="lazy"
                                        >
                                      {% else %}
                                        <img 
                                          src="https://img.youtube.com/vi/{{ block.settings[video_id_setting] }}/maxresdefault.jpg"
                                          alt="{% if block.settings[title_setting] != blank %}{{ block.settings[title_setting] }}{% else %}Video thumbnail {{ i }}{% endif %}"
                                          loading="lazy"
                                          onerror="this.src='https://img.youtube.com/vi/{{ block.settings[video_id_setting] }}/hqdefault.jpg'"
                                        >
                                      {% endif %}
                                      
                                      <div class="banner__video-play-button" 
                                          {% unless block.settings.use_lightbox %}
                                            data-video-id="{{ block.settings[video_id_setting] }}"
                                            data-slide-id="{{ forloop.index0 }}"
                                            onclick="playInlineVideo(this)"
                                          {% endunless %}></div>
                                      
                                      {% if block.settings[title_setting] != blank %}
                                        <div class="banner__video-title">{{ block.settings[title_setting] }}</div>
                                      {% endif %}
                                  {% if block.settings.use_lightbox %}
                                    </a>
                                  {% else %}
                                    </div>
                                  {% endif %}
                                  
                                  {% unless block.settings.use_lightbox %}
                                    <div class="banner__video-inline-container">
                                      <iframe 
                                        width="100%"
                                        height="100%"
                                        src=""
                                        data-src="https://www.youtube.com/embed/{{ block.settings[video_id_setting] }}?rel=0&showinfo=0&controls=1&autoplay=1" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen
                                        title="{% if block.settings[title_setting] != blank %}{{ block.settings[title_setting] }}{% else %}YouTube video{% endif %}"
                                      ></iframe>
                                    </div>
                                  {% endunless %}
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                          
                          {% if block.settings.video_count > 1 and block.settings.use_slider %}
                            <div class="banner__video-slider-controls">
                              <button type="button" class="banner__video-slider-button banner__video-slider-button--prev" aria-label="Previous video">
                                ‹
                              </button>
                              
                              <div class="banner__video-slider-dots">
                                {% for i in (1..block.settings.video_count) %}
                                  {% assign video_id_setting = 'youtube_id_' | append: i %}
                                  {% if block.settings[video_id_setting] != blank %}
                                    <div class="banner__video-slider-dot{% if forloop.first %} active{% endif %}" 
                                        data-index="{{ forloop.index0 }}" 
                                        onclick="goToSlide('{{ section.id }}-{{ block.id }}', {{ forloop.index0 }})"></div>
                                  {% endif %}
                                {% endfor %}
                              </div>
                              
                              <button type="button" class="banner__video-slider-button banner__video-slider-button--next" aria-label="Next video">
                                ›
                              </button>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                      
                      <script>
                        document.addEventListener('DOMContentLoaded', function() {
                          initVideoSliders();
                        });
                        
                        let sliderIntervals = {};
                        
                        function initVideoSliders() {
                          const sliders = document.querySelectorAll('.banner__video-slider');
                          
                          sliders.forEach(slider => {
                            const sliderId = slider.id.replace('VideoSlider-', '');
                            const slides = slider.querySelectorAll('.banner__video-slide');
                            
                            if (slides.length > 0) {
                              slides[0].classList.add('active');
                              
                              const firstDot = slider.querySelector('.banner__video-slider-dot');
                              if (firstDot) firstDot.classList.add('active');
                            }
                            
                            const prevButton = slider.querySelector('.banner__video-slider-button--prev');
                            const nextButton = slider.querySelector('.banner__video-slider-button--next');
                            
                            if (prevButton) {
                              console.log('Adding click listener to prev button');
                              prevButton.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                changeSlide(sliderId, -1);
                                resetAutoSlide(sliderId);
                                return false;
                              });
                            }
                            
                            if (nextButton) {
                              nextButton.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();
                                changeSlide(sliderId, 1);
                                resetAutoSlide(sliderId);
                                return false;
                              });
                            }
                            
                            const dots = slider.querySelectorAll('.banner__video-slider-dot');
                            dots.forEach((dot, dotIndex) => {
                              dot.addEventListener('click', function(e) {
                                goToSlide(sliderId, dotIndex);
                                resetAutoSlide(sliderId);
                              });
                            });
                            
                            if (slides.length > 1) {
                              startAutoSlide(sliderId);
                            }
                          });
                        }
                        
                        function startAutoSlide(sliderId) {
                          if (sliderIntervals[sliderId]) {
                            clearInterval(sliderIntervals[sliderId]);
                          }
                          
                          sliderIntervals[sliderId] = setInterval(function() {
                            changeSlide(sliderId, 1);
                          }, 5000); 
                        }
                        
                        function resetAutoSlide(sliderId) {
                          if (sliderIntervals[sliderId]) {
                            clearInterval(sliderIntervals[sliderId]);
                            startAutoSlide(sliderId);
                          }
                        }
                        
                        function playInlineVideo(button) {
                          const slide = button.closest('.banner__video-slide');
                          const sliderId = slide.closest('.banner__video-slider').id.replace('VideoSlider-', '');
                          const thumbnail = slide.querySelector('.banner__video-thumbnail');
                          const videoContainer = slide.querySelector('.banner__video-inline-container');
                          const iframe = videoContainer.querySelector('iframe');
                          
                          thumbnail.style.display = 'none';
                          videoContainer.style.display = 'block';
                          
                          iframe.src = iframe.dataset.src;
                          
                          if (sliderIntervals[sliderId]) {
                            clearInterval(sliderIntervals[sliderId]);
                            sliderIntervals[sliderId] = null;
                          }
                        }
                        
                        function goToSlide(sliderId, index) {
                          const slider = document.getElementById('VideoSlider-' + sliderId);
                          
                          if (!slider) {
                            return;
                          }
                          
                          const slides = slider.querySelectorAll('.banner__video-slide');
                          const dots = slider.querySelectorAll('.banner__video-slider-dot');
                          
                          if (index < 0 || index >= slides.length) {
                            return;
                          }
                          
                          slides.forEach(slide => {
                            slide.classList.remove('active');
                          });
                          
                          dots.forEach(dot => {
                            dot.classList.remove('active');
                          });
                          
                          slides[index].classList.add('active');
                          
                          if (dots[index]) {
                            dots[index].classList.add('active');
                          }
                          
                          slides.forEach(slide => {
                            const container = slide.querySelector('.banner__video-inline-container');
                            const thumbnail = slide.querySelector('.banner__video-thumbnail');
                            const iframe = slide.querySelector('iframe');
                            
                            if (container && container.style.display === 'block') {
                              container.style.display = 'none';
                              thumbnail.style.display = 'block';
                              if (iframe) iframe.src = '';
                            }
                          });
                        }
                        
                        function changeSlide(sliderId, direction) {
                          const slider = document.getElementById('VideoSlider-' + sliderId);
                          
                          if (!slider) {
                            return;
                          }
                          
                          const slides = slider.querySelectorAll('.banner__video-slide');
                          const activeSlide = slider.querySelector('.banner__video-slide.active');
                          
                          if (!activeSlide) {
                            return;
                          }
                          
                          let currentIndex = Array.from(slides).indexOf(activeSlide);

                          let newIndex = currentIndex + direction;
                          if (newIndex < 0) newIndex = slides.length - 1;
                          if (newIndex >= slides.length) newIndex = 0;
                          
                          goToSlide(sliderId, newIndex);
                        }
                        
                        window.playInlineVideo = playInlineVideo;
                        window.goToSlide = goToSlide;
                        window.changeSlide = changeSlide;
                        window.initVideoSliders = initVideoSliders;
                        window.startAutoSlide = startAutoSlide;
                        window.resetAutoSlide = resetAutoSlide;
                        
                        // Add a fallback to initialize sliders if jQuery is slow to load
                        setTimeout(function() {
                          console.log('Fallback initialization of sliders');
                          if (typeof jQuery === 'undefined') {
                            console.log('jQuery not loaded yet, initializing sliders without jQuery');
                            initVideoSliders();
                          }
                        }, 1000);
                      </script>
                {%- endcase -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
