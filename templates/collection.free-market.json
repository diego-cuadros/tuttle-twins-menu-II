    "ssky_text_block_w7eWbE": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_6JUUBq": {
          "type": "heading",
          "settings": {
            "heading": "<p>Benefits of Our Kids Economics Books</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_Ubh3Eh": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>This collection is packed with value for both parents and children. Here are six benefits your children and family can enjoy when reading our economics books:</p>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        },
        "checkbox_individual_KRRcpd": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Financial Confidence Early On:</strong> Children learn the foundations of saving, budgeting, and smart spending. Starting early helps them develop confidence with money before habits set in.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_AMbP3m": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Critical Thinking and Decision-Making:</strong> Each book presents real-life choices and challenges. Kids see how decisions create consequences, building lifelong problem-solving skills.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_zzRffF": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Entrepreneurial Mindset:</strong> From running a lemonade stand to starting a business, our stories inspire creativity and independence. Our book <a href=\"https://tuttletwins.com/products/the-tuttle-twins-and-the-messed-up-market\"><span style=\"text-decoration:underline\">Messed Up Market</span></a> helps children see opportunities and turn ideas into action.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_DXHKQG": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Simple Explanations of Big Ideas:</strong> Concepts like inflation, trade, and supply and demand are broken down into fun, easy-to-grasp stories. Kids learn without feeling overwhelmed.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_GHRgHa": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Family-Friendly Learning:</strong> Parents can read aloud and discuss each lesson. It’s an engaging way to bond and ensure kids truly understand important principles.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_66qmJN": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Curriculum-Friendly for Homeschoolers:</strong> Our books pair perfectly with homeschool economics lessons. They meet educational standards while keeping learning exciting and stress-free.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        }
      },
