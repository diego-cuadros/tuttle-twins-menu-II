            "stars": 5,
            "narrow_width": true
          }
        },
        "testimonial_PnVMhm": {
          "type": "testimonial",
          "settings": {
            "text": "<p>\"Forget 5-11 year olds… when I read these books to my kids I learned all sorts of stuff nobody ever taught me. Now my kids and I have some awesome discussions together!\"</p>",
