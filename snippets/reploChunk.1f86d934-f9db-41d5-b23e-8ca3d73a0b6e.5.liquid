562-4880-98a4-077af96e3dc7?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/61aaf693-3562-4880-98a4-077af96e3dc7" class="r-paboe" loading="eager"/></picture></div></div></div></div></div><div data-rid="940c62ad-4681-4c26-812a-e0bc7d7d67e3" class="r-1ig30te"><div data-rid="d89850c4-017b-473c-ae19-89677441d0a7" class="r-2x8mft"><picture data-rid="fe441fe7-697e-4b4d-b8c3-770f6acf98a0" class="r-j3fn8l"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/3cb22fa2-92b4-431d-9c77-ab8f43437e16?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/3cb22fa2-92b4-431d-9c77-ab8f43437e16?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/3cb22fa2-92b4-431d-9c77-ab8f43437e16?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/3cb22fa2-92b4-431d-9c77-ab8f43437e16" class="r-eqst98" loading="eager"/></picture><div data-rid="1003b803-5b6b-4708-bad0-0a3654af4531" class="r-12q2iix"><div data-rid="8315ff52-f377-4541-abe4-ad11579670db" class="r-74iwv1 alchemy-rte"><span style="width:100%"><p>Frequently Asked Questions</p></span></div><div data-rid="b9c9d50e-3d51-4693-b977-13213885e1ac" class="r-3e1fh8" data-orientation="vertical"><div data-rid="dcaf2c18-37e4-4690-ad86-a4a1a0bad747" class="r-11p0tvi" data-replo-collapsible="true" data-state="open" data-orientation="vertical"><div data-rid="8bf08835-7278-41e9-ac01-27025bfc874a" aria-expanded="true" aria-controls="replo-:R6mr2:" tabindex="0" role="button" class="r-ihh6x5 r-v3xa8t"><div data-rid="472ae817-b59e-4367-b4b8-40be116cc9f6" class="r-1bcvqgv alchemy-rte"><span style="width:100%"><p>What ages is the Academy designed for?</p></span></div><div data-rid="79425402-45ea-4e84-953b-edaaed200934" class="r-1l3h3hf" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-ivwgup" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"></path></svg></div></div><div class="replo-animated" id="replo-:R6mr2:"><div data-rid="e6139183-b36b-49c9-a2ff-709fb1ec9363" class="r-ywz1aj"><div data-rid="1d328aea-29c1-45f4-a764-1246332ffa0a" class="r-1kevvpv alchemy-rte"><span style="width:100%"><p>The Tuttle Twins Academy is specifically designed for ages 12-18. The content uses engaging storytelling and real-world examples that resonate with teens while teaching complex economic and civic concepts. Younger students (ages 5-11) should start with our illustrated book series, which we can recommend based on your child's reading level.</p></span></div></div></div></div><div data-rid="2d088104-c26e-4936-89d3-ea95adab8525" class="r-1t4qg7s" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="69edac29-f55c-46a5-975e-c18949beb602" aria-expanded="false" aria-controls="replo-:Ramr2:" tabindex="0" role="button" class="r-kmj1lx"><div data-rid="277a5386-fb04-4919-b996-6a04d02a6f06" class="r-ihb4jm alchemy-rte"><span style="width:100%"><p>Is this too political or biased?</p></span></div><div data-rid="1e04d6cd-41ce-4bcc-bbb0-b62341651562" class="r-1u07cei" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-19vqrww" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Ramr2:"><div data-rid="d44ac8e1-992e-4934-af2f-64ce2a1ced6c" class="r-pl0aqz"><div data-rid="f08d1b1b-92e6-4ed9-8617-092ce1bec34d" class="r-6jhc64 alchemy-rte"><span style="width:100%"><p>We're transparent: we teach principles of liberty, free markets, and personal responsibility from a libertarian/classical liberal perspective. However, we focus on developing critical thinking skills—teaching students to question ALL authority (including us!) and form their own reasoned conclusions. We're not telling kids what to think; we're giving them tools to think for themselves. Many families appreciate that we don't pretend to be "neutral" while actually promoting other viewpoints.</p></span></div></div></div></div><div data-rid="54bc2d36-c221-4b16-8786-a6c3d864e2da" class="r-riu1ig" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="ead83d96-09a9-47ad-8353-0d028e73f4b5" aria-expanded="false" aria-controls="replo-:Remr2:" tabindex="0" role="button" class="r-orxmd7"><div data-rid="eb99a213-40ad-4d1d-93de-47beb7e77bc9" class="r-1pfa8lm alchemy-rte"><span style="width:100%"><p>How does this work with homeschooling?</p></span></div><div data-rid="81c1bbe3-56ff-451c-b415-84ab8839df58" class="r-15cg29h" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-10s55u3" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Remr2:"><div data-rid="84f7298a-b7c2-47ca-8466-a32a6bc9f781" class="r-thvorb"><div data-rid="9497ed86-d93e-4654-bd4b-6d729eeaec6b" class="r-hi0v4u alchemy-rte"><span style="width:100%"><p>The Academy works perfectly as a social studies/civics/economics curriculum component for homeschoolers. Lessons are self-paced, include discussion questions and activities, and cover topics many homeschool curricula skip. Many families use it for ages 12+ while using our illustrated books for younger children (ages 5-11).</p></span></div></div></div></div><div data-rid="d32d43c4-7e9b-47d3-93c3-c5fffebc6438" class="r-15j5twd" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="6ac1b53b-1d18-4372-8e97-773462eccff1" aria-expanded="false" aria-controls="replo-:Rimr2:" tabindex="0" role="button" class="r-4ct8tl"><div data-rid="b82de939-97b4-41df-8898-d311c8388910" class="r-1kq619x alchemy-rte"><span style="width:100%"><p>Can my teen in public/private school still benefit?</p></span></div><div data-rid="e552034a-3063-4cc2-84eb-8f46fdb9b308" class="r-1cnprx0" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-bgy72l" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rimr2:"><div data-rid="455de5c7-96a7-4bab-b249-3b2c171359b2" class="r-1ycvz5g"><div data-rid="d9ca008b-f891-4c48-a4b7-fa44266367c6" class="r-gvs1fz alchemy-rte"><span style="width:100%"><p>Absolutely! Many families use the Academy to supplement traditional schooling, providing perspectives and topics their teens aren't getting elsewhere. It's perfect for after-school learning and creates great opportunities for family discussions about current events and real-world applications.</p></span></div></div></div></div><div data-rid="078de366-3fc1-4c3e-8e8a-93e60bae57f5" class="r-1tnfbip" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="18a17136-4861-47bc-892d-d3929902146e" aria-expanded="false" aria-controls="replo-:Rmmr2:" tabindex="0" role="button" class="r-1dld58f"><div data-rid="768e55d0-e991-4373-b13a-f1b73e395680" class="r-sxunvc alchemy-rte"><span style="width:100%"><p>What if my teen doesn't engage with it?</p></span></div><div data-rid="93a6b219-5278-4799-96b3-a6e0e2c6c94f" class="r-ghf6e7" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1nelmww" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rmmr2:"><div data-rid="915619b4-e715-46de-96ee-12c9727d00a8" class="r-12zh9xl"><div data-rid="c9266f6e-e71a-4540-baf6-0a029b0af71a" class="r-1axv0bu alchemy-rte"><span style="width:100%"><p><span>We offer a 30-day money-back guarantee, no questions asked. That said, our story-based approach achieves 93% retention rates (vs. 13% for traditional textbooks), and most families report their teens actively asking for more lessons. We also offer a free first lesson so you can try before committing.</span></p><br><p><span>Try your first FREE Lesson </span><a target="_blank" rel="noopener nofollow noreferrer" href="https://tuttletwinsacademy.com/courses/how-system-really-works/"><u>HERE</u></a></p></span></div></div></div></div><div data-rid="2acfd9bc-957c-4929-9e42-0c1e67060b0a" class="r-rqeir9" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="5b2e975a-a60e-46fe-8f4b-8628f892958d" aria-expanded="false" aria-controls="replo-:Rqmr2:" tabindex="0" role="button" class="r-ruzr73"><div data-rid="24048891-383d-47fb-946b-1c4e23a12e2b" class="r-4zfn2i alchemy-rte"><span style="width:100%"><p>How is lifetime access d