            "text_style": "extra-extra-large-bold",
            "color_class": "primary-blue"
          }
        },
        "text_jw7YcU": {
          "type": "text",
          "settings": {
            "max_width": 70,
            "custom_color": "",
            "alignment": "center",
            "text": "<h2>The Game Changing Series Loved and Read by Millions of Children</h2>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        },
        "text_PNtCQe": {
          "type": "text",
          "settings": {
            "max_width": 65,
            "custom_color": "",
            "alignment": "center",
            "text": "<p>An innovative, beautifully illustrated series of books that uses the power of storytelling to teach your child about free markets, personal responsibility, and American history.</p>",
            "text_size": "large",
            "text_weight": "regular"
          }
        },
        "caption_6xMwQE": {
          "type": "caption",
          "settings": {
