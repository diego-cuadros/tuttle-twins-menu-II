              "label": "Show Date"
            },
            {
              "type": "checkbox",
              "id": "show_author",
              "label": "Show Author"
            }
          ]
        },
        {
          "type": "large_block",
          "name": "Large Block",
          "settings": [
            {
              "type": "color",
              "id": "background_color",
              "label": "Background Color",
              "default": "#ffffff"
            },
            {
              "type": "text",
              "id": "subheader",
              "label": "Subheader"
            },
            {
              "type": "image_picker",
              "id": "block_image",
              "label": "Block Image"
            },
            {
              "type": "text",
              "id": "header",
              "label": "Header"
            },
            {
              "type": "textarea",
              "id": "content",
              "label": "Content"
            },
            {
              "type": "text",
              "id": "button_label",
              "label": "Button Label"
            },
            {
              "type": "url",
              "id": "button_link",
              "label": "Button Link"
            },
            {
              "type": "color",
              "id": "button_font_color",
              "label": "Button Font Color",
              "default": "#ffffff"
            },
            {
              "type": "color",
              "id": "button_bg_color",
              "label": "Button Background Color",
              "default": "#000000"
            }
          ]
        },
        {
          "type": "small_block",
          "name": "Small Block",
          "settings": [
            {
              "type": "color",
              "id": "background_color",
              "label": "Background Color",
              "default": "#ffffff"
            },
            {
              "type": "image_picker",
              "id": "background_image",
              "label": "Background Image"
            },
            {
              "type": "color",
              "id": "header_color",
              "label": "Header Text Color",
              "default": "#000000"
            },
            {
              "type": "color",
              "id": "content_color",
              "label": "Content Text Color",
              "default": "#000000"
            },
            {
              "type": "text",
              "id": "header",
              "label": "Header"
            },
            {
              "type": "textarea",
              "id": "content",
              "label": "Content"
            },
            {
              "type": "text",
              "id": "button_label",
              "label": "Button Label"
            },
            {
              "type": "url",
              "id": "button_link",
              "label": "Button Link"
            },
            {
              "type": "color",
              "id": "button_font_color",
              "label": "Button Font Color",
              "default": "#ffffff"
            },
            {
              "type": "color",
              "id": "button_bg_color",
