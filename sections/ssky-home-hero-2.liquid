  ],
  "presets": [
    {
      "name": "Homepage Hero 2",
      "blocks": [
        { "type": "pill_banner"},
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text" },

        { "type": "image" },
        { "type": "button" },
        { "type": "milestones" }
      ]
    }
  ]
}
{% endschema %}
