    "ssky_text_image_block_y6c3af": {
      "type": "ssky-text-image-block",
      "blocks": {
        "heading_YqyxEx": {
          "type": "heading",
          "settings": {
            "heading": "<p>Taking the ideas of liberty to the next generation, with fun, educational books that kids and adults can enjoy.</p>",
            "heading_size": "h4",
            "heading_weight": "bold",
            "heading_tag": "h2"
          }
        },
        "text_39j4mG": {
          "type": "text",
          "settings": {
            "text": "<p>Each of our books focuses on a different aspect of the principles of a free society: free markets, entrepreneurship, individual rights, personal responsibility, sound money, protectionism, and a variety of other issues—all boiled down to core concepts that children of different ages can easily grasp.</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        }
      },
