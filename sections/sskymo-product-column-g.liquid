{{ 'ssky-product-column.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign show_as_card = false
  if section.settings.show_as_card == true
    assign show_as_card = true
  endif
-%}
{%- style -%}
  .ssky-product-column-{{ section.id }} .ssky-product-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-product-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-product-column-{{ section.id }} .ssky-product-column__wrapper {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="ssky-product-column-{{ section.id }}">
  <div class="ssky-product-column gradient color-{{ section.settings.color_scheme }}">
    {%- if show_as_card -%}
      <div class="ssky-product-column__layout-card page-width">
    {%- endif -%}
    <div class="ssky-product-column__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-product-column__blocks ssky-text-block__blocks center">
        <div class="ssky-product-column__block-set">
          {%- for americas_discover_b in shop.metaobjects.americas_discover_b.values limit: 1 -%}
            {%- if americas_discover_b.column_one_product != blank -%}
              {%- assign block_product = americas_discover_b.column_one_product.value -%}
              {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
              <div
                class="ssky-product-column__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="ssky-text-block__blocks">
                  <h3 class="ssky-product-column__heading ssky-text-block__heading rte h5">
                    {%- if americas_discover_b.column_one_heading != blank -%}
                      {{ americas_discover_b.column_one_heading | metafield_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.title }}
                    {%- else -%}
                      {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                    {%- endif -%}
                  </h3>
                  <div class="ssky-product-column__image media{%- if americas_discover_b.column_one_image_fill_or_fit != false %} image-fit{%- endif -%}">
                    {%- if americas_discover_b.column_one_image != blank -%}
                      {{ americas_discover_b.column_one_image | image_url: width: 560 | image_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="ssky-product-column__text rte">
                    {%- if americas_discover_b.column_one_description != blank -%}
                      {{ americas_discover_b.column_one_description | metafield_tag }}
                    {%- else -%}
                      {{ block_product.description | truncatewords: 20 | strip_html }}
                    {%- endif -%}
                  </div>
                </div>
                <div class="ssky-text-block__blocks">
                  <div class="ssky-product-column__price">
                    {%- if americas_discover_b.column_one_price != blank -%}
                      {{ americas_discover_b.column_one_price }}
                    {%- else -%}
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    {%- endif -%}
                  </div>
                  {%- render 'buy-buttons',
                    product: block_product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    is_product_column: true,
                    button_label: americas_discover_b.column_one_button_label
                  -%}
                </div>
              </div>
            {%- endif -%}
            {%- if americas_discover_b.column_two_product != blank -%}
              {%- assign block_product = americas_discover_b.column_two_product.value -%}
              {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
              <div
                class="ssky-product-column__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="ssky-text-block__blocks">
                  <h3 class="ssky-product-column__heading ssky-text-block__heading rte h5">
                    {%- if americas_discover_b.column_two_heading != blank -%}
                      {{ americas_discover_b.column_two_heading | metafield_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.title }}
                    {%- else -%}
                      {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                    {%- endif -%}
                  </h3>
                  <div class="ssky-product-column__image media{%- if americas_discover_b.column_two_image_fill_or_fit != false %} image-fit{%- endif -%}">
                    {%- if americas_discover_b.column_two_image != blank -%}
                      {{ americas_discover_b.column_two_image | image_url: width: 560 | image_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="ssky-product-column__text rte">
                    {%- if americas_discover_b.column_two_description != blank -%}
                      {{ americas_discover_b.column_two_description | metafield_tag }}
                    {%- else -%}
                      {{ block_product.description | truncatewords: 20 | strip_html }}
                    {%- endif -%}
                  </div>
                </div>
                <div class="ssky-text-block__blocks">
                  <div class="ssky-product-column__price">
                    {%- if americas_discover_b.column_two_price != blank -%}
                      {{ americas_discover_b.column_two_price }}
                    {%- else -%}
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    {%- endif -%}
                  </div>
                  {%- render 'buy-buttons',
                    product: block_product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    is_product_column: true,
                    button_label: americas_discover_b.column_two_button_label
                  -%}
                </div>
              </div>
            {%- endif -%}
            {%- if americas_discover_b.column_three_product != blank -%}
              {%- assign block_product = americas_discover_b.column_three_product.value -%}
              {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
              <div
                class="ssky-product-column__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="ssky-text-block__blocks">
                  <h3 class="ssky-product-column__heading ssky-text-block__heading rte h5">
                    {%- if americas_discover_b.column_three_heading != blank -%}
                      {{ americas_discover_b.column_three_heading | metafield_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.title }}
                    {%- else -%}
                      {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                    {%- endif -%}
                  </h3>
                  <div class="ssky-product-column__image media{%- if americas_discover_b.column_three_image_fill_or_fit != false %} image-fit{%- endif -%}">
                    {%- if americas_discover_b.column_three_image != blank -%}
                      {{ americas_discover_b.column_three_image | image_url: width: 560 | image_tag }}
                    {%- elsif block_product != blank -%}
                      {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="ssky-product-column__text rte">
                    {%- if americas_discover_b.column_three_description != blank -%}
                      {{ americas_discover_b.column_three_description | metafield_tag }}
                    {%- else -%}
                      {{ block_product.description | truncatewords: 20 | strip_html }}
                    {%- endif -%}
                  </div>
                </div>
                <div class="ssky-text-block__blocks">
                  <div class="ssky-product-column__price">
                    {%- if americas_discover_b.column_three_price != blank -%}
                      {{ americas_discover_b.column_three_price }}
                    {%- else -%}
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    {%- endif -%}
                  </div>
                  {%- render 'buy-buttons',
                    product: block_product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    is_product_column: true,
                    button_label: americas_discover_b.column_three_button_label
                  -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TTm Americas discover b",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Americas discover b"
    }
  ]
}
{% endschema %}
