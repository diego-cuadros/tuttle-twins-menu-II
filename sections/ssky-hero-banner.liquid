  "presets": [
    {
      "name": "TT Hero Banner (States)",
      "blocks": [
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "image" },
        { "type": "button" },
        { "type": "state_selector" }
