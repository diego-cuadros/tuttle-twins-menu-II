          }
        },
        "caption_qUf3KB": {
          "type": "caption",
          "settings": {
            "caption": "The Tuttle Twins:",
            "custom_color": "",
            "text_style": "extra-extra-large-bold",
            "color_class": "primary-blue"
          }
        },
        "heading_Rnz3Up": {
          "type": "heading",
          "settings": {
            "heading": "<p>The Thought Provoking Book <br/>Series Read By Millions of Children</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_n74MMW": {
          "type": "text",
          "settings": {
            "max_width": 84,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>A unique series of beautiful, enjoyable books that use storytelling to introduce important economic, civic, and history principles to your child.</p>",
            "text_size": "extra-large",
            "text_weight": "semibold"
          }
        },
        "heading_mxmNpw": {
          "type": "heading",
          "settings": {
            "heading": "<p>Mentor Your Children to Become Critical Thinkers<br/><br/></p>",
            "custom_color": "",
            "alignment": "left",
            "heading_size": "h3",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_with_icon_R7dDph": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Feel Confident as a Parent Teaching Your Children About True History </strong><br/>Storytelling and illustrations unpack big concepts for easy understanding</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_WiUL4B": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Fix Your Own Political and Economic Education Gaps </strong><br/>Learn big ideas together as a family in a simple yet engaging way</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_TNrT6w": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Give Your Children a Leg Up in Life</strong><br/>Encouraging critical thinking and truth seeking will set them apart</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_rJiUKB": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Raise Well-Rounded Children</strong><br/>So they are prepared and understand what’s going on in the world</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_hgAmVk": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "regular",
            "text_weight": "regular",
            "icon": "shopify://shop_images/icon-happy.webp",
            "text": "<p><strong>Bond as a Family and Strengthen Your Values</strong><br/>Elevate family discussions with powerful ideas and current events</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_YYeEHq": {
          "type": "text",
          "settings": {
            "max_width": 84,
            "custom_color": "",
            "alignment": "left",
            "text": "<p><br/>If you want a way to educate and equip your children for the future, we are glad you found us — because something new and important is happening here.</p>",
            "text_size": "large",
            "text_weight": "semibold"
          }
        }
