{%- style -%}
  .ssky-image-swiper-slider-{{ section.id }} {
    overflow-x: hidden;
  }

  .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {% if section.settings.fullwidth %}
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider-container {
      padding-left: 20px;
      padding-right: 20px;
      box-sizing: border-box;
      max-width: 100%;
      overflow-x: hidden;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }   
  }

  /* Ensure slides are centered and full width on mobile */
@media screen and (max-width: 749px) {
  .ssky-image-swiper-slider-{{ section.id }} .swiper-slide {
    width: 100% !important;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0 auto;
  }

  .ssky-image-swiper-slider-{{ section.id }} .swiper-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }
}


  {%- if section.settings.top_left -%}
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-image-swiper-slider-{{ section.id }} .ssky-image-swiper-slider {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}

  {%- if section.settings.corner_color != blank -%}
    .ssky-image-swiper-slider-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}

  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-image-swiper-slider-' | append: section.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}

<div class="ssky-image-swiper-slider-{{ section.id }}">
  <div class="ssky-image-swiper-slider color-{{ section.settings.color_scheme }} gradient">
    <div class="{% unless section.settings.fullwidth %}page-width{% else %}ssky-image-swiper-slider-container{% endunless %}">
      {% content_for 'blocks' %}   
    </div>
  </div>
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "TT Image swiper slider",
  "blocks": [
    { "type": "@theme" }, 
    { "type": "_swiper-slider-block" }
  ],
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Design settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Fullwidth",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    },
    {
      "type": "liquid",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
    }
  ],
  "presets": [
    {
      "name": "TT Image swiper slider"
    }
  ]
}
{% endschema %}
