    "ssky_faqs_t8qnyk": {
      "type": "ssky-faqs",
      "blocks": {
        "heading_x4TeFJ": {
          "type": "heading",
          "settings": {
            "heading": "<p>Frequently Asked Questions</p>",
            "heading_size": "h1",
            "heading_weight": "bold"
          }
        },
        "faq_6rJ8gj": {
          "type": "faq",
          "settings": {
            "text": "<p>What Kind of Content is Included Each Month?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>There is a story, essays, activity pages, real-life business profiles, and a Parent Guide in every issue. The PLUS version comes with extra content that makes learning even better.</p>",
