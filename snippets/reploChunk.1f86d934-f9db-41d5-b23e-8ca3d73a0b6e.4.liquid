d9d26aa/b64b6035-9321-46d8-8563-b00511402bb1?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b64b6035-9321-46d8-8563-b00511402bb1?width=80" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b64b6035-9321-46d8-8563-b00511402bb1?width=80" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b64b6035-9321-46d8-8563-b00511402bb1" class="r-1o3ck0o" loading="eager"/></picture><div data-rid="4a73d234-90e4-48a6-a25d-03efa6a43ed4" class="r-121a25b"><div data-rid="a1e44903-e227-4c65-9f9e-a51c09e4693c" class="r-1ifrs2r alchemy-rte"><span style="width:100%"><p>The Passive Learning Problem</p></span></div><div data-rid="8bc3f9ee-2269-456d-93e4-4316768f7e7e" class="r-1ty9ph3 alchemy-rte"><span style="width:100%"><p>Most teens aren't developing the critical thinking skills needed to analyze information and form their own informed opinions.</p></span></div></div></div><div data-rid="265ced0d-c885-45c7-986f-bd4ca7361850" class="r-1h38f95"><picture data-rid="c3c27d58-9ff7-47a0-90e2-fa58a6119a6b" class="r-1fd9vg0"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/4ff44b05-67e9-4394-94ea-27fdb4b38b46?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/4ff44b05-67e9-4394-94ea-27fdb4b38b46?width=80" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/4ff44b05-67e9-4394-94ea-27fdb4b38b46?width=80" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/4ff44b05-67e9-4394-94ea-27fdb4b38b46" class="r-rlela3" loading="eager"/></picture><div data-rid="bddd4654