          }
        },
        "heading_7kePVy": {
          "type": "heading",
          "settings": {
            "heading": "<h3>Ignite a Love for Liberty in Your Children.</h3>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h4",
