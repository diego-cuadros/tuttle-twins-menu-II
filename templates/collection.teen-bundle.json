    "ssky_text_column_ktLM8D": {
      "type": "ssky-text-column",
      "blocks": {
        "text_QGnYJC": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "text": "<p>Selecting the right book for your teen can be a daunting task, but it doesn’t have to be! Here are a few tips to help you make the right choice:</p>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        },
        "text_column_z3xeVq": {
          "type": "text_column",
          "settings": {
            "color_scheme": "",
            "heading": "<p><strong>Consider Their Interests</strong></p>",
            "text": "<p>Does your teen enjoy adventure, history, personal development, or philosophy? Our collection encompasses a diverse range of topics, ensuring there’s something for everyone.</p>",
            "text_large": false,
            "button_label": "",
            "button_link": "",
            "button_style_secondary": false
          }
        },
        "text_column_bDH4he": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-3",
            "heading": "<p><strong>Challenge Their Thinking</strong></p>",
            "text": "<p>Look for books that encourage critical thinking and spark curiosity. These books will help your teen develop important life skills.</p>",
            "text_large": false,
            "button_label": "",
            "button_link": "",
            "button_style_secondary": false
          }
        },
        "text_column_6Ci4FC": {
          "type": "text_column",
          "settings": {
