    "ssky_how_it_works_VkwdmV": {
      "type": "ssky-how-it-works",
      "name": "How It Works",
      "settings": {
        "color_scheme": "scheme-5",
        "accent_color": "#04aed8",
        "caption": "Your Next Move",
        "heading": "Dinner Table Conversations Start Here",
        "text": "<p>No planning required. Order the bundle that fits your child's age and watch what happens at dinner.</p>",
        "step1_title": "Choose Your Child's Age",
        "step1_text": "Toddlers, ages 5-12, or teens. Find where your child is today, and give them the ideas that take them further than you imagined.",
        "step2_title": "Pick Your Bundle",
        "step2_text": "Select from one of our most popular bundles  below.",
        "step3_title": "Start Reading Together",
        "step3_text": "Most kids beg for five more minutes of screen time. Tuttle Twins kids beg for one more chapter.",
        "p_2_4_1": "the-tuttle-toddlers-combo-set-1",
        "p_2_4_1_blurb": "A complete 6-book collection designed just for toddlers — from ABCs to 123s and everything in between. Build early literacy, counting skills, and character foundations in one adorable, best-selling bundle.",
        "p_2_4_2": "the-tuttle-toddlers-combo-set",
        "p_2_4_2_blurb": "This power-packed 3-book ABC bundle teaches letters, boosts vocabulary, and sparks early reading confidence — all in one fun, parent-approved set.",
        "p_2_4_3": "the-tuttle-toddlers-123-combo-set",
        "p_2_4_3_blurb": "Big numbers for little learners. This 3-book set helps toddlers count, recognize numbers, and start understanding “how many” — all through bright, engaging pages they’ll want to read again and again.",
        "p_2_4_4": "",
        "p_2_4_4_blurb": "",
        "p_5_8_1": "tuttle-twins-combo-pack-plus-free-bonuses",
        "p_5_8_1_blurb": "Everything you need to start the journey. The best-selling Family Starter Pack combines our 14-book Kids Series with our 2-volume America’s History set — giving your family a strong foundation in economics, government, and the story of freedom.",
        "p_5_8_2": "seasons-1-3-graphic-novels-box-set-hardback-1",
        "p_5_8_2_blurb": "34 full-color hardback graphic novels adapted from the Tuttle Twins animated show that your kids already love watching, now in their hands to read, reread, and laugh through again. Economics, free speech, Bitcoin, government, and the principles of freedom — told through Ethan and Emily in the stories kids can't put down.",
        "p_5_8_3": "",
        "p_5_8_3_blurb": "",
        "p_5_8_4": "",
        "p_5_8_4_blurb": "",
        "p_9_12_1": "tuttle-twins-family-starter-pack",
        "p_9_12_1_blurb": "Everything you need to start the journey. The best-selling Family Starter Pack combines our 14-book Kids Series with our 2-volume America’s History set — giving your family a strong foundation in economics, government, and the story of freedom.",
        "p_9_12_2": "tuttle-twins-combo-pack-plus-free-bonuses",
        "p_9_12_2_blurb": "The complete 14-book Kids Series — plus free activity workbooks to bring the lessons to life. Teach big ideas about economics, government, and freedom in a way kids understand and remember.",
        "p_9_12_3": "americas-history-volume-1-2-bundle",
        "p_9_12_3_blurb": "Two beautifully illustrated volumes that bring America’s history to life. Explore the people, events, and principles that shaped the nation — in a way kids can truly understand.",
        "p_9_12_4": "",
        "p_9_12_4_blurb": "",
        "p_13_plus_1": "the-tuttle-twins-teen-bundle",
        "p_13_plus_1_blurb": "All 7 Teen Guidebooks and 5 Choose Your Consequence novels in one powerful set. Big controversies. Dangerous ideas. Courageous leaders. Interactive stories that force real decisions — and real critical thinking.",
        "p_13_plus_2": "the-tuttle-twins-guidebook-combo-set",
        "p_13_plus_2_blurb": "All 7 Teen Guidebooks in one complete set. Explore conspiracy theories, modern villains, courageous heroes, logical fallacies, and more ideas — designed to sharpen your teens critical thinking and independent analysis.",
        "p_13_plus_3": "the-tuttle-twins-choose-your-consequence-combo-pack",
        "p_13_plus_3_blurb": "Five interactive novels where every decision matters. Step into high-stakes stories and see how your teen's choices shape the outcome — because ideas have consequences.",
        "p_13_plus_4": "",
        "p_13_plus_4_blurb": "",
        "padding_y_mobile": 48,
        "padding_y_desktop": 72
      }
