      "type": "ssky-box-image-block",
      "blocks": {
        "box_text_73Ay8Q": {
          "type": "box_text",
          "settings": {
            "box_text": "<h6>Expert Instructors</h6><p>Instructors are carefully selected based on their alignment with Tuttle Twins values and their expertise in various fields.</p>",
            "box_text_size": "regular",
            "box_text_weight": "regular"
          }
        },
        "box_text_q6QeJF": {
          "type": "box_text",
          "settings": {
            "box_text": "<h6>Quizzes for Mastery & Understanding</h6><p>In addition to video lectures, the Academy provides supplementary materials such as quizzes and lesson summaries to reinforce learning and ensure understanding.</p>",
            "box_text_size": "regular",
            "box_text_weight": "regular"
          }
        },
        "box_text_z6ME34": {
          "type": "box_text",
          "settings": {
            "box_text": "<h6>Tailored for Teens</h6><p>The use of animated content in these engaging lectures is designed to capture the interest of teens, making learning more enjoyable and effective.</p>",
            "box_text_size": "regular",
            "box_text_weight": "regular"
          }
        },
        "box_text_G9f4zW": {
          "type": "box_text",
          "settings": {
            "box_text": "<h6>Invest in your child's future</h6><p>Our aim is to help your teen thrive in todayʼs world. Invest in an engaging online library of animated lectures designed specifically for teens to learn ideas that matter.</p>",
            "box_text_size": "regular",
            "box_text_weight": "regular"
          }
        }
      },
