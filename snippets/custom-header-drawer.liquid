{% comment %}
  Renders a custom header drawer menu for mobile and desktop made by bottomless labs.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

{{ 'custom-header-drawer.css' | asset_url | stylesheet_tag }}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="menu-drawer color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        {% comment %}custom code starts here{% endcomment %}
        <div class="dc_menu-drawer__navigation-container">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {% when 'expandable_submenu' %}
                <div class="dc_expandable-submenu-container">
                  {% if block.settings.use_collapsible_menu %}
                    <div
                      class="dc_expandable-header dc_expandable-toggle"
                      role="button"
                      tabindex="0"
                      aria-expanded="false"
                    >
                      <div class="dc_expandable-submenu-label">
                        <img
                          src="{{ block.settings.menu_item_icon | image_url: width: 56 }}"
                          alt="{{ block.settings.menu_item_label | escape }}"
                          width="{{ image.width }}"
                          height="{{ image.height }}"
                          class="dc_expandable-submenu-icon"
                        >
                        <p class="dc_expandable-submenu-label__text">{{ block.settings.menu_item_label | escape }}</p>
                      </div>
                      <span class="dc_expandable-chevron">{% render 'icon-chevron' %}</span>
                    </div>
                    <div class="dc_expandable-submenu-links dc_expandable-submenu-links--collapsible">
                      <ul role="list">
                        {%- for i in (1..5) -%}
                          {%- capture label_id -%}submenu_item_{{ i }}_label{%- endcapture -%}
                          {%- capture link_id -%}submenu_item_{{ i }}_link{%- endcapture -%}
                          {%- capture icon_id -%}submenu_item_{{ i }}_icon{%- endcapture -%}
                          {%- if block.settings[label_id] != blank -%}
                            <li>
                              <a href="{{ block.settings[link_id] | default: '#' }}" class="dc_link">
                                {%- if block.settings[icon_id] != blank -%}
                                  <img
                                    class="dc_link-item__image"
                                    src="{{ block.settings[icon_id] | image_url: width: 40 }}"
                                    alt="{{ block.settings[label_id] | escape }}"
                                    width="30"
                                    height="30"
                                  >
                                {%- endif -%}
                                <span>{{ block.settings[label_id] | escape }}</span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {% else %}
                    <a
                      href="{{ block.settings.menu_item_link | default: '#' }}"
                      class="dc_expandable-header"
                    >
                      <div class="dc_expandable-submenu-label">
                        <img
                          src="{{ block.settings.menu_item_icon | image_url: width: 56 }}"
                          alt="{{ block.settings.menu_item_label | escape }}"
                          width="{{ image.width }}"
                          height="{{ image.height }}"
                          class="dc_expandable-submenu-icon"
                        >
                        <p class="dc_expandable-submenu-label__text">{{ block.settings.menu_item_label | escape }}</p>
                      </div>
                    </a>
                  {% endif %}
                </div>
              {% when 'banner_on_mobile_menu' %}
                <a
                  href="{{ block.settings.banner_link_mobile_menu | default: '#' }}"
                  class="dc_menu_drawer__banner"
                  {{ block.shopify_attributes }}
                >
                  <div class="dc_menu_drawer__banner-image-container">
                    <img
                      src="{{ block.settings.banner_image_mobile_menu | image_url: width: 800 }}"
                      alt="{{ block.settings.banner_image_mobile_menu | escape }}"
                      loading="lazy"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                    >
                    <div class="dc_mobile-banner-overlay">
                      <div class="dc_banner-overlay-inner-container">
                        <div class="dc_banner-tag">{{ block.settings.banner_tag_text | escape }}</div>
                        <p class="dc_banner-heading">{{ block.settings.banner_heading_text | escape }}</p>
                      </div>
                      <div class="dc_banner-overlay-inner-container">
                        <div class="dc_banner-button">
                          {{ block.settings.banner_button_label | escape }}
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              {%- when 'shop_grid' -%}
                <div class="dc_menu_drawer__shop-box" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <p class="dc_menu-drawer__shop-label">{{ block.settings.heading | escape }}</p>
                  {% endif %}

                  <div class="dc_menu-drawer__shop-grid">
                    {%- for i in (1..4) -%}
                      {%- capture img_id -%}img_{{ i }}{%- endcapture -%}
                      {%- capture label_id -%}label_{{ i }}{%- endcapture -%}
                      {%- capture link_id -%}link_{{ i }}{%- endcapture -%}

                      {%- if block.settings[img_id] != blank -%}
                        <a href="{{ block.settings[link_id] | default: '#' }}" class="dc_menu-drawer__shop-item">
                          <img
                            src="{{ block.settings[img_id] | image_url: width: 300 }}"
                            alt="{{ block.settings[label_id] | escape }}"
                            loading="lazy"
                            width="{{ image.width }}"
                            height="{{ image.height }}"
                          >
                          <div class="dc_menu-drawer__label-container">
                            <p class="dc_menu-drawer_label">{{ block.settings[label_id] | escape }}</p>
                          </div>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  {% if block.settings.button_label != blank %}
                    <a
                      href="{{ block.settings.button_link | default: '#' }}"
                      class="button button--large button--primary"
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>

              {%- when 'custom_menu' -%}
                <nav class="menu-drawer__navigation" {{ block.shopify_attributes }}>
                  <ul class="dc_menu-drawer__menu" role="list">
                    {%- for link in linklists[block.settings.bottomless_menu].links -%}
                      {%- liquid
                        assign current_index = forloop.index
                        assign icon_to_show = null
                        if current_index == block.settings.use_icon_1
                          assign icon_to_show = block.settings.icon_1
                        elsif current_index == block.settings.use_icon_2
                          assign icon_to_show = block.settings.icon_2
                        elsif current_index == block.settings.use_icon_3
                          assign icon_to_show = block.settings.icon_3
                        elsif current_index == block.settings.use_icon_4
                          assign icon_to_show = block.settings.icon_4
                        endif
                      -%}
                      <li class="dc_link-item">
                        <a href="{{ link.url }}" class="dc_link" style="display: flex; align-items: center; gap: 10px;">
                          {%- if block.settings.use_icons_as_bullets and icon_to_show != blank -%}
                            <img
                              class="dc_link-item__image"
                              src="{{ icon_to_show | image_url: width: 40 }}"
                              width="{{ image.width }}"
                              height="{{ image.height }}"
                            >
                          {%- endif -%}
                          <span>{{ link.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
            {%- endcase -%}
            {%- assign second_to_last_index = forloop.length | minus: 1 %}

            {%- if section.settings.use_custom_separator_line and forloop.index == second_to_last_index -%}
              <hr class="dc_menu-drawer_separator-line">
            {%- endif -%}
          {%- endfor -%}
          {% render 'social-icons', class: 'dc_menw-drawer__social-icons' %}
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.dc_expandable-toggle').forEach(function (el) {
      function toggle() {
        var expanded = el.getAttribute('aria-expanded') === 'true';
        el.setAttribute('aria-expanded', String(!expanded));
        el.nextElementSibling.classList.toggle('is-open', !expanded);
      }
      el.addEventListener('click', toggle);
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
