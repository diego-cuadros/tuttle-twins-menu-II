    "ssky_text_block_CVTBEP": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_LUCNVH": {
          "type": "heading",
          "settings": {
            "heading": "<p>Great Minds Think Un-alike… The <br/>Future of Freedom Starts Here</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_83QLJd": {
          "type": "text",
          "settings": {
            "max_width": 73,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>As a parent, you now have a resource that helps you teach your child that earning and saving money goes hand-in-hand with making decisions and doing what’s right.<br/><br/>This groundbreaking curriculum is a hands-on approach to learning where students not only understand the basics of economics, they also learn how to apply their new knowledge to make a difference in society.<br/><br/>Prepare your kids to become knowledgeable, effective, and responsible citizens by teaching the importance of free enterprise, entrepreneurship, and economics.</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        },
        "button_BhRT89": {
          "type": "button",
          "settings": {
            "alignment": "left",
            "button_last": true,
            "button_large": true,
            "button_medium": false,
