            "alignment": "left"
          }
        },
        "checkbox_individual_hqE4Ca": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>Books for 11 year olds offer choices and challenges to engage their analytical thinking.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_kRhctd": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>Books for 12 year olds encourage independent reading and critical thinking.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "text_nFpLMa": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>While the process may feel daunting as a parent, with our books, which are perfectly tailored to young minds, you can feel confident that your child is gaining valuable lessons while having fun.</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
