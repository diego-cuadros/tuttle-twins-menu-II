  },
  {
    "type": "select",
    "id": "background_position",
    "options": [
      {
        "value": "top left",
        "label": "Top left"
      },
      {
        "value": "top center",
        "label": "Top center"
      },
      {
        "value": "top right",
        "label": "Top right"
      },
      {
        "value": "center left",
        "label": "Center left"
      },
      {
        "value": "center center",
        "label": "Center"
      },
      {
        "value": "center right",
        "label": "Center right"
      },
      {
        "value": "bottom left",
        "label": "Bottom left"
      },
      {
        "value": "bottom center",
        "label": "Bottom center"
      },
      {
        "value": "bottom right",
        "label": "Bottom right"
      }
    ],
    "default": "center center",
    "label": "Position"
  },
  {
    "type": "select",
    "id": "background_size",
    "options": [
      {
        "value": "cover",
