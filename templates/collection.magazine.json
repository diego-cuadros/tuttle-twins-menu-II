    "ssky_text_block_HFqkjK": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_pbLhid": {
          "type": "heading",
          "settings": {
            "heading": "<p>Why Parents Love Our Kids Magazine Subscription</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_BnGfiP": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "center",
            "text": "<p>Here are six reasons why families keep coming back each month for more:</p>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        },
        "checkbox_individual_ftARay": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Engaging Stories That Teach Real-World Ideas - </strong>Every issue gives you more than just entertainment. Kids learn while being drawn into exciting stories based on ideas like self-reliance, entrepreneurship, and economics.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_p4bVkw": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Spotlights on Real Kid Entrepreneurs - </strong>Children see what's possible through others. Monthly interviews and articles about young business owners help kids understand what it means to be an entrepreneur, and inspire them to start taking action early.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_Kh8Rp7": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Zero-Risk with a Money-Back Guarantee – </strong>It's easy for parents to sign up. Get a complete refund without hassle if you cancel within 30 days.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_9MDHTN": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Parent Guides for Easy, Enriching Conversations – </strong>Every issue comes with a Parent Guide that gives parents family dinner conversation starters to encourage discussion.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_XdAEtN": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Hands-On Activities That Reinforce Learning – </strong>Kids stay curious and engaged by doing puzzles and playing games. These aren't just busywork; they encourage kids to think about important concepts and get them to learn by doing.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_Jy4aqt": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Flexible Formats for Every Learning Style – </strong>Families can choose the format that works best for their child, including printed magazines, digital editions, or bonus activity materials. Kids who enjoy reading or learning online will find what they need.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        }
      },
