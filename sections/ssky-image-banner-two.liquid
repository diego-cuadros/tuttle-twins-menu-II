{%- style -%}
  /* Banner structure */
  #Banner-{{ section.id }} {
    position: relative;
    {% if section.settings.background_color != blank %}
    background-color: {{ section.settings.background_color }};
    {% endif %}
    
    {% if section.settings.background_image != blank %}
    background-image: url({{ section.settings.background_image | image_url }});
    background-position: {{ section.settings.background_position }};
    background-repeat: no-repeat;
    background-size: {{ section.settings.background_size }};
    {% endif %}
  }

  /* Overlay settings */
  #Banner-{{ section.id }}::after {
    {% if section.settings.overlay_color != blank %}
    background-color: {{ section.settings.overlay_color }};
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  /* Fixed corner color implementation */
  {% if section.settings.corner_color != blank %}
  #Banner-{{ section.id }}.ssky-banner {
    {% if section.settings.top_left %}
    border-radius: 15vw 0 0 0;
    {% elsif section.settings.top_right %}
    border-radius: 0 15vw 0 0;
    {% elsif section.settings.bottom_right %}
    border-radius: 0 0 15vw 0;
    {% elsif section.settings.bottom_left %}
    border-radius: 0 0 0 15vw;
    {% endif %}
    position: relative;
    overflow: hidden;
  }
  
  #Banner-{{ section.id }}.ssky-banner::before {
    content: '';
    position: absolute;
    z-index: 0;
    background-color: {{ section.settings.corner_color }};
    {% if section.settings.top_left %}
    top: 0;
    left: 0;
    width: 15vw;
    height: 15vw;
    border-radius: 15vw 0 0 0;
    {% elsif section.settings.top_right %}
    top: 0;
    right: 0;
    width: 15vw;
    height: 15vw;
    border-radius: 0 15vw 0 0;
    {% elsif section.settings.bottom_right %}
    bottom: 0;
    right: 0;
    width: 15vw;
    height: 15vw;
    border-radius: 0 0 15vw 0;
    {% elsif section.settings.bottom_left %}
    bottom: 0;
    left: 0;
    width: 15vw;
    height: 15vw;
    border-radius: 0 0 0 15vw;
    {% endif %}
  }
  {% endif %}

  /* Image height adapt */
  {%- if section.settings.image_height == 'adapt' and section.settings.image != blank and section.settings.hide_main_image == false -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endif -%}
  
  /* Container width settings */
  {%- unless section.settings.full_width_container %}
    #Banner-{{ section.id }}.page-width {
      overflow: hidden;
      max-width: calc(var(--page-width) - 150px);
      margin: 24px auto;
    }
    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }} .banner__content {
        max-width: 72rem;
      }
    }
    @media screen and (min-width: 990px) {
      #Banner-{{ section.id }} .media > img {
        object-fit: contain;
      }
    }
  {%- endunless -%}

  /* Basic layout */
  #Banner-{{ section.id }} .section__heading {
    margin: 0 0 4rem;
  }

  #Banner-{{ section.id }} .banner__content {
    position: relative;
    z-index: 2;
  }
  
  #Banner-{{ section.id }} .banner__content-container {
    position: relative;
    z-index: 2;
  }
  
  /* Video Container */
  #Banner-{{ section.id }} .banner__video-container {
    width: 100%;
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    margin-bottom: 20px;
  }
  
  #Banner-{{ section.id }} .banner__video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  
  /* Bottom Wave Shape */
  #Banner-{{ section.id }} .rcl-shape {
    direction: ltr;
    left: 0;
    line-height: 0;
    overflow: hidden;
    position: absolute;
    width: 100%;
    z-index: 2;
  }

  #Banner-{{ section.id }} .rcl-shape[data-negative=false].rcl-shape-bottom, 
  #Banner-{{ section.id }} .rcl-shape[data-negative=true].rcl-shape-top {
    transform: rotate(180deg);
  }

  #Banner-{{ section.id }} .rcl-shape-bottom {
    bottom: -1px;
  }

  #Banner-{{ section.id }} .rcl-shape-bottom svg {
    fill: #fff;
    height: 55px;
    display: block;
    left: 50%;
    position: relative;
    transform: translateX(-50%);
    width: calc(100% + 1.3px);
  }
  
  /* Stats Block CSS */
  #Banner-{{ section.id }} .ssky-testimonials__stats-block {
    background-color: var(--stats-background-color, #00B1D8);
    color: var(--stats-text-color, #FFFFFF);
    border-radius: 10px;
    margin-bottom: 30px;
    width: 100%;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-item {
    text-align: center;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-title {
    font-size: 3.5rem;
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-subtitle {
    font-size: 1.5rem;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-stars {
    color: var(--stats-star-color, #FFD700);
    font-size: 2.5rem;
    line-height: 1;
    margin-top: 0.5rem;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-guarantee {
    position: relative;
    width: 120px;
    height: 120px;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-guarantee-circle {
    stroke: var(--stats-text-color, #FFFFFF);
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-guarantee-label {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 0.6rem;
    text-transform: uppercase;
    font-weight: bold;
    line-height: 1;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-guarantee-days {
    font-size: 2rem;
    margin: 0.2rem 0;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-top-row {
    display: flex;
    width: 100%;
    justify-content: space-between;
  }
  
  #Banner-{{ section.id }} .ssky-testimonials__stats-top-row .ssky-testimonials__stats-item {
    width: 48%;
  }
  
  /* Custom Color Overrides - Only applied when colors are set */
  {% if section.settings.heading_color != 'transparent' and section.settings.heading_color != blank %}
  #Banner-{{ section.id }} .banner__heading {
    color: {{ section.settings.heading_color }} !important;
  }
  {% endif %}
  
  {% if section.settings.caption_color != 'transparent' and section.settings.caption_color != blank %}
  #Banner-{{ section.id }} .ssky-text-block__caption {
    color: {{ section.settings.caption_color }} !important;
  }
  {% endif %}
  
  {% if section.settings.text_color != 'transparent' and section.settings.text_color != blank %}
  #Banner-{{ section.id }} .ssky-text-block__text {
    color: {{ section.settings.text_color }} !important;
  }
  {% endif %}

  /* Custom Button Colors */
  {% if section.settings.button_text_color != 'transparent' and section.settings.button_text_color != blank %}
  #Banner-{{ section.id }} .button {
    color: {{ section.settings.button_text_color }} !important;
  }
  {% endif %}

  {% if section.settings.button_background != 'transparent' and section.settings.button_background != blank %}
  #Banner-{{ section.id }} .button--primary {
    background-color: {{ section.settings.button_background }} !important;
    border-color: {{ section.settings.button_background }} !important;
  }
  
  #Banner-{{ section.id }} .button--secondary {
    border-color: {{ section.settings.button_background }} !important;
  }
  {% endif %}

  /* Custom Image Block styling */
  #Banner-{{ section.id }} .banner__content-custom-image {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  #Banner-{{ section.id }} .banner__content-custom-image img {
    max-width: 100%;
    height: auto;
    {% assign image_block = section.blocks | where: "type", "image_block" | first %}
    {% if image_block != blank %}
      {% if image_block.settings.image_size == 'small' %}
      max-width: 250px;
      max-height: 250px;
      {% elsif image_block.settings.image_size == 'smallplus' %}
      max-width: 350px;
      max-height: 350px;
      {% elsif image_block.settings.image_size == 'medium' %}
      max-width: 450px;
      max-height: 450px;
      {% elsif image_block.settings.image_size == 'large' %}
      max-width: 600px;
      max-height: 600px;
      {% endif %}
    {% endif %}
    object-fit: contain;
  }

  /* Mobile Layout: Follow block order */
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__content-container {
      display: flex;
      flex-direction: column;
    }
    
    #Banner-{{ section.id }} .banner__content-container > div {
      width: 100%;
      margin-bottom: 20px;
    }
    
    #Banner-{{ section.id }} .ssky-testimonials__stats-block {
      border-radius: 25px;
    }
    
    /* Stats block mobile layout */
    #Banner-{{ section.id }} .ssky-testimonials__stats-container {
      flex-direction: column;
    }
  }
  
  /* Desktop Layout: Fixed columns with proper separation */
  @media screen and (min-width: 750px) {
    /* The key change: create a wrapper for text content and content columns */
    #Banner-{{ section.id }} .banner__content-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    
    /* Group all text blocks into a text column */
    #Banner-{{ section.id }} .banner__content-text-column {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    
    /* Group media items into a media column */
    #Banner-{{ section.id }} .banner__content-media-column {
      grid-column: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    
    /* Override column position based on image position */
    {% assign image_block = section.blocks | where: "type", "image_block" | first %}
    {% if image_block != blank %}
      {% if image_block.settings.position == 'left' %}
        #Banner-{{ section.id }} .banner__content-text-column {
          grid-column: 2;
        }
        
        #Banner-{{ section.id }} .banner__content-media-column {
          grid-column: 1;
        }
      {% endif %}
    {% endif %}
    
    /* Make stats block span full width */
    #Banner-{{ section.id }} .ssky-testimonials__stats-block {
      grid-column: 1 / span 2;
    }
    
    /* Stats block desktop layout */
    #Banner-{{ section.id }} .ssky-testimonials__stats-container {
      flex-direction: row;
    }
    
    #Banner-{{ section.id }} .ssky-testimonials__stats-top-row {
      display: contents;
    }
    
    #Banner-{{ section.id }} .ssky-testimonials__stats-top-row .ssky-testimonials__stats-item {
      width: auto;
    }
  }

  /* YouTube Video Slider Block Styles */
  #Banner-{{ section.id }} .banner__content-text-column {
    {%- for block in section.blocks -%}
      {%- if block.type == 'youtube_video_slider'-%}
        {%- if block.settings.position == 'left' -%} 
          grid-area: text;
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  }

  #Banner-{{ section.id }} .banner__content-media-column {
    {%- for block in section.blocks -%}
      {%- if block.type == 'youtube_video_slider'-%}
        {%- if block.settings.position == 'left' -%} 
          grid-area: media;
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  }

  #Banner-{{ section.id }} .banner__content-video-slider {
    width: 100%;
    position: relative;
  }

  #Banner-{{ section.id }} .banner__video-slider {
    position: relative;
    width: 100%;
  }

  #Banner-{{ section.id }} .banner__video-slider-wrapper {
    width: 100%;
    position: relative;
  }

  #Banner-{{ section.id }} .banner__video-slide {
    position: relative;
    width: 100%;
    display: none;
    transition: opacity 0.3s ease;
  }

  #Banner-{{ section.id }} .banner__video-slide.active {
    display: block;
    opacity: 1;
  }

  #Banner-{{ section.id }} .banner__video-thumbnail {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    display: block;
  }

  #Banner-{{ section.id }} .banner__video-thumbnail img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  #Banner-{{ section.id }} .banner__video-thumbnail:hover img {
    transform: scale(1.05);
  }

  #Banner-{{ section.id }} .banner__video-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #Banner-{{ section.id }} .banner__video-play-button:hover {
    background-color: rgba(0, 0, 0, 0.9);
  }

  #Banner-{{ section.id }} .banner__video-play-button::after {
    content: '';
    width: 0;
    height: 0;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    border-left: 20px solid white;
    margin-left: 5px;
  }

  /* Video Slider Controls */
    #Banner-{{ section.id }} .banner__video-slider-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
    position: relative;
  }

  #Banner-{{ section.id }} .banner__video-slider-button {
    background: rgba(0, 0, 0, 0.5);
    border: 0;
    padding: 10px;
    cursor: pointer;
    color: white;
    font-size: 1.8rem;
    transition: background-color 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: -10vw; 
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  #Banner-{{ section.id }} .banner__video-slider-button:hover {
    background: rgba(255, 255, 255, 0.8);
    color: #000;
  }

  /* Video slider dots */
  #Banner-{{ section.id }} .banner__video-slider-dots {
    display: flex;
    justify-content: center;
    margin: 0 10px;
  }

  #Banner-{{ section.id }} .banner__video-slider-button--prev {
    left: 10px;
  }

  #Banner-{{ section.id }} .banner__video-slider-button--next {
    right: 10px;
  }

  #Banner-{{ section.id }} .banner__video-slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ccc;
    margin: 0 5px;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  #Banner-{{ section.id }} .banner__video-slider-dot:hover {
    transform: scale(1.2);
  }

  #Banner-{{ section.id }} .banner__video-slider-dot.active {
    background-color: #000;
    transform: scale(1.2);
  }

  /* Slide animations */
  #Banner-{{ section.id }} .banner__video-slide {
    position: relative;
    width: 100%;
    display: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  #Banner-{{ section.id }} .banner__video-slide.active {
    display: block;
    opacity: 1;
    animation: fadeZoomIn 0.5s forwards;
  }

  #Banner-{{ section.id }} .banner__video-slide.slide-out-to-left {
    animation: fadeZoomOutLeft 0.5s forwards;
  }

  #Banner-{{ section.id }} .banner__video-slide.slide-out-to-right {
    animation: fadeZoomOutRight 0.5s forwards;
  }

  @keyframes fadeZoomIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fadeZoomOutLeft {
    from {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateX(-30px);
      display: none;
    }
  }

  @keyframes fadeZoomOutRight {
    from {
      opacity: 1;
      transform: scale(1) translateX(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateX(30px);
      display: none;
    }
  }

  /* Video container for non-lightbox mode */
  #Banner-{{ section.id }} .banner__video-inline-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    display: none;
  }

  #Banner-{{ section.id }} .banner__video-inline-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  #Banner-{{ section.id }} .banner__video-slider-wrapper.single-video + .banner__video-slider-controls {
    display: none;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__video-play-button {
      width: 40px;
      height: 40px;
    }
    
    #Banner-{{ section.id }} .banner__video-play-button::after {
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-left: 14px solid white;
    }
    
    #Banner-{{ section.id }} .banner__video-slider-button {
      width: 32px;
      height: 32px;
      font-size: 1.4rem;
      top: -120px; 
    }
      
    #Banner-{{ section.id }} .banner__video-slider-dot {
      width: 8px;
      height: 8px;
      margin: 0 4px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  
  assign stats_block = section.blocks | where: "type", "stats_block" | first
  assign image_block = section.blocks | where: "type", "image_block" | first
  assign youtube_block = section.blocks | where: "type", "youtube_video" | first
  assign video_slider_block = section.blocks | where: "type", "youtube_video_slider" | first 
-%}

<div
  id="Banner-{{ section.id }}"
  class="ssky-banner banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{%- unless section.settings.full_width_container %} page-width{%- endunless -%}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank and section.settings.hide_main_image == false %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {% if stats_block != blank %}
    <style>
      #Banner-{{ section.id }} .ssky-testimonials__stats-block {
        --stats-background-color: {{ stats_block.settings.background_color }};
        --stats-text-color: {{ stats_block.settings.text_color }};
        --stats-star-color: {{ stats_block.settings.star_color }};
      }
    </style>
  {% endif %}

  {%- if section.settings.image != blank and section.settings.hide_main_image == false -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        if section.settings.image_2 != blank
          assign image_class = 'banner__media-image-half'
        endif
        if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
          assign sizes = stacked_sizes
        elsif section.settings.image_2 != blank
          assign sizes = half_width
        else
          assign sizes = full_width
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {%- elsif section.settings.image_2 == blank and section.settings.hide_main_image == false -%}
    <div class="banner__media media{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_2 != blank %} banner__media-half{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  
  {%- if section.settings.image_2 != blank and section.settings.hide_main_image == false -%}
