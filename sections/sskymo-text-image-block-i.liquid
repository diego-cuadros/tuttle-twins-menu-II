{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign merging_with_section_below = false
  assign show_as_card = false
  assign narrow_width = false
  if section.settings.merging_with_section_below == true
    assign merging_with_section_below = true
  elsif section.settings.show_as_card == true
    assign show_as_card = true
  elsif section.settings.narrow_width == true
    assign narrow_width = true
  endif
-%}
{%- style -%}
  .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-image-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if merging_with_section_below -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      z-index: 1;
    }
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    }
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__layout-merging-color {
      background-color: {{ section.settings.merging_color }};
    }
    {%- if section.settings.overflow_image > 0 -%}
      @media screen and (min-width: 1140px) {
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__layout-merging {
          padding-top: {{ section.settings.overflow_image |  divided_by: 2 }}px
        }
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
          overflow: unset;
          padding-top: 0 !important;
        }
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__image {
          margin-top: -{{ section.settings.overflow_image }}px;
        }
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__blocks {
          padding-top: 3.2rem;
        }
      }
    {%- endif -%}
    {%- if section.settings.remove_bottom_space -%}
      @media screen and (min-width: 990px) {
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
          padding-bottom: 0;
        }
      }
    {%- endif -%}
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__section-header {
      margin-bottom: 2rem;
    }
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-text-image-block-{{ section.id }}">
  <div class="ssky-text-image-block content-container color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
    {%- for magazine_your_children in shop.metaobjects.magazine_your_children.values limit: 1 -%}
      <div class="ssky-text-image-block__section-header page-width">
        <div class="ssky-text-block__blocks center">
          {%- if magazine_your_children.heading != blank -%}
            {%- assign heading_length = magazine_your_children.heading | metafield_text | size -%}
            <h2
              class="ssky-text-block__heading rte h2{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ magazine_your_children.heading | metafield_tag }}
            </h2>
          {%- endif -%}
        </div>
      </div>

      {%- if merging_with_section_below -%}
        <div class="ssky-text-image-block__layout-merging{%- if section.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above page-width{%- endif -%}">
          <div class="color-{{ section.settings.color_scheme_layout_merging }} gradient">
      {%- endif -%}
      {%- if show_as_card -%}<div class="page-width">{%- endif -%}
      <div class="ssky-text-image-block__wrapper {{ section.settings.image_position }} page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
        <div class="ssky-text-image-block__image">
          <div
            class="{%- if magazine_your_children.image != blank %}media{%- else %}placeholder{%- endif -%}{%- if magazine_your_children.image_fill_or_fit != false %} image-fit{%- endif -%}"
            style="padding-bottom:{%- if merging_with_section_below or narrow_width -%}{{ 1 | divided_by: magazine_your_children.image.value.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- else -%}{{ 1 | divided_by: magazine_your_children.image.value.image.aspect_ratio | times: 100 | at_most: 100 }}%;{%- endif -%}"
          >
            {%- if magazine_your_children.image != blank -%}
              {%- assign widths = '360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
              {{
                magazine_your_children.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="ssky-text-image-block__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
          <div
            class="ssky-text-block__text rte text-medium{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ magazine_your_children.description | metafield_tag }}
          </div>
        </div>
      </div>
      {%- if show_as_card -%}</div>{%- endif -%}
      {%- if merging_with_section_below -%}
        </div>
        </div>
        <div
          class="ssky-text-image-block__layout-merging-color {%- if section.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above{%- endif -%}"
        ></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "TTm Magazine yourChildren",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "image-left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "image-right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "image-right",
      "label": "Image position"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.narrow"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.merging"
    },
    {
      "type": "checkbox",
      "id": "merging_with_section_below",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_layout_merging",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "merging_color",
      "label": "Merging color",
      "default": "#bcecf6"
    },
    {
      "type": "range",
      "id": "overflow_image",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Overflow image from above",
      "info": "Use this when the text content is smaller than the image. Desktop only.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "merge_with_section_above",
      "label": "t:sections.all.ssky_layouts.extension.merging_above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_space",
      "label": "Remove bottom space",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.custom_class.header"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_class.label",
      "info": "t:sections.all.custom_class.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Magazine yourChildren"
    }
  ]
}
{% endschema %}
