    "ssky_text_block_FCqjKC": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_eq63fy": {
          "type": "heading",
          "settings": {
            "heading": "<p>A Closer Look at What’s Inside <br/>the Economics Curriculum:</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_DyJq6L": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "center",
            "text": "<p>30 Questions That Teach the Principles of Free Market Economics</p>",
            "text_size": "extra-extra-large",
            "text_weight": "bold"
          }
        },
        "highlights_fPNRK8": {
          "type": "highlights",
          "settings": {
            "alignment": "left",
            "highlight_a": "<p>1. Do you really need that?</p>",
            "custom_color_a": "",
            "highlight_b": "<p>2. What makes something useful?</p>",
            "custom_color_b": "",
            "highlight_c": "<p>3. Why can’t you always get what you want?</p>",
            "custom_color_c": "",
            "highlight_d": "<p>4. Can you have your cake and eat it too?</p>",
            "custom_color_d": "",
            "highlight_e": "<p>5. Why do people do what they do?</p>",
            "custom_color_e": "",
            "highlight_f": "<p>6. Where does value come from?</p>",
            "custom_color_f": "",
            "highlight_g": "<p>7. Where does value go?</p>",
            "custom_color_g": "",
            "highlight_h": "<p>8. Why do people produce certain things?</p>",
            "custom_color_h": "",
            "highlight_i": "<p>9. How does production create wealth?</p>",
            "custom_color_i": "",
            "highlight_j": "<p>10. What are the costs of trade?</p>",
            "custom_color_j": ""
          }
        },
        "highlights_mtrMEt": {
          "type": "highlights",
          "settings": {
            "alignment": "left",
            "highlight_a": "<p>11. How do we trade?</p>",
            "custom_color_a": "",
            "highlight_b": "<p>12. What does money do?</p>",
            "custom_color_b": "",
            "highlight_c": "<p>13. What should money be?</p>",
            "custom_color_c": "",
            "highlight_d": "<p>14. How do we decide what to buy?</p>",
            "custom_color_d": "",
            "highlight_e": "<p>15. What determines demand?</p>",
            "custom_color_e": "",
            "highlight_f": "<p>16. How do we decide what to sell?</p>",
            "custom_color_f": "",
            "highlight_g": "<p>17. How do supply and demand work together?</p>",
            "custom_color_g": "",
            "highlight_h": "<p>18. What’s the price of time?</p>",
            "custom_color_h": "",
            "highlight_i": "<p>19. How do banks work?</p>",
            "custom_color_i": "",
            "highlight_j": "<p>20. What is Keynesianism?</p>",
            "custom_color_j": ""
          }
        },
        "highlights_6Re8kF": {
          "type": "highlights",
          "settings": {
            "alignment": "left",
            "highlight_a": "<p>21. What can central banks do to our money?</p>",
            "custom_color_a": "",
            "highlight_b": "<p>22. How do boom and bust cycles actually work?</p>",
            "custom_color_b": "",
            "highlight_c": "<p>23. How does a business work?</p>",
            "custom_color_c": "",
            "highlight_d": "<p>24. What is a monopoly?</p>",
            "custom_color_d": "",
            "highlight_e": "<p>25. What are taxes?</p>",
            "custom_color_e": "",
            "highlight_f": "<p>26. How do people from different countries trade?</p>",
            "custom_color_f": "",
            "highlight_g": "<p>27. How do people invest their money?</p>",
            "custom_color_g": "",
            "highlight_h": "<p>28. How do people make political decisions?</p>",
            "custom_color_h": "",
            "highlight_i": "<p>29. What’s the best economic system?</p>",
            "custom_color_i": "",
            "highlight_j": "<p>30. How can we use economics?</p>",
            "custom_color_j": ""
          }
        }
      },
