        },
        "text_column_ccF66k": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<p>Engaging Storytelling About <br/>the Most Important Ideas of Our Time</p>",
            "text": "<p>Our books introduce the ideas of liberty to a new generation</p>",
            "text_large": true,
            "button_label": "",
            "button_link": "",
