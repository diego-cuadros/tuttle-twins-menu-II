          "type": "text",
          "settings": {
            "max_width": 85,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>Connor's Your-Kids-Will-Love-The-Tuttle-Twins-Or-I-Will-Refund-Your-Money-And-You-Keep-The-Books Guarantee!<\/p>",
            "text_size": "extra-extra-large",
            "text_weight": "bold"
          }
        },
        "text_j9HRNk": {
          "type": "text",
          "settings": {
            "max_width": 88,
            "custom_color": "",
