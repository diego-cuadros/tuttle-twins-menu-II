          "id": "featured_image_alt",
          "label": "Featured Image Alt Text"
        },
        {
          "type": "richtext",
          "id": "blog_content",
          "label": "Blog Content",
          "default": "<p>Your blog content goes here.</p>"
        }
      ],
      "blocks": [
        {
          "type": "blog_header_block",
          "name": "Blog Header Block",
          "settings": [
            {
