                          align-items: flex-start;
                        }
                        
                        .ssky-box-image-block-{{ section.id }} .icon-position-right .ssky-text-column__block--w--icons-icon {
                          flex-shrink: 0;
                          display: flex;
                          align-items: flex-start;
