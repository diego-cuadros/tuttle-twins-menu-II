{% style %}
    .section-{{ section.id }} {
        background: {{ section.settings.bg_color }};
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .section-{{ section.id }} .font-label-color { color: {{ section.settings.label-color }}; }
    @media screen and (min-width: 768px) {
        .section-{{ section.id }} {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
        }
    }
{% endstyle %}


<section class="how-it-works section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.section_heading %}
        <h2 class="section-title font-label-color">{{ section.settings.section_heading }}</h2>
    {% endif %}

    <div class="how-it-works-wrapper">
      
      <div class="steps">
        {% for block in section.blocks %}
          <div class="step-card" {{ block.shopify_attributes }}>
            
            {% if block.settings.step_image %}
              <div class="step-image">
                <img 
                  src="{{ block.settings.step_image | image_url: width: 200 }}" 
                  alt="{{ block.settings.step_title }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
            
            <div class="step-content">
              <h3 class="step-title">{{ forloop.index }}. {{ block.settings.step_title }}</h3>
              <div class="step-description">{{ block.settings.step_description }}</div>
            </div>

          </div>
        {% endfor %}
      </div>

      <div class="right-image">
        {% if section.settings.right_image %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 800 }}" 
            alt="How it works image"
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
    .how-it-works .section-title {
        font-family: Poppins;
        font-weight: 500;
        font-size: 40px;
        line-height: 48px;
        letter-spacing: 0px;
        text-align: center;
        padding-bottom: 48px;
        margin: 0;
    }

    .how-it-works-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: center;
    }

    .steps {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .step-card {
        display: flex;
        gap: 20px;
        background: #fff;
        padding: 12px;
        border-radius: 12px;
        align-items: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .step-image img {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: 12px;
        display: block;
    }

    .step-content .step-title {
        font-family: Poppins;
        font-weight: 500;
        font-size: 24px;
        line-height: 34px;
        letter-spacing: 0;
        color: #3F3939;
        margin: 0;
        padding-bottom: 6px;
    }

    .step-content .step-description {
        font-family: Poppins;
        font-weight: 400;
        font-size: 16px;
        line-height: 26px;
        letter-spacing: 0;
        color: #3F3939;
        margin: 0;
        opacity: 0.7;
    }

    .right-image img {
        width: 100%;
        border-radius: 20px;
        display: block;
    }

    @media screen and (max-width: 1199px) {
        .step-content .step-title {
            font-size: 18px;
            line-height: 22px;
        }
        .step-content .step-description {
            font-size: 14px;
            line-height: 18px;
        }
        .step-image img {
            width: 110px;
            height: 110px;
        }
    }

    @media screen and (max-width: 991px) {
        .how-it-works-wrapper {
            grid-template-columns: 1fr;
        }

        .right-image {
            order: -1;
        }

        .how-it-works .section-title {
            font-size: 32px;
        }
    }

    @media screen and (max-width: 767px) {
        .right-image {display: none;}
        .how-it-works .section-title {
            font-size: 28px;
            line-height: 34px;
            padding-bottom: 20px;
        }
        .step-image img {
            width: 100px;
            height: 100px;
            border-radius: 8px;
        }
        .step-card {gap: 16px;}
        .steps {gap: 8px;}
        .how-it-works .page-width {padding: 0 16px;}
        .step-card {padding: 8px;}
    }
</style>

{% schema %}
{
    "name": "How It Works",
    "settings": [
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#05AED8"
        },
        {
            "type": "color",
            "id": "label-color",
            "label": "Label Color",
            "default": "#fff"
        },
        {
            "type": "text",
            "id": "section_heading",
            "label": "Heading",
            "default": "How It Works"
        },
        {
            "type": "image_picker",
            "id": "right_image",
            "label": "Right Side Image"
        },
        {
            "type": "header",
            "content": "t:sections.all.padding.section_padding_heading"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 64
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 64
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top Mobile",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom Mobile",
            "default": 32
        },
    ],
    "blocks": [
        {
            "type": "step",
            "name": "Step",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "step_image",
                    "label": "Step Image"
                },
                {
                    "type": "text",
                    "id": "step_title",
                    "label": "Step Title",
                },
                {
                    "type": "textarea",
                    "id": "step_description",
                    "label": "Step Description",
                }
            ]
        }
    ],
    "max_blocks": 3,
    "presets": [
        {
            "name": "How It Works",
            "blocks": [
                { "type": "step" },
                { "type": "step" },
                { "type": "step" }
            ]
        }
    ]
}
{% endschema %}