{%- liquid
  assign show_as_card = false
  if section.settings.show_as_card == true
    assign show_as_card = true
  endif
-%}
{%- style -%}
  .ssky-testimonials-{{ section.id }} .ssky-testimonials {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-testimonials-{{ section.id }} .ssky-testimonials {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .ssky-testimonials-{{ section.id }} .ssky-testimonials__blocks {
      max-width: {{ section.settings.max_width }}rem;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-testimonials-{{ section.id }} .ssky-testimonials {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-testimonials-{{ section.id }} .ssky-testimonials {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-testimonials-{{ section.id }} .ssky-testimonials {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-testimonials-{{ section.id }} .ssky-testimonials {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-testimonials-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-testimonials-{{ section.id }} .ssky-testimonials__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-testimonials-{{ section.id }} .ssky-testimonials__wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-testimonials-{{ section.id }}">
  <div class="ssky-testimonials ssky-text-block content-container color-{{ section.settings.color_scheme }} gradient">
    {%- if show_as_card -%}
      <div class="page-width">
    {%- endif -%}
    <div class="ssky-testimonials__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-testimonials__blocks ssky-text-block__blocks center">
        {%- for testimonials_get_yours in shop.metaobjects.testimonials_get_yours.values limit: 9 -%}
          {%- if testimonials_get_yours.main_heading != blank -%}
            {%- assign heading_length = testimonials_get_yours.main_heading | metafield_text | size -%}
            <h2
              class="ssky-text-block__heading rte inline-richtext h1{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ testimonials_get_yours.main_heading | metafield_tag }}
            </h2>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for testimonials_get_yours in shop.metaobjects.testimonials_get_yours.values limit: 9 -%}
            {%- if testimonials_get_yours.review_stars_image != blank -%}
              {%- assign review_stars_image = testimonials_get_yours.review_stars_image -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
      </div>

      <div class="ssky-testimonials__column-blocks">
        {%- for testimonials_get_yours in shop.metaobjects.testimonials_get_yours.values limit: 9 -%}
          <div
            class="ssky-testimonials__column-block color-scheme-1{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="ssky-testimonials__column-block-author-con">
              {%- if testimonials_get_yours.image != blank -%}
                <div class="ssky-testimonials__block-author-image media">
                  {{ testimonials_get_yours.image | image_url: width: 140 | image_tag }}
                </div>
              {%- endif -%}
              <div>
                <div class="ssky-testimonials__block-author">
                  {{ testimonials_get_yours.author }}
                </div>
                <div class="ssky-testimonials__block-state">
                  {{ testimonials_get_yours.state }}
                </div>
              </div>
            </div>
            <div class="ssky-testimonials__block-text rte">
              {{ testimonials_get_yours.testimonial | metafield_tag }}
            </div>
            {%- if review_stars_image -%}
              <div class="ssky-testimonials__block-stars">
                {{ review_stars_image | image_url: width: 240 | image_tag }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TTm Testimonial get yours",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.ssky_text_block.settings.block_specific.label"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 72,
      "max": 100,
      "step": 1,
      "label": "Content width for heading and text block only.",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Testimonial get yours"
    }
  ]
}
{% endschema %}
