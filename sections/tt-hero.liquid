{%- style -%}
  .tt-hero-{{ section.id }} .tt-hero {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .tt-hero-{{ section.id }} .tt-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .tt-hero-{{ section.id }} .tt-hero {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .tt-hero-{{ section.id }} .tt-hero {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .tt-hero-{{ section.id }} .tt-hero {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .tt-hero-{{ section.id }} .tt-hero {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .tt-hero-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

{{ 'tt-hero.css' | asset_url | stylesheet_tag }}
{{ 'tt-visibility.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visibility_classes = ''
  if section.settings.hide_on_mobile
    assign visibility_classes = visibility_classes | append: ' hide-mobile'
  endif
  if section.settings.hide_on_tablet
    assign visibility_classes = visibility_classes | append: ' hide-tablet'
  endif
  if section.settings.hide_on_desktop
    assign visibility_classes = visibility_classes | append: ' hide-desktop'
  endif
-%}

<div class="tt-hero-{{ section.id }}{{ visibility_classes }}">
  <div class="tt-hero gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="tt-hero__blocks" style="align-items: {{ section.settings.vertical_alignment }};">
        <div class="tt-hero__block-left">
          {% content_for 'blocks' %}
        </div>
        {%- if section.settings.image != blank -%}
          <div class="tt-hero__image">
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag: widths: '360, 535, 750, 1070, 1150, 1500', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager'
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TT Hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center",
      "label": "Vertical alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Round Corners",
      "info": "Use only one at a time."
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "Top left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "Top Right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "Bottom Right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "Bottom Left",
      "default": true
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "Corner Color"
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    {
      "name": "TT Hero",
      "blocks": [
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button-group" },
        { "type": "tt-milestones" }
      ]
    }
  ]
}
{% endschema %}
