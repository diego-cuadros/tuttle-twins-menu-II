    "ssky_product_order_block_L3bKrz": {
      "type": "ssky-product-order-block",
      "blocks": {
        "order_block_one_47z7g6": {
          "type": "order_block_one",
          "settings": {
            "product": "tuttle-twins-combo-pack-plus-free-bonuses",
            "heading": "",
            "heading_size": "h3",
            "heading_weight": "semibold",
            "text": "<p>If you are looking for a structured and well designed education supplement for your family to learn the principles of freedom and true history, you are in the right place.</p>",
            "text_size": "large",
            "text_weight": "semibold",
            "max_width": 64,
            "button_label": "Get The 14-Book Series",
            "button_link": "",
            "button_style_secondary": false,
            "button_large": true,
            "button_full": false,
            "show_price": true,
            "show_price_bottom": true,
            "text_below_buttons": "<p>Includes All 14 Workbook PDFs Free</p>"
          }
