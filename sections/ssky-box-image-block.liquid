                        }
                        
                        .ssky-box-image-block-{{ section.id }} .icon-position-top .ssky-text-block__blocks {
                          display: flex;
                          flex-direction: column;
                          align-items: center;
                          text-align: center;
                        }
                        
                        .ssky-box-image-block-{{ section.id }} .icon-position-top .ssky-text-column__block--w--icons-icon {
                          display: flex;
