{%- style -%}
  .ssky-text-block__highlights-con-{{ block.id }} {
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  } 
  @media screen and (min-width: 750px) {
    .ssky-text-block__highlights-con-{{ block.id }} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__highlights-con-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}

<div class="ssky-text-block__highlights-con ssky-text-block__highlights-con-{{ block.id }}">
  <div
    class="ssky-text-block__highlights {{ block.settings.alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
    {% for i in (1..10) %}
      {%- liquid
        assign text_id = 'highlight_' | append: i
        assign color_id = 'custom_color_' | append: i
        assign text = block.settings[text_id]
        assign color = block.settings[color_id]
      -%}
      {% if text != blank %}
        <div class="ssky-text-block__highlight">
          <div class="rte"{% if color != blank %} style="{{ color }}"{% endif %}>{{ text }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
