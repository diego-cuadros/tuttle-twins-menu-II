{%- comment -%}
  Shopify robots.txt.liquid
  Strategy:
  1) Preserve Shopify default robots groups/rules
  2) Add explicit AI bot groups after defaults
  3) Keep checkout/cart/account/admin and preview paths blocked
{%- endcomment -%}

{%- for group in robots.default_groups -%}
{{- group.user_agent -}}
{%- for rule in group.rules -%}
{{ rule }}
{%- endfor -%}
{%- if group.sitemap != blank -%}
{{ group.sitemap }}
{%- endif -%}

{%- endfor -%}

