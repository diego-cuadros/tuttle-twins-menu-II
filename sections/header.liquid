        {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Add icon 2"
        },
        {
          "type": "number",
          "id": "use_icon_2",
          "label": "Use icon 2 on link number:"
        },
        {
          "type": "image_picker",
          "id": "icon_3",
          "label": "Add icon 3"
        },
        {
          "type": "number",
          "id": "use_icon_3",
          "label": "Use icon 3 on link number:"
