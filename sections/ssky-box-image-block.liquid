{% comment %}
  DO NOT modify this file, its classes, or CSS. It is a universal module.
{% endcomment %}
{%- assign has_button_with_lightbox = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'button' and block.settings.use_video_lightbox or block.settings.use_video_lightbox_2 -%}
    {%- assign has_button_with_lightbox = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_button_with_lightbox -%}
  <script src="{{ 'jquery-3.7.1.min.js' | asset_url }}" defer></script>
  <script src="{{ 'lity.min.js' | asset_url }}" defer></script>
  <link rel="stylesheet" href="{{ 'lity.min.css' | asset_url }}">
{%- endif -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign merging_with_section_below = false
  assign show_as_card = false
  assign narrow_width = false
  if section.settings.merging_with_section_below == true
    assign merging_with_section_below = true
  elsif section.settings.show_as_card == true
    assign show_as_card = true
  elsif section.settings.narrow_width == true
    assign narrow_width = true
  endif
-%}
{%- style -%}
  {%- if section.settings.background_image != blank -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      position: relative;
      background-image: url({{ section.settings.background_image | image_url }});
      background-position: {{ section.settings.background_position }};
      background-size: {{ section.settings.background_size }};
      background-repeat: no-repeat;
    }
    
    {%- if section.settings.background_overlay -%}
      .ssky-box-image-block-{{ section.id }} .ssky-box-image-block:after {
        content: '';
        display: block;
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: {{ section.settings.background_overlay_color }};
        opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
        pointer-events: none;
        z-index: 1;
      }
      
      .ssky-box-image-block-{{ section.id }} .ssky-box-image-block > * {
        position: relative;
        z-index: 2;
      }
    {%- endif -%}
  {%- endif -%}

  .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__image-column {
    width: 100%;
  }
  {% unless section.settings.rounded %}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__image-column .ssky-box-image-block__image > .media {
      border-radius: 0;
    }
  {% endunless %}
  @media screen and (min-width: 750px) {
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-box-image-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if merging_with_section_below -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block {
      z-index: 1;
    }
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
      padding-top: {{ section.settings.inner_padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.inner_padding_top | times: 0.75 | round: 0 }}px;
    }
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__layout-merging-color {
      background-color: {{ section.settings.merging_color }};
    }
    {%- if section.settings.overflow_image > 0 -%}
      @media screen and (min-width: 1140px) {
        .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__layout-merging {
          padding-top: {{ section.settings.overflow_image |  divided_by: 2 }}px
        }
        .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
          overflow: unset;
          padding-top: 0 !important;
        }
        .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__image {
          margin-top: -{{ section.settings.overflow_image }}px;
        }
        .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__blocks {
          padding-top: 3.2rem;
        }
      }
    {%- endif -%}
    {%- if section.settings.remove_bottom_space -%}
      @media screen and (min-width: 990px) {
        .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
          padding-bottom: 0;
        }
      }
    {%- endif -%}
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 0px;
    }
    @media screen and (min-width: 750px) {
      .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
        padding-top: {{ section.settings.inner_padding_top }}px;
        padding-bottom: {{ section.settings.inner_padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__section-header {
      margin-bottom: 2rem;
    }
    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}

  .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__text-promo {
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
    width: 100%;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-promo__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .ssky-box-image-block-{{ section.id }} .ssky-text-promo__content {
      flex-direction: row;
      align-items: center;
    }

    .ssky-box-image-block-{{ section.id }} .ssky-box-image-block__wrapper {
      align-items: flex-start;
    }

    .ssky-box-image-block-{{ section.id }} .ssky-text-promo__text-column {
      width: 50%;
      padding-right: 2rem;
    }

    .ssky-box-image-block-{{ section.id }} .ssky-text-promo__action-column {
      width: 50%;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-promo__secondary-link {
    margin-top: 1rem;
    text-align: center;
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-promo__secondary-link.primary {
    color: var(--color-primary);
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-promo__secondary-link.secondary {
    color: var(--color-secondary);
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-promo__secondary-link.tertiary {
    color: var(--color-tertiary);
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__heading {
    margin-bottom: 1rem;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__caption {
    margin-bottom: 1rem;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__text {
    margin-bottom: 1.5rem;
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__text.text-left {
    text-align: left;
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__text.text-center {
    text-align: center;
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__text.text-right {
    text-align: right;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__price {
    margin-bottom: 1.5rem;
  }
  
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__price.secondary-price {
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons .button,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons button,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"] {
    background: transparent !important;
    border: none !important;
    border-width: 0 !important;
    border-style: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
    outline: none !important;
    padding: 0 !important;
    margin: 0 !important;
    text-decoration: underline;
    {%- for block in section.blocks -%}
      {%- if block.type == 'text_promo' -%}
        {%- if block.settings.secondary_link_color != blank -%}
        color: {{ block.settings.secondary_link_color }} !important;
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons .button:before,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons .button:after,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons button:before,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons button:after,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:before,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:after {
    display: none !important;
    content: none !important;
    border: none !important;
  }

  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons .button:hover,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons button:hover,
  .ssky-box-image-block-{{ section.id }} .ssky-text-block__buttons.secondary-buttons input[type="submit"]:hover {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    {%- for block in section.blocks -%}
      {%- if block.type == 'text_promo' -%}
        {%- if block.settings.secondary_link_color != blank -%}
        color: {{ block.settings.secondary_link_color }} !important;
        {%- else -%}
        color: inherit !important;
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  }
  {% if section.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-box-image-block-' | append: section.id %}
    {{ section.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-box-image-block-{{ section.id }}">
  <div class="ssky-box-image-block content-container color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'section_header' -%}
          <div class="ssky-box-image-block__section-header page-width" {{ block.shopify_attributes }}>
            <div class="ssky-text-block__blocks center">
              {%- if block.settings.caption != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.section_heading != blank -%}
                {%- assign section_heading_length = block.settings.section_heading | size -%}
                <{{block.settings.heading_tag}}
                  class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if section_heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.section_heading }}
                </{{block.settings.heading_tag}}>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style_subheading }} {{ block.settings.color_class_subheading }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.subheading | escape }}
                </div>
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
    {%- if merging_with_section_below -%}
      <div class="ssky-box-image-block__layout-merging{%- if section.settings.merge_with_section_above %} ssky-box-image-block__layout-merging-above page-width{%- endif -%}">
        <div class="color-{{ section.settings.color_scheme_layout_merging }} gradient">
    {%- endif -%}
    {%- if show_as_card -%}<div class="page-width">{%- endif -%}
    <div class="ssky-box-image-block__wrapper {{ section.settings.image_position }} image-size-ssky-{{ section.settings.image_size }} page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-box-image-block__image-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'text_promo' -%}
            {%- if block.settings.promo_position == 'image-side' or block.settings.promo_position == 'text-side' -%}
              <div 
                class="ssky-box-image-block__text-promo color-{{ block.settings.promo_color_scheme }} gradient"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="ssky-text-promo__content">
                  <div class="ssky-text-promo__text-column">
                    {%- if block.settings.promo_heading != blank -%}
                      <{{ block.settings.heading_tag }} 
                        class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}"
                      >
                        {{ block.settings.promo_heading }}
                      </{{ block.settings.heading_tag }}>
                    {%- endif -%}
                    
                    {%- if block.settings.promo_subheading != blank -%}
                      <div class="ssky-text-block__caption {{ block.settings.text_style_subheading }}">
                        {{ block.settings.promo_subheading }}
                      </div>
                    {%- endif -%}
                    
                    {%- if block.settings.promo_text != blank -%}
                      <div class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }} text-{{ block.settings.text_align }}">
                        {{ block.settings.promo_text }}
                      </div>
                    {%- endif -%}
                  </div>
                  
                  <div class="ssky-text-promo__action-column">
                    {%- if block.settings.product != blank -%}
                      <script src="{{ 'product-form.js' | asset_url }}" defer></script>
                      {%- assign block_product = block.settings.product -%}
                      {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id | append: '-promo' -%}
                      {%- if block.settings.show_price -%}
                        <div class="ssky-text-block__price">
                          {% render 'price', product: block_product, show_compare_at_price: true %}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    
                    <div class="ssky-text-block__buttons{% if block.settings.promo_button_text != blank and block.settings.promo_button_text_2 != blank %} ssky-text-block__buttons--multiple{% endif %}">
                      {%- if block.settings.product != blank -%}
                        {%- render 'buy-buttons',
                          block: block,
                          product: block_product,
                          product_form_id: product_form_id,
                          section_id: section.id,
                          is_button_large: block.settings.button_large,
                          button_label: block.settings.product_button_label
                        -%}
                      {%- else -%}
                        {%- if block.settings.promo_button_text != blank -%}
                          <a {% if block.settings.promo_button_link == blank %}
                            role="link" aria-disabled="true"
                          {% else %}
                            href="{{ block.settings.promo_button_link }}"
                          {% endif %}
                          class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{% if block.settings.promo_button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                          >
                            {{- block.settings.promo_button_text | escape -}}
                          </a>
                        {%- endif -%}
                        
                        {%- if block.settings.promo_button_text_2 != blank -%}
                          <a {% if block.settings.promo_button_link_2 == blank %}
                            role="link" aria-disabled="true"
                          {% else %}
                            href="{{ block.settings.promo_button_link_2 }}"
                          {% endif %}
                          class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{% if block.settings.promo_button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                          >
                            {{- block.settings.promo_button_text_2 | escape -}}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                    
                    {%- if block.settings.promo_secondary_text != blank -%}
                      {%- if block.settings.promo_secondary_link != blank or block.settings.secondary_product != blank -%}
                        <div class="ssky-text-promo__secondary-link">
                          — OR —
                          {%- if block.settings.secondary_product != blank -%}
                            {%- assign secondary_product = block.settings.secondary_product -%}
                            {%- assign secondary_product_form_id = 'product-form-' | append: section.id | append: secondary_product.id | append: '-promo-secondary' -%}
                            
                            {%- if block.settings.secondary_show_price -%}
                              <div class="ssky-text-block__price secondary-price">
                                {% render 'price', product: secondary_product, show_compare_at_price: true %}
                              </div>
                            {%- endif -%}
                            <div class="ssky-text-block__buttons secondary-buttons">
                              {%- render 'buy-buttons',
                                block: block,
                                product: secondary_product,
                                product_form_id: secondary_product_form_id,
                                section_id: section.id,
                                button_label: block.settings.secondary_product_button_label
                              -%}
                            </div>
                          {%- else -%}
                            <a href="{{ block.settings.promo_secondary_link }}">{{ block.settings.promo_secondary_text }}</a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
    
        <div class="ssky-box-image-block__image">
          <div
            class="{%- if section.settings.image != blank %}media{%- else %}placeholder{%- endif -%}{%- if section.settings.image_fit %} image-fit{%- endif -%}"
            style="padding-bottom:{%- if merging_with_section_below or narrow_width -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- elsif section.settings.image_size == 'small' -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 150 }}%;{%- else -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 100 }}%;{%- endif -%}"
          >
            {%- if section.settings.image != blank -%}
              {%- assign widths = '360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>
      <div class="ssky-box-image-block__text-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'text_promo' and block.settings.promo_position == 'text-side' -%}
            <div 
              class="ssky-box-image-block__text-promo color-{{ block.settings.promo_color_scheme }} gradient"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <div class="ssky-text-promo__content">
                {%- if block.settings.promo_heading != blank -%}
                  <h3 class="ssky-text-promo__heading">{{ block.settings.promo_heading }}</h3>
                {%- endif -%}
                
                {%- if block.settings.promo_subheading != blank -%}
                  <div class="ssky-text-promo__subheading">{{ block.settings.promo_subheading }}</div>
                {%- endif -%}
                
                {%- if block.settings.promo_button_text != blank -%}
                  <a 
                    {% if block.settings.promo_button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.promo_button_link }}"
                    {% endif %}
                    class="button{% if block.settings.promo_button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{ block.settings.promo_button_text | escape }}
                  </a>
                {%- endif -%}
                
                {%- if block.settings.promo_secondary_text != blank and block.settings.promo_secondary_link != blank -%}
                  <div class="ssky-text-promo__secondary-link">
                    — OR —
                    <a href="{{ block.settings.promo_secondary_link }}">{{ block.settings.promo_secondary_text }}</a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        <div class="ssky-box-image-block__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- if block.type != 'text_promo' -%}
              {%- case block.type -%}
                {%- when 'caption' -%}
                  <div
                    class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
