    "ssky_testimonials_AWxtTJ": {
      "type": "ssky-testimonials",
      "blocks": {
        "testimonial_c9CfP8": {
          "type": "testimonial",
          "settings": {
            "max_width": 52,
            "testimonial_highlight": "<p>“I think my <strong>kids now understand more about</strong> how the free market works than most of Congress… these books need to be read by everyone, ASAP!“</p>",
            "testimonial": "<p>““</p>",
            "author": "Marcos D., Illinois",
            "author_state": "",
            "author_image": "shopify://shop_images/author_image_marcos.webp"
          }
        }
      },
