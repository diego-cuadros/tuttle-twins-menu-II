            "text_weight_b": "regular"
          }
        },
        "faq_qn6wmN": {
          "type": "faq",
          "settings": {
            "text": "<p>Are These Books Suitable for Independent Reading?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes. With simple, engaging language and eye-catching illustrations, our nonfiction for children can be enjoyed independently or as a shared family experience.</p>",
