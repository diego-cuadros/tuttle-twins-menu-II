{%- style -%}
  .ssky-text-block__icon-{{block.id}} {
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-block__icon-{{block.id}} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__icon-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}

  <div class="ssky-text-block__icon ssky-text-block__icon-{{block.id}}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
    {%- if block.settings.icon_svg != blank -%}
      {{- block.settings.icon_svg -}}
    {%- elsif block.settings.icon != blank -%}
      <img src="{{ block.settings.icon | image_url: width: nil }}">
    {%- endif -%}
  </div>

{% schema %}
  {
    "name": "Icon",
    "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.ssky_text_block.blocks.icon.settings.icon.label"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG Icon"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 20
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 20
        },
        {
          "type": "liquid",
          "id": "custom_css",
          "label": "Custom CSS",
          "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
        }
      ],
    "presets": [
      { "name": "Icon" }
    ]
  }
{% endschema %}