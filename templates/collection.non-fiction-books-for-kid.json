            "text_weight_b": "regular"
          }
        },
        "faq_Qarrcj": {
          "type": "faq",
          "settings": {
            "text": "<p>Can Parents Read These Books With Their Children?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Absolutely. We design every book for family reading. Discussion questions and fun activities help parents guide conversations and deepen learning.</p>",
