{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{% style %}
  @media screen and (max-width: 1024px) and (min-width: 768px) {
    {% if section.settings.columns_tablet == 1 %}
      .grid--1-col-tablet .grid__item {
        width: calc(100% - var(--grid-desktop-horizontal-spacing) / 2);
        max-width: 100%;
      }
    {% elsif section.settings.columns_tablet == 2 %}
      .grid--2-col-tablet .grid__item {
        width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2);
        max-width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2);
      }
    {% elsif section.settings.columns_tablet == 3 %}
      .grid--3-col-tablet .grid__item {
        width: calc(33.33% - var(--grid-desktop-horizontal-spacing) * 2 / 3);
        max-width: 33.33%;
      }
    {% endif %}
  }

  .custom-articles-section {
    position: relative;
    margin: -{{ section.settings.margin_top }}.5rem auto 0;
    max-width: 1250px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    padding: 6rem;
  }

  @media (max-width: 768px) {
    .custom-articles-section { padding: 3rem; }
  }

  .custom-articles-section .page-width { padding: 0; }

  .custom-articles-section__heading {
    font-size: 4.5rem;
    font-weight: 700;
    text-align: center;
    color: #091d52;
    margin: 0 0 2rem;
  }

  .custom-articles-section__subheading.rte {
    max-width: 1000px;
    font-size: 2.5rem;
    font-weight: normal;
    text-align: center;
    margin: 0 auto 4rem;
    color: #152136;
  }

  .custom-articles-grid__item .card.article-card {
    border-radius: 10px;
    box-shadow: 2px 5px 10px 0 rgba(180, 180, 180, 0.5);
  }

  .custom-articles-grid__item h3.card__heading.h2 {
    font-size: 2.375rem;
  }

  .custom-articles-grid__item .full-unstyled-link {
    color: #000;
  }

  /* Styles normally gated by `template contains 'blog'` */
  .article-card-wrapper { height: 100%; }
  .card.article-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card.article-card .card__content {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  .article-card__excerpt {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  .podcast-listen-now,
  .view-post {
    margin-top: auto;
  }

  /* View More */
  .custom-articles-grid__item.is-hidden {
    display: none;
  }

  .custom-articles-view-more {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }

  .custom-articles-view-more__btn {
    cursor: pointer;
  }
{% endstyle %}

{%- liquid
  assign handles = section.settings.blog_handles | split: ','
  assign combined = "" | split: ""

  for raw_handle in handles
    assign handle = raw_handle | strip
    assign b = blogs[handle]
    if b != blank
      assign combined = combined | concat: b.articles
    endif
  endfor

  assign combined = combined | sort: "published_at" | reverse

  assign initial_count = section.settings.articles_per_page
  assign step_count = section.settings.load_more_count
-%}

<section class="custom-articles-section gradient">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      {% if section.settings.h1 %}
        <h1 class="custom-articles-section__heading">{{ section.settings.heading }}</h1>
      {% else %}
        <h2 class="custom-articles-section__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="custom-articles-section__subheading rte">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div
      class="custom-articles-grid grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_tablet }}-col-tablet"
      data-id="{{ section.id }}"
      data-view-more-grid
      data-initial="{{ initial_count }}"
      data-step="{{ step_count }}"
    >
      {% for article in combined %}
        <div class="custom-articles-grid__item grid__item{% if forloop.index > initial_count %} is-hidden{% endif %}" data-view-more-item>
          {% render 'article-card',
            blog: article.blog,
            article: article,
            media_height: section.settings.image_height,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true,
            excerpt_char_limit: section.settings.excerpt_limit,
            section_id: section.id
          %}
        </div>
      {% endfor %}
    </div>

    <div class="custom-articles-view-more" data-view-more-wrapper>
      <button type="button" class="button custom-articles-view-more__btn" data-view-more-btn>
        {{ section.settings.load_more_label }}
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('[data-id="' + sectionId + '"]');
    if (!root) return;

    var wrapper = root.parentElement;
    // root is the grid; wrapper might not contain button. Let's locate within the section:
    var sectionEl = root.closest('section');
    if (!sectionEl) return;

    var btn = sectionEl.querySelector('[data-view-more-btn]');
    var btnWrap = sectionEl.querySelector('[data-view-more-wrapper]');
    if (!btn || !btnWrap) return;

    var step = parseInt(root.getAttribute('data-step'), 10) || 9;

    function updateButtonVisibility() {
      var hidden = root.querySelectorAll('[data-view-more-item].is-hidden');
      if (hidden.length === 0) {
        btnWrap.style.display = 'none';
      } else {
        btnWrap.style.display = '';
      }
    }

    btn.addEventListener('click', function () {
      var hidden = root.querySelectorAll('[data-view-more-item].is-hidden');
      for (var i = 0; i < hidden.length && i < step; i++) {
        hidden[i].classList.remove('is-hidden');
      }
      updateButtonVisibility();
    });

    updateButtonVisibility();
  })();
</script>

{% schema %}
{
  "name": "Combined Blog Feed",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Articles" },
    { "type": "checkbox", "id": "h1", "label": "H1 heading tag", "default": true },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Stay updated with our latest news and stories</p>" },

    {
      "type": "text",
      "id": "blog_handles",
      "label": "Blog handles (comma-separated)",
      "default": "newsletter,podcast,news",
      "info": "Example: newsletter,podcast,news"
    },

    { "type": "range", "id": "margin_top", "min": 1, "max": 100, "step": 1, "label": "Margin from top", "default": 1 },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 3, "step": 1, "label": "Columns (tablet)", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns (mobile)", "default": 1 },

    { "type": "range", "id": "articles_per_page", "min": 1, "max": 30, "step": 1, "label": "Articles shown initially", "default": 9 },

    { "type": "range", "id": "load_more_count", "min": 1, "max": 30, "step": 1, "label": "Load more count per click", "default": 9 },
    { "type": "text", "id": "load_more_label", "label": "Load more button label", "default": "View more" },

    { "type": "range", "id": "excerpt_limit", "min": 20, "max": 500, "step": 10, "label": "Excerpt length", "default": 150 },

    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "default": "small",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false }
  ],
  "presets": [
    { "name": "Combined Blog Feed" }
  ]
}
{% endschema %}
