{% comment %}
  Calculate sizes for image:
    Accepts:
  - width: {String} 'half_width', or 'page_width', or 'full_width'.
  Usage:
    {%- render 'ssky-sizes-attr', width: 'half_width' -%}
    {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
    {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'page_width' -%}{%- endcapture -%}
    {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'full_width' -%}{%- endcapture -%}
{% endcomment %}
{%- if width == 'half_width' -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 990px) calc((100vw - 124px) / 2), (min-width: 750px) calc(100vw - 100px), calc(100vw - 40px)
{%- elsif width == 'page_width' -%}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 100px), calc(100vw - 40px)
{%- elsif width == 'full_width' -%}100vw{%- endif -%}