        "narrow_width": false,
        "text_button_split": false,
        "merging_with_section_below": true,
        "color_scheme_layout_merging": "scheme-4",
        "merging_color": "#ffffff",
        "merge_with_section_above": false,
        "padding_top": 64,
        "padding_bottom": 64,
        "top_left": false,
