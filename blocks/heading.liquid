{%- liquid
  assign visibility_classes = ''
  if block.settings.hide_on_mobile
    assign visibility_classes = visibility_classes | append: ' hide-mobile'
  endif
  if block.settings.hide_on_tablet
    assign visibility_classes = visibility_classes | append: ' hide-tablet'
  endif
  if block.settings.hide_on_desktop
    assign visibility_classes = visibility_classes | append: ' hide-desktop'
  endif
-%}

{%- style -%}
  .tt-heading-{{ block.id }} {
    font-size: {{ block.settings.font_size_mobile }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    text-align: {{ block.settings.alignment }};
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    {%- if block.settings.max_width != 100 -%}
      max-width: {{ block.settings.max_width }}%;
    {%- endif -%}
    {%- if block.settings.color != blank -%}
      color: {{ block.settings.color }};
    {%- endif -%}
  }
  .tt-heading-{{ block.id }} strong {
    {%- if block.settings.highlight_color != blank -%}
      color: {{ block.settings.highlight_color }};
    {%- endif -%}
    font-weight: inherit;
  }
  @media screen and (min-width: 750px) {
    .tt-heading-{{ block.id }} {
      font-size: {{ block.settings.font_size_desktop }}px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

<{{ block.settings.heading_tag }} class="tt-heading-{{ block.id }}{{ visibility_classes }}" {{ block.shopify_attributes }}>
  {{- block.settings.heading -}}
</{{ block.settings.heading_tag }}>

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Hide on tablet",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Talk about your brand",
      "label": "Heading",
      "info": "To highlight text: select words → click Bold → set Highlight color below"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Alignment"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 32
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600",
      "label": "Font weight"
    },
    {
      "type": "select",
      "id": "text_transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none",
      "label": "Text transform"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "info": "Color for bold text (use Bold in editor to highlight)"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2",
      "label": "Heading tag"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Max width",
      "default": 100
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 16
    }
  ],
  "presets": [
    { "name": "Heading" }
  ]
}
{% endschema %}
