                        {% endif %}
                      >
                        <div class="ssky-testimonials__stats-container">
                          <div class="ssky-testimonials__stats-top-row">
                            <div class="ssky-testimonials__stats-item">
                              <div class="ssky-testimonials__stats-title">{{ block.settings.copies_number }}</div>
                              <div class="ssky-testimonials__stats-subtitle">{{ block.settings.copies_text }}</div>
                            </div>
                            
                            <div class="ssky-testimonials__stats-item">
                              <div class="ssky-testimonials__stats-title">{{ block.settings.reviews_number }}</div>
                              <div class="ssky-testimonials__stats-subtitle">{{ block.settings.reviews_text }}</div>
