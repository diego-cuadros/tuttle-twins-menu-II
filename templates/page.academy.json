            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>Values-Aligned Education:</strong> The Academy is specifically designed to align with conservative and libertarian values, making it a trustworthy resource for families who prioritize these principles.</p>",
            "text_large": false
          }
        },
        "text_column_w_icons_Dxw44R": {
          "type": "text_column_w_icons",
          "settings": {
            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>Comprehensive and Unique Content:</strong> The Academy offers exclusive courses that cover critical but often overlooked topics that are not adequately addressed in many traditional curricula.</p>",
            "text_large": false
          }
        },
        "text_column_w_icons_FJ8hbe": {
          "type": "text_column_w_icons",
          "settings": {
            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>Affordable Pricing:</strong> The Academy provides an affordable alternative to other platforms, with a single, low price that offers significant savings compared to purchasing similar courses individually.</p>",
            "text_large": false
          }
        },
        "text_column_w_icons_TKGcqD": {
          "type": "text_column_w_icons",
          "settings": {
            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>One Price for the Whole Family:</strong> You membership covers unlimited access for all the teens in your household, making it a cost-effective choice for families with multiple learners.</p>",
            "text_large": false
          }
        },
        "text_column_w_icons_xVkaGn": {
          "type": "text_column_w_icons",
          "settings": {
            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>Focus on Real-World Skills:</strong> Courses are designed to equip teens with practical skills and knowledge that are essential for success in reallife.</p>",
            "text_large": false
          }
        },
        "text_column_w_icons_BBdAAj": {
          "type": "text_column_w_icons",
          "settings": {
            "color_scheme": "scheme-1",
            "icon_position": "left",
            "heading": "",
            "heading_color": "",
            "icon_type": "fa-face",
            "icon_background_color": "",
            "icon_color": "",
            "text_item": "<p><strong>Trusted Brand:</strong> The Tuttle Twins brand has a strong reputation, giving parents confidence that their teens are receiving education that aligns with their familyʼs values and beliefs.</p>",
            "text_large": false
          }
        }
      },
