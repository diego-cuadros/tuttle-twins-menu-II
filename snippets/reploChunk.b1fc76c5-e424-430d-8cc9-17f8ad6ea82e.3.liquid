a-4720-a8f6-e9e8bd9d26aa/5bd9a441-0b31-4ba3-b1c5-37e8c0cbfa17?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/5bd9a441-0b31-4ba3-b1c5-37e8c0cbfa17?width=96" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/5bd9a441-0b31-4ba3-b1c5-37e8c0cbfa17?width=96" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/5bd9a441-0b31-4ba3-b1c5-37e8c0cbfa17" class="r-x6ljen" loading="lazy"/></picture><div data-rid="e72fde71-8f7f-4855-987b-f3ce0d144a07" class="r-1k4seen"><div data-rid="126b1574-5860-4620-bf73-d7ed84037ee9" class="r-1x22jzm alchemy-rte"><span style="width:100%"><p>Fun to Read</p></span></div><div data-rid="048096f6-5be0-4ad2-946b-c9ca47b1686b" class="r-1almnk7 alchemy-rte"><span style="width:100%"><p>The original book has great lessons, but we explain them in simple language with fun characters and clear examples kids can follow.</p></span></div></div></div><div data-rid="6d9c7ea4-2e5f-4a8e-802c-53a8c937f5af" class="r-1ro8a7a"><picture data-rid="5247bca4-62c8-460f-b70a-827b2a39f768" class="r-qozy17"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/26bef226-2c06-4cf9-8e38-959a76a2d2bb?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/26bef226-2c06-4cf9-8e38-959a76a2d2bb?width=96" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/26bef226-2c06-4cf9-8e38-959a76a2d2bb?width=96" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/26bef226-2c06-4cf9-8e38-959a76a2d2bb" class="r-d2p92b" loading="lazy"/></picture><div data-rid="78cb1331-c155-4269-b84f-d9312783073e" class="r-1ja8hjj"><div data-rid="5886e538-0850-4337-a9bd-6a36228d942a" class="r-5c4bzc alchemy-rte"><span style="width:100%"><p>Designed to Stick</p></span></div><div data-rid="f57655c7-f963-4f3f-ae79-292497907730" class="r-122phh8 alchemy-rte"><span style="width:100%"><p>Instead of long, dense text, Tuttle Twins uses exciting stories that make the lessons stick and feel real in everyday life.</p></span></div></div></div><button data-rid="696281dd-16de-4fd1-8bf4-6a6fc51282ce" tabindex="0" role="link" class="text r-hwrmc5 alchemy-rte"><div data-rid="290cdce6-a09e-4c48-9022-9d61efc40e90" class="r-1ksvcud alchemy-rte"><span style="width:100%"><p>Shop Our Easter Sale Now</p></span></div></button></div></div></div></div></div><div data-rid="ee25b57a-7eb2-435b-b53e-0f623eda3ab3" class="r-1i4doeu"><div data-rid="0a6bc4f3-c029-430d-a3b9-a7cd560d3225" class="r-6zr0c1"><div data-rid="7426d3c9-b139-4994-aa77-37f1f3f7bcd8" class="r-7ie0oy"><div data-rid="2f9ee0a3-d2d8-4283-a667-df6e3843f8c7" class="r-w8oqhh alchemy-rte"><span style="width:100%"><p>Frequently Asked Questions</p></span></div><div data-rid="9bcb4449-cff2-47fd-bfc0-81bac0ad4b57" class="r-12v5j4n" data-orientation="vertical"><div data-rid="eadf1720-46d5-4a98-8a61-dadd43b088d2" class="r-1ugvxju" data-replo-collapsible="true" data-state="open" data-orientation="vertical"><div data-rid="9727a491-a365-41a3-952f-73cf30a1be0a" aria-expanded="true" aria-controls="replo-:R6dr2:" tabindex="0" role="button" class="r-piwumx r-1uljkup"><div data-rid="8a582cce-e57a-43ad-be01-0d316b6e182d" class="r-n27efi alchemy-rte"><span style="width:100%"><p>What are the Tuttle Twins books about?</p></span></div><div data-rid="6fa73931-7d32-48b2-91f1-cd65fe2a5570" class="r-1252ogp" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1biysfn" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"></path></svg></div></div><div class="replo-animated" id="replo-:R6dr2:"><div data-rid="af88c73f-3ca6-4406-9e5d-bbad4bf07009" class="r-kyj1ri"><div data-rid="421ebfe5-1baf-4c6b-b734-8d1628d217a7" class="r-13tlkxh alchemy-rte"><span style="width:100%"><p><span>The Tuttle Twins books teach kids about timeless principles—like freedom, critical thinking, and personal responsibility—through engaging, age-appropriate stories. Instead of memorizing facts, children discover these ideas by following fun adventures, relatable characters, and real-world examples.</span></p></span></div></div></div></div><div data-rid="af1cf728-2aee-45b3-b0ef-f17d81e36747" class="r-pvihdm" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="ced9f5f8-e18d-45c6-b434-c6d360d68bde" aria-expanded="false" aria-controls="replo-:Radr2:" tabindex="0" role="button" class="r-f74pwr"><div data-rid="acbd2620-a29e-4593-bb94-534b7257d891" class="r-1n29tty alchemy-rte"><span style="width:100%"><p>What ages are the books for?</p></span></div><div data-rid="6d4463a3-d5c2-4af3-96c7-373703a3d61a" class="r-1y5875w" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1umz6zh" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Radr2:"><div data-rid="5a173257-5c0b-4a53-a5fe-ccc152be1948" class="r-1b5v82j"><div data-rid="9f67f474-b66f-49b8-bd6a-5533be78ac5d" class="r-kvthoc alchemy-rte"><span style="width:100%"><p>We have books for every stage of your child’s development:</p><p><strong>Ages 0–4:</strong> Board books with colorful illustrations and simple ideas.</p><p><strong>Ages 5–7:</strong> Picture books with short, engaging stories.</p><p><strong>Ages 8–12:</strong> Chapter books that explore deeper concepts.</p><p><strong>Ages 13+:</strong> Teen and young adult books with more advanced discussions.</p></span></div></div></div></div><div data-rid="1282d1c4-2ffd-4c1c-8624-462e8d3bdcf3" class="r-1h7t387" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="3eeda576-8b20-4e6b-9a0d-c5334b11c214" aria-expanded="false" aria-controls="replo-:Redr2:" tabindex="0" role="button" class="r-e9qnsj"><div data-rid="b7bd435f-0713-4a6a-b9f3-3c89b2a24756" class="r-3jgl6i alchemy-rte"><span style="width:100%"><p>Do my kids need any prior knowledge to understand these books?</p></span></div><div data-rid="df86d00a-1f17-4ff8-9dc6-cae49deb4f9a" class="r-1nafh10" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-la0bqc" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Redr2:"><div data-rid="ecd6f7ba-ede6-4e00-ba10-85b94b4fa49b" class="r-1b34pdj"><div data-rid="71dcec34-bff6-49a7-a090-25b436e4094b" class="r-1jp7sjt alchemy-rte"><span style="width:100%"><p><span>Not at all! Each story starts from scratch, making it easy for any child to understand—whether they’ve heard of these ideas before or not. The books are written to make learning feel like play, so kids naturally remember what they’ve learned.</span></p></span></div></div></div></div><div data-rid="06f321f8-299c-43dc-9ea5-0ebd3295b803" class="r-6x6626" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="e8c71224-c3e1-49ca-a0a7-997c0718f99b" aria-expanded="false" aria-controls="replo-:Ridr2:" tabindex="0" role="button" class="r-jlyczi"><div data-rid="f09e160f-e7bb-415b-9b08-1efb3d704e6b" class="r-1pkaiyw alchemy-rte"><span style="width:100%"><p>How do these books compare to school textbooks?</p></span></div><div data-rid="5025933f-c567-4142-9756-76cd63c18ec6" class="r-lxtdcl" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-iqy6dc" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Ridr2:"><div data-rid="f9699c28-018e-407d-b796-fabde168f8b4" class="r-yu6x25"><div data-rid="13b4f24f-b07b-40c0-a02c-909bdf909572" class="r-1p6ckfl alchemy-rte"><span style="width:100%"><p><span>Unlike most textbooks, the Tuttle Twins use storytelling to make learning effortless and memorable. Research shows kids recall and understand more when lessons are woven into an engaging story rather than presented as dry facts.</span></p></span></div></div></div></div><div data-rid="ac10eece-3732-4dfd-9293-c2eb20ac2764" class="r-11opoz9" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="d1456b86-cc91-4b6d-8c41-d54d27137642" aria-expanded="false" aria-controls="replo-:Rmdr2:" tabindex="0" role="button" class="r-hz92c5"><div data-rid="83106990-ce88-45f9-8ed3-84233a5eaac0" class="r-238e2d alchemy-rte"><span style="width:100%"><p>Where should I start if I’m new?</p></span></div><div data-rid="4154d34c-7f94-466d-8b69-3237da16275f" class="r-tfg2xk" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1lxg8v7" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rmdr2:"><div data-rid="7de968ab-3aec-4605-b696-a2a7bbd62dd5" class="r-okf3m0"><div data-rid="bf8fa537-2f80-48f0-8b64-286b9b7d59da" class="r-7xl53v alchemy-rte"><span style="width:100%"><p>Start with the set that matches your child’s age:<br><strong>Ages 0–4:</strong> Begin with the Tuttle Toddlers Combo Set — colorful board books that introduce big ideas in a fun, simple way.<br><strong>Ages 5–12: </strong>Go for the Family Starter Pack — a mix of storybooks that spark curiosity and help kids apply important principles.<br><strong>Ages 13+:</strong> Jump into the Teen & Beyond Bundle — thought-provoking reads that challenge older kids to think critically and engage with the world around them.</p></span></div></div></div></div></div></div><picture data-rid="aa645483-0752-4846-a2b8-397cde14b2bb" class="r-50paf1"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/43bcafdd-cd2d-4508-8bbb-eb1608634b8f?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/43bcafdd-cd2d-4508-8bbb-eb1608634b8f?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/43bcafdd-cd2d-4508-8bbb-eb1608634b8f?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/43bcafdd-cd2d-4508-8bbb-eb1608634b8f" class="r-1ewiy0v" loading="lazy"/></picture></div></div></div></div><style>@import url(https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900;950)</style></div>
