        "custom_liquid_KEQTRj": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  PDP-lookalike Quantity + ATC, but ATC goes to Rebuy SmartLink.\n  - Syncs with the REAL PDP quantity input\n  - Updates variants[...][quantity] params in your SmartLink\n{%- endcomment -%}\n\n{%- assign smartlink_url = 'https://www.tuttletwins.com/apps/rebuy/cart?variants%5B45740771606666%5D%5Bquantity%5D=1&variants%5B45740771606666%5D%5Bselling_plan%5D=1717960842&variants%5B45740770558090%5D%5Bproperties%5D%5B_source%5D=Rebuy&variants%5B45740770558090%5D%5Bproperties%5D%5B_widget_id%5D=219991&variants%5B45740770558090%5D%5Bproperties%5D%5B_attribution%5D=Rebuy%20Gift%20with%20Purchase&variants%5B45740770558090%5D%5Bquantity%5D=1&variants%5B47258673217674%5D%5Bproperties%5D%5B_source%5D=Rebuy&variants%5B47258673217674%5D%5Bproperties%5D%5B_attribution%5D=Rebuy%20Tiered%20Progress%20Bar&variants%5B47258673217674%5D%5Bproperties%5D%5B_tier%5D=780fd11a-5eb4-47f3-86c9-677695099d01&variants%5B47258673217674%5D%5Bquantity%5D=1&variants%5B47496995504266%5D%5Bquantity%5D=1&clear_cart=no&landing_page=shopify_checkout&smart_cart_show=no' -%}\n\n<div class=\"ssky-product-qty-atc-con ssky-rebuy-smartlink-atc\">\n  <div class=\"ssky-product-qty-con\">\n    <div class=\"product-form__input product-form__quantity\">\n      <div class=\"price-per-item__container\">\n        <quantity-input class=\"quantity\">\n          <button class=\"quantity__button disabled\" name=\"minus\" type=\"button\" data-qty-minus>\n            <span class=\"visually-hidden\">Decrease quantity</span>\n            <span class=\"svg-wrapper\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" class=\"icon icon-minus\" viewBox=\"0 0 10 2\">\n                <path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M.5 1C.5.7.7.5 1 .5h8a.5.5 0 1 1 0 1H1A.5.5 0 0 1 .5 1\" clip-rule=\"evenodd\"></path>\n              </svg>\n            </span>\n          </button>\n\n          <input\n            class=\"quantity__input\"\n            type=\"number\"\n            name=\"quantity\"\n            min=\"1\"\n            step=\"1\"\n            value=\"1\"\n            inputmode=\"numeric\"\n            pattern=\"[0-9]*\"\n            data-qty-input\n          >\n\n          <button class=\"quantity__button\" name=\"plus\" type=\"button\" data-qty-plus>\n            <span class=\"visually-hidden\">Increase quantity</span>\n            <span class=\"svg-wrapper\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" class=\"icon icon-plus\" viewBox=\"0 0 10 10\">\n                <path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M1 4.51a.5.5 0 0 0 0 1h3.5l.01 3.5a.5.5 0 0 0 1-.01V5.5l3.5-.01a.5.5 0 0 0-.01-1H5.5L5.49.99a.5.5 0 0 0-1 .01v3.5l-3.5.01z\" clip-rule=\"evenodd\"></path>\n              </svg>\n            </span>\n          </button>\n        </quantity-input>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ssky-product-atc-con\">\n    <div class=\"buy-buttons--wrapper\">\n      <a\n        href=\"{{ smartlink_url }}\"\n        class=\"product-form__submit button button--full-width button--primary confetti-bound\"\n        data-smartlink-button\n        style=\"text-decoration:none;\"\n        aria-label=\"Add to cart\"\n      >\n        <span>Add to cart</span>\n\n        <div class=\"loading__spinner hidden\" data-smartlink-spinner>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"spinner\" viewBox=\"0 0 66 66\">\n            <circle stroke-width=\"6\" cx=\"33\" cy=\"33\" r=\"30\" fill=\"none\" class=\"path\"></circle>\n          </svg>\n        </div>\n      </a>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    const root = document.currentScript.closest('.ssky-rebuy-smartlink-atc');\n    if (!root) return;\n\n    // Your SmartLink contains these two variants (encoded in the URL already)\n    const VARIANT_IDS_TO_UPDATE = ['45740771606666', '47480469454986'];\n\n    // Custom Liquid controls\n    const cloneInput = root.querySelector('[data-qty-input]');\n    const minus = root.querySelector('[data-qty-minus]');\n    const plus  = root.querySelector('[data-qty-plus]');\n    const btn   = root.querySelector('[data-smartlink-button]');\n    const spinner = root.querySelector('[data-smartlink-spinner]');\n\n    // PDP (real) quantity input on the page\n    const pdpInput = document.querySelector('form[action^=\"/cart/add\"] .quantity__input[name=\"quantity\"]');\n\n    const clampQty = (val) => {\n      const n = parseInt(val, 10);\n      return Number.isFinite(n) && n > 0 ? n : 1;\n    };\n\n    const setMinusDisabled = (qty) => {\n      if (!minus) return;\n      if (qty <= 1) minus.classList.add('disabled');\n      else minus.classList.remove('disabled');\n    };\n\n    const updateSmartLinkQuantities = (qty) => {\n      const currentHref = btn.getAttribute('href');\n      const url = new URL(currentHref, window.location.origin);\n\n      // Rebuy uses params like variants[ID][quantity]\n      VARIANT_IDS_TO_UPDATE.forEach((id) => {\n        url.searchParams.set(`variants[${id}][quantity]`, String(qty));\n      });\n\n      btn.setAttribute('href', url.toString());\n    };\n\n    const syncAllFromQty = (qty, source) => {\n      qty = clampQty(qty);\n\n      // Update both inputs (if present)\n      if (cloneInput && cloneInput.value !== String(qty)) cloneInput.value = qty;\n\n      // IMPORTANT: keep PDP quantity in sync too\n      // Some themes listen to input/change events, so dispatch them.\n      if (pdpInput && pdpInput.value !== String(qty) && source !== 'pdp') {\n        pdpInput.value = qty;\n        pdpInput.dispatchEvent(new Event('input', { bubbles: true }));\n        pdpInput.dispatchEvent(new Event('change', { bubbles: true }));\n      }\n\n      setMinusDisabled(qty);\n      updateSmartLinkQuantities(qty);\n    };\n\n    // Init quantity from PDP if it exists, otherwise from clone\n    const initialQty = pdpInput ? clampQty(pdpInput.value) : clampQty(cloneInput?.value || 1);\n    syncAllFromQty(initialQty);\n\n    // Listen to CUSTOM qty buttons/input\n    minus?.addEventListener('click', () => syncAllFromQty(clampQty(cloneInput.value) - 1));\n    plus?.addEventListener('click',  () => syncAllFromQty(clampQty(cloneInput.value) + 1));\n    cloneInput?.addEventListener('input', () => syncAllFromQty(cloneInput.value));\n    cloneInput?.addEventListener('change', () => syncAllFromQty(cloneInput.value));\n\n    // Listen to PDP qty changes and update clone + SmartLink\n    if (pdpInput) {\n      pdpInput.addEventListener('input',  () => syncAllFromQty(pdpInput.value, 'pdp'));\n      pdpInput.addEventListener('change', () => syncAllFromQty(pdpInput.value, 'pdp'));\n    }\n\n    // Optional spinner parity\n    btn?.addEventListener('click', () => spinner?.classList.remove('hidden'));\n  })();\n</script>"
          }
