      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hero heading" },
        { "type": "select", "id": "heading_size", "label": "Size", "default": "h1",
          "options": [
            { "value": "h4", "label": "H4" }, { "value": "h3", "label": "H3" },
