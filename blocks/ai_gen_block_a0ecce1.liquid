{% doc %}
  @prompt
    I need a slider carousel. It will have an input for a square picture, title underneath, and a blurb about the book. You should be able to swipe through with the buttons on the side of the carousel. Mobile view should have the buttons on the bottom and only show a single slide per viewport. It should have at least 12 slots, but room to grow. Ideally, it will rotate all the way through and go from the 12th to the 1st., The buttons look cut off and also don't display on mobile.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-book-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 60px;
  }

  .ai-book-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  .ai-book-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;will-change: transform;
  }

  .ai-book-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    margin: 0 10px;
    padding: 20px;
    background-color: {{ block.settings.slide_background_color }};
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-book-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 16px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-book-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-book-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;}

  .ai-book-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-book-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-book-carousel__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-book-carousel__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-book-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-50%) scale(1.1);
  }

  .ai-book-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: translateY(-50%) scale(1);
  }

  .ai-book-carousel__nav-button--prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-book-carousel__nav-button--next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-book-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-book-carousel__dots-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-book-carousel__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-book-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-book-carousel__mobile-nav-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }

  .ai-book-carousel__mobile-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
  }

  .ai-book-carousel__mobile-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: scale(1.1);
  }

  .ai-book-carousel__mobile-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 768px) {
    .ai-book-carousel-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-book-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
      margin: 0;
    }

    .ai-book-carousel__nav-button-{{ ai_gen_id }} {
      display: none;
    }

    .ai-book-carousel__dots-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-book-carousel__mobile-nav-{{ ai_gen_id }} {
      display: flex;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .ai-book-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 20px);
    }
  }
{% endstyle %}<book-carousel-{{ ai_gen_id }}
  class="ai-book-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-book-carousel__container-{{ ai_gen_id }}">
    <div class="ai-book-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'book_' | append: i | append: '_image'
          assign title_key = 'book_' | append: i | append: '_title'
          assign description_key = 'book_' | append: i | append: '_description'
          assign show_key = 'book_' | append: i | append: '_show'

          assign book_image = block.settings[image_key]
          assign book_title = block.settings[title_key]
          assign book_description = block.settings[description_key]
          assign show_book = block.settings[show_key]
        %}

        {% if show_book %}
          <div class="ai-book-carousel__slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
            <div class="ai-book-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if book_image %}
                <img
                  src="{{ book_image | image_url: width: 400}}"
                  alt="{{ book_image.alt | escape }}"
                  class="ai-book-carousel__image-{{ ai_gen_id }}"
                loading="lazy"width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-book-carousel__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if book_title != blank %}
              <h3 class="ai-book-carousel__title-{{ ai_gen_id }}">{{ book_title }}</h3>
            {% endif %}
            {% if book_description != blank %}
              <div class="ai-book-carousel__description-{{ ai_gen_id }}">{{ book_description }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button
      class="ai-book-carousel__nav-button-{{ ai_gen_id }} ai-book-carousel__nav-button--prev-{{ ai_gen_id }}"
      aria-label="Previous slide"
      data-direction="prev">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <button
      class="ai-book-carousel__nav-button-{{ ai_gen_id }} ai-book-carousel__nav-button--next-{{ ai_gen_id }}"
      aria-label="Next slide"
      data-direction="next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button></div>

  <div class="ai-book-carousel__dots-{{ ai_gen_id }}"></div>

  <div class="ai-book-carousel__mobile-nav-{{ ai_gen_id }}">
    <button
      class="ai-book-carousel__mobile-nav-button-{{ ai_gen_id }}"
      aria-label="Previous slide"
      data-direction="prev">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </button>

    <button
      class="ai-book-carousel__mobile-nav-button-{{ ai_gen_id }}"
      aria-label="Next slide"
      data-direction="next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </button>
  </div>
</book-carousel-{{ ai_gen_id }}><script>
  (function() {
    class BookCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slidesPerView = 3;
        this.isTransitioning = false;}

      connectedCallback() {
        this.track = this.querySelector('.ai-book-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-book-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-book-carousel__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-book-carousel__nav-button--next-{{ ai_gen_id }}');
        this.mobilePrevButton = this.querySelector('.ai-book-carousel__mobile-nav-button-{{ ai_gen_id }}[data-direction="prev"]');
        this.mobileNextButton = this.querySelector('.ai-book-carousel__mobile-nav-button-{{ ai_gen_id }}[data-direction="next"]');
        this.dotsContainer = this.querySelector('.ai-book-carousel__dots-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.setupResponsive();
        this.setupEventListeners();
        this.createDots();
        this.updateCarousel();

        window.addEventListener('resize', () => this.setupResponsive());
      }

      setupResponsive() {
        if (window.innerWidth <= 768) {
          this.slidesPerView = 1;} else if (window.innerWidth <= 1024) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 3;
        }
        this.updateCarousel();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        this.nextButton.addEventListener('click', () => this.goToNextSlide());
        this.mobilePrevButton.addEventListener('click', () => this.goToPrevSlide());
        this.mobileNextButton.addEventListener('click', () => this.goToNextSlide());

        let startX = 0;
        let endX = 0;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;
          const diff = startX - endX;

          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.goToNextSlide();
            } else {
              this.goToPrevSlide();
            }
          }
        });
      }

      createDots() {
        if (window.innerWidth > 768) return;

        this.dotsContainer.innerHTML = '';
        const totalDots = this.slides.length;

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-book-carousel__dot-{{ ai_gen_id }}';
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      goToPrevSlide() {
        if (this.isTransitioning) return;
        this.currentSlide = this.currentSlide === 0 ? this.slides.length - 1 : this.currentSlide - 1;
        this.updateCarousel();
      }

      goToNextSlide() {
        if (this.isTransitioning) return;
        this.currentSlide = this.currentSlide === this.slides.length - 1 ? 0 : this.currentSlide + 1;
        this.updateCarousel();
      }

      goToSlide(index) {
        if (this.isTransitioning) return;
        this.currentSlide = index;
        this.updateCarousel();
      }

      updateCarousel() {
        if (!this.track || this.slides.length === 0) return;

        this.isTransitioning = true;

        let translateX;
        if (window.innerWidth <= 768) {
          translateX = -this.currentSlide *100;
        } else {
          const slideWidth = 100 / this.slidesPerView;
          translateX = -this.currentSlide * slideWidth;
        }

        this.track.style.transform = `translateX(${translateX}%)`;

        this.updateDots();

        setTimeout(() => {
          this.isTransitioning = false;
        }, 300);
      }

      updateDots() {
        const dots = this.querySelectorAll('.ai-book-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }
    }

    customElements.define('book-carousel-{{ ai_gen_id }}', BookCarousel{{ ai_gen_id }});
  })();
</script>

