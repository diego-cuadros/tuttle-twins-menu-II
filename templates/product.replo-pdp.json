            "before_image": "shopify://shop_images/e67775d0-f748-43be-a24b-0ec62a2bfeb5.avif",
            "after_image": "shopify://shop_images/ab3bcc6e-b1b5-4268-bf25-00505296efea.avif",
            "title": "Education Vacation",
            "description": "<p>Based on <em>The Underground History of American Education by John Taylor Gatto.</em></p>",
            "recommended_ages": "5-12",
            "popup_title": "The Tuttle Twins Learn About Government GrowthThe Tuttle Twins Learn Why School Choice Matters",
            "popup_description": "<ul><li>Introduces kids to different approaches to education, including school choice and incentives.</li><li>Follows Ethan and Emily as they explore why some schools succeed—and why others struggle.</li><li>Encourages critical thinking about education systems, accountability, and what helps students thrive.</li></ul>"
          }
        },
        "block_gb8Bne": {
          "type": "block",
          "settings": {
            "before_image": "shopify://shop_images/1738aad8-6b92-4cc4-b425-e20c23fbc67f.avif",
