            "image_fit": false,
            "caption": "",
            "text_style": "large-bold",
            "heading": "<p>Won the Think Tank Shark Tank</p>",
            "heading_size": "h2",
            "heading_weight": "bold",
            "caption_b": "",
            "text_style_b": "large-bold",
            "text": "<p>Connor presented our new economic curriculum at a competition and won the top prize!<br/><br/>There was great excitement from this community of freedom fighters for the project, and the judges selected our project as the winner.</p>",
            "text_size": "medium",
            "text_weight": "regular",
            "text_b": "",
            "text_size_b": "regular",
