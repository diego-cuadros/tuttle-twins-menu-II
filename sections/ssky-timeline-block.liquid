    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "blocks": [
    {
      "type": "section_header",
      "name": "Section Header",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Main Heading"
        },
        {
          "type": "richtext",
          "id": "section_heading",
