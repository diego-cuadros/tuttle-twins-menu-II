{%- liquid
  assign column_with_border = false
  assign column_with_border_padding = false
  assign column_with_border_vtwo = false
  if section.settings.column_with_border == true
    assign column_with_border = true
    if section.settings.column_with_border_padding == true
      assign column_with_border_padding = true
    endif
    if section.settings.column_with_border_vtwo == true
      assign column_with_border_vtwo = true
    endif
  endif
-%}
{%- style -%}
  .ssky-text-column-{{ section.id }} .ssky-text-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  .ssky-text-column-{{ section.id }} .button-link {
    background: transparent;
    border: transparent;
    color: #da5846;
    text-decoration: underline;
    font-size: 1.6rem;
    font-weight: 600;
    width: 100%;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="ssky-text-column-{{ section.id }}">
  <div class="ssky-text-column gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width{%- if column_with_border %} ssky-text-column__layout-border{%- if column_with_border_padding %} ssky-text-column__layout-border-padding{%- endif -%}{%- if column_with_border_vtwo %} ssky-text-column__layout-border-v2{%- endif -%}{%- endif -%}">
      <div class="ssky-text-column__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
        {%- if section.settings.heading != blank -%}
          {%- assign heading_length = section.settings.heading | size -%}
          <h2
            class="ssky-text-block__heading rte {{ section.settings.heading_size }} weight-{{ section.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 1"
            {% endif %}
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {% case block.type %}
            {%- when 'text_column' -%}
              {%- assign text_column_block = true -%}
            {%- when 'text_column_w_image' -%}
              {%- assign text_column_w_image_block = true -%}
            {%- when 'text_column_w_icons' -%}
              {%- assign text_column_w_icons_block = true -%}
            {%- when 'caption' -%}
              {%- assign header_block = true -%}
            {%- when 'heading' -%}
              {%- assign header_block = true -%}
            {%- when 'text' -%}
              {%- assign header_block = true -%}
            {%- when 'checkbox' -%}
              {%- assign checkbox_block = true -%}
            {%- when 'button' -%}
              {%- assign button_block = true -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if header_block == true -%}
          <div class="ssky-text-column__block-set--header ssky-text-block__blocks {{ section.settings.content_alignment }}">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'caption' -%}
                  <div
                    class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.caption | escape }}
                  </div>
                {%- when 'heading' -%}
                  {%- assign heading_length = block.settings.heading | size -%}
                  <h2
                    class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.heading }}
                  </h2>

                {%- when 'text' -%}
                  <div
                    class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div class="rte" style="max-width:{{ block.settings.max_width }}rem;">
                      {{ block.settings.text }}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if text_column_block == true -%}
          <div class="ssky-text-column__block-set--top">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'text_column' -%}
                  <div
                    class="ssky-text-column__block gradient color-{{ block.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div>
                      <h4 class="ssky-text-column__heading rte h5{%- if column_with_border %} h6{%- unless column_with_border_vtwo %} primary-blue{%- endunless -%}{%- endif -%}">
                        {{ block.settings.heading }}
                      </h4>
                      <div class="ssky-text-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {{ block.settings.text }}
                      </div>
                    </div>
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="ssky-text-column__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if text_column_w_image_block == true -%}
          <div class="ssky-text-column__block-set--top left">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'text_column_w_image' -%}
                  <div
                    class="ssky-text-column__block ssky-text-column__block--w--image gradient color-{{ block.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div>
                      <h4 class="ssky-text-column__heading rte h5{%- if column_with_border %} h6{%- unless column_with_border_vtwo %} primary-blue{%- endunless -%}{%- endif -%}">
                        {{ block.settings.heading }}
                      </h4>
                      <div class="ssky-text-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {{ block.settings.text }}
                      </div>
                    </div>
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="ssky-text-column__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      <div class="ssky-text-column__image">
                        <img src="{{ block.settings.image | image_url: width: 240 }}">
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        
        {%- if text_column_w_icons_block == true -%}
          <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
          
          <style>
            .ssky-text-column-{{ section.id }} .ssky-text-column__block--w--icons {
              display: flex;
              flex-direction: column;
            }
            
            .ssky-text-column-{{ section.id }} .ssky-text-column__icons-grid {
              display: grid;
              grid-template-columns: 1fr;
              gap: 20px;
            }
            
            @media screen and (min-width: 750px) {
              .ssky-text-column-{{ section.id }} .ssky-text-column__icons-grid {
                grid-template-columns: repeat(3, 1fr);
              }
            }
            
            .ssky-text-column-{{ section.id }} .ssky-text-column__block--w--icons-text {
              display: flex;
              align-items: flex-start;
              margin-bottom: 15px;
            }
            
            .ssky-text-column-{{ section.id }} .ssky-text-column__block--w--icons-icon {
              flex-shrink: 0;
              display: flex;
              align-items: center;
              justify-content: center;
              margin: 2rem auto;
            }
            
            .ssky-text-column-{{ section.id }} .ssky-text-column__block--w--icons-icon i {
              font-size: 2.5rem;
              padding: 1.5rem;
              border-radius: 5px;
            }
            
            .ssky-text-column-{{ section.id }} .ssky-text-column__block--text-content {
              flex: 1;
              min-width: 0; 
              word-break: break-word; 
              overflow-wrap: break-word;
              text-align: center;
            }
            
            .ssky-text-column-{{ section.id }} i.fa {
              min-width: 55px;
              text-align: center;
            }
            
            .ssky-text-column-{{ section.id }} .text-body-large {
              font-size: 1.125rem;
              line-height: 1.5;
            }
          </style>
          
          <div class="ssky-text-column__block-set--top left">
            <div class="ssky-text-column__icons-grid">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'text_column_w_icons' -%}
                    <div
                      class="ssky-text-column__block ssky-text-column__block--w--icons gradient color-{{ block.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {{ block.shopify_attributes }}
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      <div class="ssky-text-block__blocks">
                        {%- if block.settings.icon_type != 'none' -%}
                          <span class="ssky-text-column__block--w--icons-icon">
                            <i class="fa {{ block.settings.icon_type }}" aria-hidden="true" 
                            style="background: {{ block.settings.icon_background_color }}; color: {{ block.settings.icon_color }};"></i>
                          </span>
                        {%- endif -%}
                        <h4 class="ssky-text-column__heading rte h5 {{ section.settings.content_alignment }}" 
                            {% if block.settings.heading_color != blank %}
                              style="color: {{ block.settings.heading_color }};"
                            {% endif %}
                        >
                          {{ block.settings.heading }}
                        </h4>
                        {%- if block.settings.text_item != blank -%}
                          <div
                            class="ssky-text-column__block--w--icons-text{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                            {% if settings.animations_reveal_on_scroll %}
                              data-cascade
                              style="--animation-order: {{ forloop.index }};"
                            {% endif %}
                          >
                            <div class="rte ssky-text-column__block--text-content">
                              {{ block.settings.text_item }}
                            </div>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if checkbox_block == true -%}
          <div class="ssky-text-column__block-set--bottom ssky-text-block__checkbox-con">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'checkbox' -%}
                  <div
                    class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    <div class="rte">
                      {{ block.settings.text }}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div
            class="ssky-text-block__buttons{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 4;"
            {% endif %}
          >
            {%- if section.settings.button_label != blank -%}
              <a
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="button button--large{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if button_block == true -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text_above_button'-%}
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  <div class="rte" style="max-width:{{ block.settings.max_width }}rem;">
                    {{ block.settings.text }}
                  </div>
                </div>
              {%- when 'button' -%}
                {%- if block.settings.product != blank -%}
                  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  {%- if block.settings.show_price -%}
                    <div class="ssky-text-block__price">
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                <div
                  class="ssky-text-block__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} ssky-text-block__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%- if block.settings.product != blank -%}
                    {%- render 'buy-buttons',
                      block: block,
                      product: block_product,
                      product_form_id: product_form_id,
                      section_id: section.id,
                      is_button_large: block.settings.button_large,
                      is_button_full: block.settings.button_full,
                      is_button_link: block.settings.button_outlink,
                      button_label: block.settings.product_button_label
                    -%}
                  {%- else -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        {% if block.settings.button_outlink %}
                          class="button-link"
                        {% else %}
                          class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        {% endif %}
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_2 }}"
                        {% endif %}
                        {% if block.settings.button_outlink %}
                          class="button-link"
                        {% else %}
                          class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                        {% endif %}
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if block.settings.text_below_buttons != blank -%}
                  <div class="ssky-text-block__text-below-buttons rte">{{ block.settings.text_below_buttons }}</div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TT Text column",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "t:sections.ssky_text_block.blocks.heading.settings.heading.default",
      "label": "t:sections.ssky_text_block.blocks.heading.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__0.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "options": [
        {
          "value": "medium",
          "label": "t:sections.all.heading_weight.options__1.label"
        },
        {
          "value": "semibold",
          "label": "t:sections.all.heading_weight.options__2.label"
        },
        {
          "value": "bold",
          "label": "t:sections.all.heading_weight.options__3.label"
        }
      ],
      "default": "bold",
      "label": "t:sections.all.heading_weight.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.ssky_text_block.blocks.button.settings.button_label.label",
      "info": "t:sections.ssky_text_block.blocks.button.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.ssky_text_block.blocks.button.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "t:sections.ssky_text_block.blocks.button.settings.button_style_secondary.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.border"
    },
    {
      "type": "checkbox",
      "id": "column_with_border",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "column_with_border_padding",
      "label": "t:sections.all.ssky_layouts.extension.borderpadding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "column_with_border_vtwo",
      "label": "t:sections.all.ssky_layouts.extension.bordervtwo",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
