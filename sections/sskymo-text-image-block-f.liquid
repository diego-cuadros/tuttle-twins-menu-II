{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign narrow_width = false
  if section.settings.narrow_width == true
    assign narrow_width = true
  endif
-%}
{%- style -%}
  .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-image-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__section-header {
      margin-bottom: 2rem;
    }
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-text-image-block-{{ section.id }}">
  <div class="ssky-text-image-block content-container color-{{ section.settings.color_scheme }} gradient">
    {%- for graphic_novels in shop.metaobjects.graphic_novels.values limit: 1 -%}
      <div class="ssky-text-image-block__wrapper {{ section.settings.image_position }} page-width">
        <div class="ssky-text-image-block__image">
          <div
            class="{%- if graphic_novels.image != blank %}media{%- else %}placeholder{%- endif -%}{%- if graphic_novels.image_fill_or_fit != false %} image-fit{%- endif -%}"
            style="padding-bottom:{%- if narrow_width -%}{{ 1 | divided_by: graphic_novels.image.value.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- else -%}{{ 1 | divided_by: graphic_novels.image.value.image.aspect_ratio | times: 100 | at_most: 100 }}%;{%- endif -%}"
          >
            {%- if graphic_novels.image != blank -%}
              {%- assign widths = '360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
              {{
                graphic_novels.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="ssky-text-image-block__blocks ssky-text-block__blocks left">
          {%- assign heading_length = graphic_novels.heading | metafield_text | size -%}
          <h2
            class="ssky-text-block__heading rte h4 weight-bold{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 1;"
            {% endif %}
          >
            {{ graphic_novels.heading }}
          </h2>

          <div
            class="ssky-text-block__text rte text-medium{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 2;"
            {% endif %}
          >
            {{ graphic_novels.description | metafield_tag }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "TTm Graphic novels",
  "tag": "section",
  "class": "section sskymo-text-image-block-f",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "image-left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "image-right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "image-right",
      "label": "Image position"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.narrow"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Graphic novels"
    }
  ]
}
{% endschema %}
