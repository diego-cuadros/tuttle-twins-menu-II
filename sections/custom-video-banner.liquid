{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'custom-video-banner.css' | asset_url | stylesheet_tag }}
{{ 'custom-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {{ section.settings.overlay_title_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .video-section__overlay-title {
    color: {{ section.settings.overlay_title_color }};
    font-family: {{ section.settings.overlay_title_font.family }}, {{ section.settings.overlay_title_font.fallback_families }};
    font-weight: {{ section.settings.overlay_title_font.weight }};
    font-style: {{ section.settings.overlay_title_font.style }};
  }

  .section-{{ section.id }}-padding .video-section__overlay-small-text {
    color: {{ section.settings.overlay_small_text_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign video_alt = section.settings.video.alt | default: section.settings.description
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape
  assign poster = section.settings.video.preview_image | default: section.settings.cover_image
  assign autoplay_param = ''
  if section.settings.enable_autoplay
    assign autoplay_param = '&autoplay=1'
  endif

  if section.settings.video != null
    assign ratio_diff = section.settings.video.aspect_ratio | minus: poster.aspect_ratio | abs
    if ratio_diff < 0.01 and ratio_diff > 0
      assign fix_ratio = true
    endif
  endif
-%}

{%- capture sizes -%}
  {% if section.settings.full_width -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="video-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding"
  >
    <div
      {% if section.settings.full_width %}
        class="page-width"
      {% endif %}
    >
      {%- unless section.settings.heading == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </div>
      {%- endunless -%}
    </div>
    <div class="dc_content-for_mobile">
      <p class="video-section__overlay-badge">{{ section.settings.overlay_badge_text }}</p>

      <h3 class="video-section__overlay-title">{{ section.settings.overlay_title }}</h3>

      {%- if section.settings.overlay_button_label != blank and section.settings.overlay_button_link != blank -%}
        <button
          class="video-section__overlay-button button button--primary"
          href="{{ section.settings.overlay_button_link }}"
        >
          {{ section.settings.overlay_button_label }}
        </button>
      {%- endif -%}

      <p class="video-section__overlay-small-text">
        {%- if section.settings.show_stars -%}
          <span class="video-section__stars">
            {%- for i in (1..section.settings.star_count) -%}
              {%- render 'icon-star' -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        {{ section.settings.overlay_small_text }}
      </p>
    </div>
    <deferred-media
      class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      data-media-id="{{ video_id }}"
      data-enable-autoplay="{{ section.settings.enable_autoplay }}"
      {% if poster != null %}
        style="--ratio-percent: {{ 1 | divided_by: poster.aspect_ratio | times: 100 }}%;"
      {% endif %}
    >
      <button
        id="Deferred-Poster-Modal-{{ video_id }}"
        class="video-section__poster media deferred-media__poster media--landscape"
        type="button"
        aria-label="{{ alt }}"
      >
        {%- if poster != null -%}
          {{
            poster
            | image_url: width: 3840
            | image_tag: sizes: sizes, widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840', alt: alt
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
        <span class="deferred-media__poster-button motion-reduce">
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>

      <div class="video-section__solid-overlay" aria-hidden="true"></div>

      <div class="video-section__overlay-card dc_content-for-desktop">
        <p class="video-section__overlay-badge">{{ section.settings.overlay_badge_text }}</p>

        <h3 class="video-section__overlay-title">{{ section.settings.overlay_title }}</h3>
        <div class="video-section__overlay-title-background">
          {%- if section.settings.overlay_button_label != blank and section.settings.overlay_button_link != blank -%}
            <button
              class="video-section__overlay-button button button--primary"
              href="{{ section.settings.overlay_button_link }}"
            >
              {{ section.settings.overlay_button_label }}
            </button>
          {%- endif -%}

          <p class="video-section__overlay-small-text">
            {%- if section.settings.show_stars -%}
              <span class="video-section__stars">
                {%- for i in (1..section.settings.star_count) -%}
                  {%- render 'icon-star' -%}
                {%- endfor -%}
              </span>
            {%- endif -%}
            {{ section.settings.overlay_small_text }}
          </p>
        </div>
      </div>

      <template>
        {%- if section.settings.video == null and section.settings.video_url != null -%}
          {%- liquid
            assign loop = ''
            if section.settings.enable_video_looping
              assign loop = '&loop=1&playlist=' | append: video_id
            endif
          -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1{{ autoplay_param }}{{ loop }}{% unless section.settings.show_video_controls %}&controls=0{% endunless %}"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | escape }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}?{{ autoplay_param }}{{ loop }}{% unless section.settings.show_video_controls %}&controls=0{% endunless %}"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | escape }}"
            ></iframe>
          {%- endif -%}
        {%- else -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1100x',
              autoplay: section.settings.enable_autoplay,
              loop: section.settings.enable_video_looping,
              controls: section.settings.show_video_controls,
              muted: section.settings.enable_autoplay
          }}
        {%- endif -%}
      </template>
    </deferred-media>
    {% if section.settings.enable_autoplay %}
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const deferredMedia = document.querySelector('[data-media-id="{{ video_id }}"]');
          if (deferredMedia && deferredMedia.getAttribute('data-enable-autoplay') === 'true') {
            const button = deferredMedia.querySelector('button');
            if (button) {
              button.click();
            }
          }
        });
      </script>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Video Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.video.settings.heading.default",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Overlay Card"
    },
    {
      "type": "text",
      "id": "overlay_badge_text",
      "label": "Top badge text",
      "default": "Most loved series"
    },
    {
      "type": "text",
      "id": "overlay_title",
      "label": "Overlay title",
      "default": "Stories That Build Connection and Character"
    },
    {
      "type": "font_picker",
      "id": "overlay_title_font",
      "label": "Overlay title font",
      "default": "assistant_n4"
    },
    {
      "type": "color",
      "id": "overlay_title_color",
      "label": "Overlay title color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "overlay_button_label",
      "label": "Overlay button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "overlay_button_link",
      "label": "Overlay button link"
    },
    {
      "type": "text",
      "id": "overlay_small_text",
      "label": "Small text",
      "default": "6 Million Copies Sold"
    },
    {
      "type": "color",
      "id": "overlay_small_text_color",
      "label": "Small text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": false
    },
    {
      "type": "range",
      "id": "star_count",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Number of stars",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__1.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.settings.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Video Banner"
    }
  ]
}
{% endschema %}
