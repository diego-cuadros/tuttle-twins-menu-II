    "ssky_three_block_VTKXX4": {
      "type": "ssky-three-block",
      "blocks": {
        "block_one_bCjY4B": {
          "type": "block_one",
          "settings": {
            "color_scheme": "",
            "heading": "KIDS",
            "text": "<p>Teach relevant <strong>freedom-based</strong> concepts that most of us were<br/>never taught as kids. These <strong>stimulating stories</strong> encourage<br/>children ages 5-11 to make sense<br/>of the world.</p>",
            "image": "shopify://shop_images/girl-atlas.webp",
            "button_label": "Kid's Books",
            "button_link": "shopify://pages/childrens-resources",
            "button_style_secondary": false
          }
        },
        "block_two_4xWe9r": {
          "type": "block_two",
          "settings": {
            "color_scheme": "",
            "heading": "TODDLERS",
            "text": "<p>Introduce big ideas to your (very!) little ones through these children's board books. Join the Tuttle Toddlers on their learning journey as they practice the ABCs and 123s of some important topics!</p>",
            "image": "shopify://shop_images/abc-toddler.webp",
            "button_label": "Toddler Books",
            "button_link": "shopify://collections/toddler-books",
            "button_style_secondary": false
          }
        },
        "block_three_ePAM4H": {
          "type": "block_three",
          "settings": {
            "color_scheme": "",
            "heading": "TEENS",
            "text": "<p>Choose from both fiction stories (like the “Choose Your Own Adventure” books we grew up on) and nonfiction guidebooks, teaching things like <strong>entrepreneurship, critical thinking, and courage.</strong></p>",
            "image": "shopify://shop_images/logical-cropped-1a.webp",
            "button_label": "Teen Guidebooks",
            "button_link": "shopify://collections/guidebooks",
            "button_label_b": "Teen Fiction",
            "button_link_b": "shopify://collections/choose-your-consequence",
            "button_style_secondary": false
          }
        }
      },
      "block_order": [
        "block_one_bCjY4B",
        "block_two_4xWe9r",
        "block_three_ePAM4H"
      ],
      "settings": {
