{%- for cyoc_image in shop.metaobjects.cyoc_image.values limit: 1 -%}
  {%- style -%}
    #Banner-{{ section.id }}::after {
      opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    }

    {%- if section.settings.image_height == 'adapt' and cyoc_image.image != blank -%}
      @media screen and (max-width: 749px) {
        #Banner-{{ section.id }}::before,
        #Banner-{{ section.id }} .banner__media::before,
        #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
          padding-bottom: {{ 1 | divided_by: cyoc_image.image.value.image.aspect_ratio | times: 100 }}%;
          content: '';
          display: block;
        }
      }

      @media screen and (min-width: 750px) {
        #Banner-{{ section.id }}::before,
        #Banner-{{ section.id }} .banner__media::before {
          padding-bottom: {{ 1 | divided_by: cyoc_image.image.value.image.aspect_ratio | times: 100 }}%;
          content: '';
          display: block;
        }
      }
    {%- endif -%}
    {%- unless section.settings.full_width_container %}
      #Banner-{{ section.id }}.page-width {
        overflow: hidden;
        max-width: calc(var(--page-width) - 150px);
        margin: 24px auto;
      }
      @media screen and (min-width: 750px) {
        #Banner-{{ section.id }} .banner__content {
          max-width: 72rem;
        }
      }
      @media screen and (min-width: 990px) {
        #Banner-{{ section.id }} .media > img {
          object-fit: contain;
        }
      }
    {%- endunless -%}
    {%- if section.settings.top_left -%}
      #Banner-{{ section.id }}.ssky-banner .banner__media {
        border-radius: 15vw 0 0 0;
      }
    {%- elsif section.settings.top_right -%}
      #Banner-{{ section.id }}.ssky-banner .banner__media {
        border-radius: 0 15vw 0 0;
      }
    {%- elsif section.settings.bottom_right -%}
      #Banner-{{ section.id }}.ssky-banner .banner__media {
        border-radius: 0 0 15vw 0;
      }
    {%- elsif section.settings.bottom_left -%}
      #Banner-{{ section.id }}.ssky-banner .banner__media {
        border-radius: 0 0 0 15vw;
      }
    {%- endif -%}
    {%- if section.settings.corner_color != blank -%}
      #Banner-{{ section.id }}.ssky-banner {
        background-color: {{ section.settings.corner_color }};
      }
    {%- endif -%}
  {%- endstyle -%}

  {%- liquid
    assign full_width = '100vw'
    assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
    assign fetch_priority = 'auto'
    if section.index == 1
      assign fetch_priority = 'high'
    endif
  -%}

  <div
    id="Banner-{{ section.id }}"
    class="ssky-banner banner banner--desktop-transparent banner--{{ section.settings.image_height }}{%- unless section.settings.full_width_container %} page-width{%- endunless -%}{% if section.settings.image_height == 'adapt' and cyoc_image.image != blank %} banner--adapt{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    {%- if cyoc_image.image != blank -%}
      <div class="banner__media media{% if cyoc_image.image == blank %} placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- liquid
          assign image_height = cyoc_image.image.value.image.width | divided_by: cyoc_image.image.value.image.aspect_ratio
          assign sizes = full_width
        -%}
        {{
          cyoc_image.image
          | image_url: width: 3840
          | image_tag:
            width: cyoc_image.image.value.image.width,
            height: image_height,
            sizes: sizes,
            widths: widths,
            fetchpriority: fetch_priority
        }}
      </div>
    {%- endif -%}
  </div>
{%- endfor -%}

{% schema %}
{
  "name": "TTm CYOC image",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width_container",
      "label": "Full width container",
      "default": true
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.image-banner.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        }
      ],
      "default": "large",
      "label": "t:sections.image-banner.settings.image_height.label",
      "info": "t:sections.image-banner.settings.image_height.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color",
      "default": "#bcecf6"
    }
  ],
  "presets": [
    {
      "name": "TTm CYOC image"
    }
  ]
}
{% endschema %}
