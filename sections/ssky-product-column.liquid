{{ 'ssky-product-column.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign show_as_card = false
  if section.settings.show_as_card == true
    assign show_as_card = true
  endif
-%}
{%- style -%}
  .ssky-product-column-{{ section.id }} .ssky-product-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-product-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-product-column-{{ section.id }} .ssky-product-column__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-product-column-{{ section.id }} .ssky-product-column__wrapper {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }
    }
  {%- endif -%}
  
  .ssky-product-column-{{ section.id }} .ssky-product-column__text {
    list-style: none;
    padding-left: 0;
  }

  .ssky-product-column-{{ section.id }} .ssky-product-column__text li {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }

  .ssky-product-column-{{ section.id }} .ssky-product-column__text li::before {
    content: "";
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-right: 10px;
    background-image: url("data:image/svg+xml,%3Csvg aria-hidden='true' viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm80 248c0 44.112-35.888 80-80 80s-80-35.888-80-80 35.888-80 80-80 80 35.888 80 80z' fill='%23ffffff'%3E%3C/path%3E%3C/svg%3E");
    background-size: contain;
    background-repeat: no-repeat;
    flex-shrink: 0;
  }
{%- endstyle -%}

<div class="ssky-product-column-{{ section.id }}">
  <div class="ssky-product-column gradient color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'caption' -%}
          {% capture caption %}
            <div
              class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ block.settings.caption | escape }}
            </div>
          {% endcapture %}
        {%- when 'product_column' -%}
          {%- assign product_column = true -%}
        {%- when 'product_column_large' -%}
          {%- assign product_column_large = true -%}
        {%- when 'product_column_large_vtwo' -%}
          {%- assign product_column_large_vtwo = true -%}
        {%- when 'product_column_manual' -%}
          {%- assign product_column_manual = true -%}
        {%- when 'product_column_single' -%}
          {%- assign product_column_single = true -%}
        {%- when 'product_column_subscribe' -%}
          {%- assign product_column_subscribe = true -%}
        {%- when 'text' -%}
          {%- assign text_block = true -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- if show_as_card -%}
      {%- if section.settings.heading != blank or caption != blank -%}
        <div class="ssky-text-block__blocks page-width {{ section.settings.content_alignment }}">
          {%- if section.settings.heading != blank -%}
            {%- assign heading_length = section.settings.heading | size -%}
            <h2
              class="ssky-text-block__heading rte inline-richtext {{ section.settings.heading_size }} weight-{{ section.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 1"
              {% endif %}
            >
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {{ caption }}
        </div>
      {%- endif -%}
      <div class="ssky-product-column__layout-card page-width">
    {%- endif -%}
    <div class="ssky-product-column__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-product-column__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
        {%- unless show_as_card -%}
          {%- if section.settings.heading != blank -%}
            <div class="ssky-text-block__heading-con ssky-text-block__blocks">
              {%- assign heading_length = section.settings.heading | size -%}
              <h2
                class="ssky-text-block__heading rte inline-richtext {{ section.settings.heading_size }} weight-{{ section.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: 1"
                {% endif %}
              >
                {{ section.settings.heading }}
              </h2>
              {{ caption }}
            </div>
          {%- endif -%}
        {%- endunless -%}
        {%- if product_column == true -%}
          <div class="ssky-product-column__block-set">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'product_column' -%}
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  <div
                    class="ssky-product-column__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div class="ssky-text-block__blocks">
                      <h3 class="ssky-product-column__heading ssky-text-block__heading rte h5">
                        {%- if block.settings.heading != blank -%}
                          {{ block.settings.heading }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.title }}
                        {%- else -%}
                          {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                        {%- endif -%}
                      </h3>
                      <div class="ssky-product-column__image media{%- if block.settings.image_fit %} image-fit{%- endif -%}">
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 560 | image_tag }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                        {%- else -%}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      <div class="ssky-product-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- else -%}
                          {{ block_product.description | truncatewords: 20 | strip_html }}
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="ssky-text-block__blocks ssky-product-column__price-button-con">
                      <div class="ssky-product-column__price">
                        {%- if block.settings.price != blank -%}
                          {{ block.settings.price }}
                        {%- else -%}
                          {% render 'price', product: block_product, show_compare_at_price: true %}
                        {%- endif -%}
                      </div>
                      {%- if block.settings.button_link != blank -%}
                        <a
                          {% if block.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                          {% else %}
                            href="{{ block.settings.button_link }}"
                          {% endif %}
                          class="ssky-product-column__button button{%- if block.settings.button_large %} button--large{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        >
                          {{ block.settings.button_label | escape }}
                        </a>
                      {%- else -%}
                        {%- render 'buy-buttons',
                          block: block,
                          product: block_product,
                          product_form_id: product_form_id,
                          section_id: section.id,
                          is_product_column: true,
                          is_button_large: block.settings.button_large,
                          button_label: block.settings.button_label
                        -%}
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product_column_large == true -%}
          <div class="ssky-product-column__block-set ssky-product-column-large__block-set">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'product_column_large' -%}
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  <div
                    class="ssky-product-column__block ssky-product-column-large__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div class="ssky-text-block__blocks">
                      <h3 class="ssky-product-column__heading ssky-text-block__heading rte h4 weight-semibold">
                        {%- if block.settings.heading != blank -%}
                          {{ block.settings.heading }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.title }}
                        {%- else -%}
                          {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                        {%- endif -%}
                      </h3>
                      <div class="ssky-product-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- else -%}
                          {{ block_product.description | truncatewords: 20 | strip_html }}
                        {%- endif -%}
                      </div>
                      <div class="ssky-product-column__image media{%- if block.settings.image_fit %} image-fit{%- endif -%}">
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 560 | image_tag }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                        {%- else -%}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="ssky-text-block__blocks">
                      {%- if block.settings.text_bottom != blank -%}
                        <div class="ssky-product-column__text rte{%- if block.settings.text_large_bottom %} text-body-large{%- endif -%}">
                          {{ block.settings.text_bottom }}
                        </div>
                      {%- else -%}
                        <div class="ssky-product-column__price">
                          {%- if block.settings.price != blank -%}
                            {{ block.settings.price }}
                          {%- else -%}
                            {% render 'price', product: block_product, show_compare_at_price: true %}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.button_link != blank -%}
                        <a
                          {% if block.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                          {% else %}
                            href="{{ block.settings.button_link }}"
                          {% endif %}
                          class="ssky-product-column__button button{%- if block.settings.button_large %} button--large{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        >
                          {{ block.settings.button_label | escape }}
                        </a>
                      {%- else -%}
                        {%- render 'buy-buttons',
                          block: block,
                          product: block_product,
                          product_form_id: product_form_id,
                          section_id: section.id,
                          is_product_column: true,
                          is_button_large: block.settings.button_large,
                          button_label: block.settings.button_label
                        -%}
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product_column_large_vtwo == true -%}
          <div class="ssky-product-column__block-set ssky-product-column-large__block-set ssky-product-column-large-v2__block-set">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'product_column_large_vtwo' -%}
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  <div
                    class="ssky-product-column__block ssky-product-column-large__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div class="ssky-text-block__blocks">
                      <div class="ssky-product-column__image media{%- if block.settings.image_fit %} image-fit{%- endif -%}">
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 560 | image_tag }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                        {%- else -%}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      <h3 class="ssky-product-column__heading ssky-text-block__heading rte h5 weight-semibold">
                        {%- if block.settings.heading != blank -%}
                          {{ block.settings.heading }}
                        {%- elsif block_product != blank -%}
                          {{ block_product.title }}
                        {%- else -%}
                          {{ 'TT_Sections.product_column_Section.title_placeholder' | t }}
                        {%- endif -%}
                      </h3>
                      <div class="ssky-product-column__text rte left{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- else -%}
                          {{ block_product.description | truncatewords: 20 | strip_html }}
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="ssky-text-block__blocks">
                      {%- if block.settings.text_bottom != blank -%}
                        <div class="ssky-product-column__text rte{%- if block.settings.text_large_bottom %} text-body-large{%- endif -%}">
                          {{ block.settings.text_bottom }}
                        </div>
                      {%- else -%}
                        <div class="ssky-product-column__price">
                          {%- if block.settings.price != blank -%}
                            {{ block.settings.price }}
                          {%- else -%}
                            {% render 'price',
                              product: block_product,
                              show_compare_at_price: true,
                              price_class: 'primary-blue'
                            %}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if block.settings.button_link != blank -%}
                        <a
                          {% if block.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                          {% else %}
                            href="{{ block.settings.button_link }}"
                          {% endif %}
                          class="ssky-product-column__button button{%- if block.settings.button_large %} button--large{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        >
                          {{ block.settings.button_label | escape }}
                        </a>
                      {%- else -%}
                        {%- render 'buy-buttons',
                          block: block,
                          product: block_product,
                          product_form_id: product_form_id,
                          section_id: section.id,
                          is_product_column: true,
                          is_button_large: block.settings.button_large,
                          button_label: block.settings.button_label
                        -%}
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product_column_subscribe == true -%}
          {%- render 'ssky-product-column-subscribe' -%}
        {%- endif -%}

        {%- if product_column_manual == true -%}
          <div class="ssky-product-column-manual__block-set">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'product_column_manual' -%}
                  <div
                    class="ssky-product-column__block ssky-product-column-manual__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <div class="ssky-product-column__image-con">
                      {%- if block.settings.column_link != blank -%}
                        <a href="{{ block.settings.column_link }}" class="full-unstyled-link">
                      {%- endif -%}
                      <div
                        class="ssky-product-column__image media image-fit"
                        style="padding-bottom:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                      >
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 360 | image_tag }}
                        {%- else -%}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      {%- if block.settings.column_link != blank -%}</a>{%- endif -%}
                    </div>

                    <div class="ssky-text-block__blocks left">
                      <h3 class="ssky-product-column__heading ssky-text-block__heading rte">
                        {%- if block.settings.column_link != blank -%}
                          <a href="{{ block.settings.column_link }}" class="full-unstyled-link rte">
                        {%- endif -%}
                        {%- if block.settings.heading != blank -%}
                          {{ block.settings.heading }}
                        {%- endif -%}
                        {%- if block.settings.column_link != blank -%}</a>{%- endif -%}
                      </h3>
                      <div class="ssky-product-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- endif -%}
                      </div>
                      <div class="ssky-product-column__text ssky-product-column__text--small rte">
                        {%- if block.settings.small_text != blank -%}
                          {{ block.settings.small_text }}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product_column_single == true -%}
          <div class="ssky-product-column-single__block-set">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'product_column_single' -%}
                  <div
                    class="ssky-product-column__block ssky-product-column-single__block ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <h3 class="ssky-product-column__heading ssky-product-column__heading--mobile ssky-text-block__heading weight-semibold rte">
                      {%- if block.settings.heading != blank -%}
                        {{ block.settings.heading }}
                      {%- endif -%}
                    </h3>
                    <div class="ssky-product-column__image-con">
                      <div
                        class="ssky-product-column__image media image-fit"
                        style="padding-bottom:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;"
                      >
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 720 | image_tag }}
                        {%- else -%}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      {%- if block.settings.product != blank -%}
                        {%- assign block_product = block.settings.product -%}
                        {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                        {%- render 'buy-buttons',
                          block: block,
                          product: block_product,
                          product_form_id: product_form_id,
                          section_id: section.id,
                          is_product_column: true,
                          is_product_column_single: true,
                          is_button_large: block.settings.button_large
                        -%}
                      {%- else -%}
                        {%- if block.settings.button_label != blank -%}
                          <a
                            {% if block.settings.button_link == blank %}
                              role="link" aria-disabled="true"
                            {% else %}
                              href="{{ block.settings.button_link }}"
                            {% endif %}
                            class="ssky-product-column__button button{%- if block.settings.button_large %} button--large{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                          >
                            {{ block.settings.button_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                    </div>

                    <div class="ssky-text-block__blocks left">
                      <h3 class="ssky-product-column__heading ssky-product-column__heading--desktop ssky-text-block__heading weight-semibold rte">
                        {%- if block.settings.heading != blank -%}
                          {{ block.settings.heading }}
                        {%- endif -%}
                      </h3>
                      <div class="ssky-product-column__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- endif -%}
                      </div>
                      <div class="ssky-product-column__text ssky-product-column__text--subtext text-body-large rte">
                        {%- if block.settings.sub_text != blank -%}
                          {{ block.settings.sub_text }}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if text_block == true -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  <div class="rte" style="max-width:{{ block.settings.max_width }}rem;">
                    {{ block.settings.text }}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

