    "ssky_text_column_MnEwpa": {
      "type": "ssky-text-column",
      "blocks": {
        "text_column_WptPYK": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<h3>14 Inspiring and Beautifully Illustrated Children’s Books</h3>",
