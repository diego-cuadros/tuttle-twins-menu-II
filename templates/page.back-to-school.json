          }
        },
        "text_column_xee9Tk": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<p>Activities and Conversation <br/>Starters With Every Book</p>",
            "text": "<p>Encourage your kids to learn — and apply!— these new ideas</p>",
