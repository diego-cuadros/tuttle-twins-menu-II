    "ssky_text_block_EDxY4W": {
      "type": "ssky-text-block",
      "blocks": {
        "text_mc7QTy": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p><em>Equipping the Next Generation of Free Thinkers</em></p>",
            "text_size": "large",
            "text_weight": "semibold"
          }
        },
        "heading_VnYPJk": {
          "type": "heading",
          "settings": {
            "heading": "<p>What's Inside<br/>The Tuttle Twins Book Series?</p>",
            "custom_color": "",
            "alignment": "left",
            "heading_size": "h0",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_Lw7JdR": {
          "type": "text",
          "settings": {
            "max_width": 84,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>There is no better way to teach your children about liberty than to read these books with them. They will learn how the world really works, including…</p>",
            "text_size": "large",
            "text_weight": "regular"
          }
        },
        "checkbox_individual_j3wMfg": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>Why a <strong>free market economy</strong> is the greatest way to lift people out of poverty and make the world better for everyone.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_T7KRnx": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>How <strong>property rights</strong> allow us to decide what’s best for us and make better decisions for our family.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_4TKx7j": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>Why the world is a better place is because of <strong>entrepreneurs </strong>who create businesses to help serve us and improve our lives.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_krDDf8": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>What <strong>true laws</strong> are, and why the government should protect our rights.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_w8LRJD": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>What <strong>socialism</strong> is and why it is so destructive to our freedoms and well being.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_j8VL7i": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>How the <strong>Golden Rule</strong> encourages people to get along with one another, no matter where we live, what we look like, or what we believe.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_QxzNCM": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p>Why true <strong>education</strong> (not just memorizing facts) is so important and why children should be allowed to learn things they are interested in.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "text_39BXf3": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>…and so much more!</p>",
            "text_size": "large",
            "text_weight": "regular"
          }
        }
      },
