    "ssky_text_image_block_nGxXAx": {
      "type": "ssky-text-image-block",
      "blocks": {
        "section_header_Y4MpkB": {
          "type": "section_header",
          "settings": {
            "section_heading": "<p>Empower Your Children</p>",
            "heading_size": "h0",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "subheading": "Engage in meaningful family discussions",
            "text_style_subheading": "large-bold",
            "color_class_subheading": "",
            "caption": "",
            "text_style": "medium-semibold",
            "color_class": "primary-blue"
          }
        },
        "heading_jymUUm": {
          "type": "heading",
          "settings": {
            "heading": "<p>You might be wondering:</p>",
            "heading_size": "h4",
            "heading_weight": "bold",
            "heading_tag": "h2"
          }
        },
        "checkbox_zK3pr8": {
          "type": "checkbox",
          "settings": {
            "text": "<p>How do you <strong>communicate big ideas</strong> to little kids without seriously confusing them?</p>",
            "text_large": true
          }
        },
        "checkbox_dwpkwW": {
          "type": "checkbox",
          "settings": {
            "text": "<p>How do you teach an eight-year-old about the <strong>free market</strong> in a way that will be relevant to them… and so they aren’t turned off to economic truths for good?</p>",
            "text_large": true
          }
        },
        "checkbox_eEwbyb": {
          "type": "checkbox",
          "settings": {
            "text": "<p>How can a six-year-old understand <strong>property rights</strong> and not feel pressured to be more than just a kid?</p>",
            "text_large": true
          }
        },
        "text_UHr8Lz": {
          "type": "text",
          "settings": {
            "text": "<p>This series of children’s books teaches your kids what the schools no longer do, <strong>simplifying complex ideas</strong> so they can understand. Tried and tested by millions of readers, this <strong>storytelling approach</strong> works perfectly when it comes to educating your family about real-world concepts.</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        },
        "button_iXqWnJ": {
          "type": "button",
          "settings": {
            "button_medium": false,
            "button_large": true,
            "button_label": "Shop Children's Books",
            "button_link": "shopify://collections/childrens-series",
