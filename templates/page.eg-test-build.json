      "type": "ssky-text-image-block",
      "blocks": {
        "section_header_aHqhr6": {
          "type": "section_header",
          "settings": {
            "section_heading": "<p>Teaching Your Kids About Liberty Is Like 1-2-3</p>",
            "heading_size": "h3",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "subheading": "Parenting today has enough demands as it is—the Tuttle Twins book series is an effective way for busy parents to raise well-rounded critical thinkers.",
            "text_style_subheading": "small-semibold",
            "color_class_subheading": "",
            "caption": "",
            "text_style": "large-bold",
            "color_class": "primary-blue"
          }
        },
        "checkbox_T6etRX": {
          "type": "checkbox",
          "settings": {
            "text": "<p><strong>By simply reading fun stories,</strong> you can teach your kids the powerful ideas of freedom. Each book is 60 pages long (with lots of illustrations!) and fits seamlessly into your family’s daily routines. No extra work needed from you.</p>",
            "text_large": true,
            "number": 1
          }
        },
        "checkbox_6BMYJz": {
          "type": "checkbox",
          "settings": {
            "text": "<p><strong>There is nothing you need to know</strong> before sharing these books with your kids—just read and learn together. These books are designed to make your parenting easier by giving you confidence that your kids are learning true principles.</p>",
            "text_large": true,
            "number": 2
          }
        },
        "checkbox_C6gHz6": {
          "type": "checkbox",
          "settings": {
            "text": "<p><strong>Yes, your kids can also read these books alone</strong>, and many of them devour the whole series eagerly, as they activate new learning and conversation in the family.</p>",
