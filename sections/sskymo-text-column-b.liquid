{%- style -%}
  .ssky-text-column-{{ section.id }} .ssky-text-column {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-column-{{ section.id }} .ssky-text-column {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-column-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<div class="ssky-text-column-{{ section.id }}">
  <div class="ssky-text-column gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width ssky-text-column__layout-border">
      {%- for fun_board_books in shop.metaobjects.fun_board_books.values limit: 1 -%}
        <div class="ssky-text-column__blocks ssky-text-block__blocks center">
          {%- if fun_board_books.heading != blank -%}
            <h3
              class="ssky-text-block__heading rte inline-richtext h2 ssky-text-block__heading--long{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 1"
              {% endif %}
            >
              {{ fun_board_books.heading | metafield_tag }}
            </h3>
          {%- endif -%}
          <div class="ssky-text-column__block-set--top">
            <div
              class="ssky-text-column__block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 1;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h6 primary-blue">
                  {{ fun_board_books.column_one_heading }}
                </h4>
                <div class="ssky-text-column__text rte">
                  {{ fun_board_books.column_one_text | metafield_tag }}
                </div>
              </div>
            </div>
            <div
              class="ssky-text-column__block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 2;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h6 primary-blue">
                  {{ fun_board_books.column_two_heading }}
                </h4>
                <div class="ssky-text-column__text rte">
                  {{ fun_board_books.column_two_text | metafield_tag }}
                </div>
              </div>
            </div>
            <div
              class="ssky-text-column__block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 3;"
              {% endif %}
            >
              <div>
                <h4 class="ssky-text-column__heading h6 primary-blue">
                  {{ fun_board_books.column_three_heading }}
                </h4>
                <div class="ssky-text-column__text rte">
                  {{ fun_board_books.column_three_text | metafield_tag }}
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TTm Fun board books",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Fun board books"
    }
  ]
}
{% endschema %}
