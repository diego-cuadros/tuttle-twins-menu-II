    "ssky_faqs_dwWQkt": {
      "type": "ssky-faqs",
      "blocks": {
        "heading_wWRMjW": {
          "type": "heading",
          "settings": {
            "heading": "<p>Frequently Asked Questions</p>",
            "heading_size": "h1",
            "heading_weight": "bold"
          }
        },
        "faq_KJyBEe": {
          "type": "faq",
          "settings": {
            "text": "<p>What Are Some Good History Books for Kids?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Great history books for kids weave stories with facts. Look for books that tell interesting stories about historical people and events in a way that is appropriate for their age. That's exactly what our America's History books do, empowering children to learn, grow, and start thinking critically.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_t9FyqB": {
          "type": "faq",
          "settings": {
            "text": "<p>What Is The Most Popular Book for 7‑Year‑Olds?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>7-year-olds tend to prefer chapter books with pictures, although their reading levels can vary. This age group will be interested in the inspiring ideas and events in America’s History, Volume 1 (1215–1776).</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_HkwC6r": {
          "type": "faq",
          "settings": {
            "text": "<p>What Are the Best History Books?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>The best history books are accurate, easy to read, and inspiring. Our volumes offer well-researched, engaging narratives that emphasize important values and ideas, making them a great fit for both home and school learning.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_BjEDfn": {
          "type": "faq",
          "settings": {
            "text": "<p>What Should My 10‑Year‑Old Be Reading?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>At age 10, kids can grasp more serious topics and ask \"why\". Our American history books are a fantastic fit because they encourage kids to ask questions about the history that shaped our world, and answer them at the same time.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_UYtxgA": {
          "type": "faq",
          "settings": {
            "text": "<p>What Age Group Are Our Books Suitable For?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Our historical fiction books for kids are perfect for children ages 5–12. The stories are designed to be engaging for younger readers, with more complex narratives for older kids as they develop their reading skills.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_JNJNXC": {
          "type": "faq",
          "settings": {
            "text": "<p>Are the Historical Events in Our Books Accurate?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes! We take great care to ensure that the historical events depicted in our books are accurate. While the characters and storylines are fictional, the settings and events are grounded in real historical facts.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_FjhXHx": {
          "type": "faq",
          "settings": {
            "text": "<p>Are Our Books Appropriate for School Reading?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes! Many of our books align with school curricula, particularly in subjects like history and social studies. They offer an excellent supplement to classroom learning by making history come alive in an entertaining and thought-provoking way.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
