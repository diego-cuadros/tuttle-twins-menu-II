<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"> 
{%- style -%}
  .ssky-text-column__block--w--icons-{{block.id}} {
    max-width: 100%!important;
    display: flex;
    flex-direction: column;
    padding: 0!important;
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }
  .ssky-text-column__block--w--icons-{{block.id}} .ssky-text-block__blocks > * + * {
    margin-top: 0;
  }

  .ssky-text-column__block--w--icons-{{block.id}} .ssky-text-column__heading {
    margin-bottom: 1rem;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-top .ssky-text-block__blocks {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-top .ssky-text-column__block--w--icons-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 2rem auto;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-left .ssky-text-block__blocks {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-left .ssky-text-column__block--w--icons-icon {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-right: 1.5rem;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-left .ssky-text-column__block--content {
    flex: 1;
    text-align: left;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-right .ssky-text-block__blocks {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-right .ssky-text-column__block--w--icons-icon {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-left: 1.5rem;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}}.icon-position-right .ssky-text-column__block--content {
    flex: 1;
    text-align: right;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}} .ssky-text-column__block--w--icons-icon i {
    font-size: 2.5rem;
    padding: 1.5rem;
    border-radius: 5px;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}} .ssky-text-column__block--text-content {
    min-width: 0; 
    word-break: break-word; 
    overflow-wrap: break-word;
    text-align: left;
  }

  .ssky-text-column__block--w--icons-{{block.id}} i.fa {
    min-width: 55px;
    text-align: center;
  }
  
  .ssky-text-column__block--w--icons-{{block.id}} .text-body-large {
    font-size: 1.125rem;
    line-height: 1.5;
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-column__block--w--icons-{{block.id}} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-column__block--w--icons-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}    
<div
  class="ssky-text-column__block ssky-text-column__block--w--icons ssky-text-column__block--w--icons-{{block.id}} icon-position-{{ block.settings.icon_position }} gradient color-{{ block.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
  <div class="ssky-text-block__blocks">
    {%- if block.settings.icon_type != 'none' -%}
      <span class="ssky-text-column__block--w--icons-icon">
        <i class="fa {{ block.settings.icon_type }}" aria-hidden="true" 
        style="background: {{ block.settings.icon_background_color }}; color: {{ block.settings.icon_color }};"></i>
      </span>
    {%- endif -%}
    
    <div class="ssky-text-column__block--content">
      <h4 class="ssky-text-column__heading rte h5" 
          {% if block.settings.heading_color != blank %}
            style="color: {{ block.settings.heading_color }};"
          {% endif %}
      >
        {{ block.settings.heading }}
      </h4>
      {%- if block.settings.text_item != blank -%}
        <div class="ssky-text-column__block--w--icons-text{%- if block.settings.text_large %} text-body-large{%- endif -%}">
          <div class="rte ssky-text-column__block--text-content">
            {{ block.settings.text_item }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Text column with icons",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "select",
        "id": "icon_position",
        "label": "Icon position",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "top"
      },
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "info": "Leave blank to use default text color"
      },
      {
        "type": "select",
        "id": "icon_type",
        "label": "Icon type",
        "options": [
          {
            "value": "none",
            "label": "No icon"
          },
          {
            "value": "fa-book-reader",
            "label": "Book Reader"
          },
          {
            "value": "fa-chalkboard-teacher",
            "label": "Chalkboard Teacher"
          },
          {
            "value": "fa-lightbulb",
            "label": "Light Bulb"
          },
          {
            "value": "fa-check",
            "label": "Checkmark"
          },
          {
            "value": "fa-star",
            "label": "Star"
          },
          {
            "value": "fa-heart",
            "label": "Heart"
          },
          {
            "value": "fa-edit",
            "label": "Edit"
          },
          {
            "value": "fa-question",
            "label": "Question Mark"
          },
          {
            "value": "fa-thumbs-up",
            "label": "Thumbs up"
          },
          {
            "value": "fa-arrow-right",
            "label": "Arrow right"
          },
          {
            "value": "fa-trophy",
            "label": "Trophy"
          },
          {
            "value": "fa-gift",
            "label": "Gift"
          },
          {
            "value": "fa-clock",
            "label": "Clock"
          },
          {
            "value": "fa-cog",
            "label": "Settings/Gear"
          },
          {
            "value": "fa-bell",
            "label": "Bell"
          },
          {
            "value": "fa-shield",
            "label": "Shield"
          },
          {
            "value": "fa-bookmark",
            "label": "Bookmark"
          },
          {
            "value": "fa-tag",
            "label": "Tag"
          },
          {
            "value": "fa-rocket",
            "label": "Rocket"
          }
        ],
        "default": "fa-check"
      },
      {
        "type": "color",
        "id": "icon_background_color",
        "label": "Icon Background Color"
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon Color"
      },
      {
        "type": "richtext",
        "id": "text_item",
        "label": "Text item"
      },
      {
        "type": "checkbox",
        "id": "text_large",
        "label": "t:sections.all.ssky_text_large.label",
        "default": false
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Text column with icons" }
    ]
  }
{% endschema %}