{%- style -%}
  .ssky-text-block__text_columns-{{ block.id }} {
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-block__text_columns-{{ block.id }} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__text_columns-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div class="ssky-text-block__text_columns ssky-text-block__text_columns-{{ block.id }}" {{ block.shopify_attributes }}>
  {% for i in (1..3) %}
    {%- liquid
      assign text_id = 'text_' | append: i
      assign text_size_id = 'text_size_' | append: i
      assign text_weight_id = 'text_weight_' | append: i
      assign subtext_id = 'subtext_' | append: i
      assign text = block.settings[text_id]
      assign text_size = block.settings[text_size_id]
      assign text_weight = block.settings[text_weight_id]
      assign subtext = block.settings[subtext_id]
    -%}
    {%- if text != blank -%}
      <div class="ssky-text-block__text_column">
        <div
          class="ssky-text-block__text rte text-{{ text_size }} weight-{{ text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ text }}
        </div>
        {%- if subtext != blank -%}
          <div class="ssky-text-block__text rte text-medium">
            {{ subtext }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {% endfor %}
</div>

