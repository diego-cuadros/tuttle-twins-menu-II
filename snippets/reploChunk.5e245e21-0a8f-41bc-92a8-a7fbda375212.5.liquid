16-a147-f02e2a9cea12?width=80" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/f8b418be-2d48-4c16-a147-f02e2a9cea12?width=80" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/f8b418be-2d48-4c16-a147-f02e2a9cea12" class="r-1xqhhs2" loading="eager"/></picture><div data-rid="cc4ad6d4-d2a8-4f59-93df-adf92d0d26b8" class="r-rstx7r"><div data-rid="f31854de-b0ae-455a-a29b-f933013a3032" class="r-17gt9jh alchemy-rte"><span style="width:100%"><p>The Economics Blind Spot</p></span></div><div data-rid="7bbfee16-a3d9-4d9a-99e6-cf14a40fd11d" class="r-1f4nhp5 alchemy-rte"><span style="width:100%"><p>Only 1 in 5 teens can correctly explain inflation. Yet every financial decision they'll ever make — their first job, first apartment, first investment — depends on understanding it before they sign anything.</p></span></div></div><div data-rid="d7e58b4e-d55a-4fa0-aaeb-faf81f1f9d63" class="r-m15n55"><picture data-rid="f7c8aa47-b0b8-4c8d-b849-3174ee15a74c" class="r-1kgy3f"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49" class="r-753fl9" loading="eager"/></picture><div data-rid="be7e170f-b18e-4ede-a10a-2f02ad0641b8" class="r-1t5g0u4 alchemy-rte"><span style="width:100%"><p>1 in 5 teens understand inflation</p></span></div></div></div><div data-rid="b30ca640-3dd0-4f09-8aae-404e42eecbbe" class="r-2cjdsi"><picture data-rid="fbea9555-e4c1-482f-87af-5c55b80cec47" class="r-19376jf"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/c8e25498-623b-4fe7-9b9d-824772b12b72?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/c8e25498-623b-4fe7-9b9d-824772b12b72?width=80" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/c8e25498-623b-4fe7-9b9d-824772b12b72?width=80" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/c8e25498-623b-4fe7-9b9d-824772b12b72" class="r-1q1609v" loading="eager"/></picture><div data-rid="f1a2a346-45db-4f28-9bdd-01d4b567fb67" class="r-mjhou2"><div data-rid="307e0476-d74f-4621-bf68-e21a223e4bc4" class="r-q0e9w1 alchemy-rte"><span style="width:100%"><p>The Civics Black Hole</p></span></div><div data-rid="0741054f-e7f4-4069-9a0e-68a8c4e3439c" class="r-1f8v0oe alchemy-rte"><span style="width:100%"><p>Only 13% of 8th graders score proficiently in civics. Most teens can't name the three branches of government, let alone explain why the separation of powers was designed specifically to protect their freedom.</p></span></div></div><div data-rid="2d950cdf-a0f5-4194-bab3-b650407620bd" class="r-18sa0k4"><picture data-rid="b2f10ed5-13a1-4b67-b893-698ec579dbe3" class="r-1og2pjs"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49" class="r-1nypb87" loading="eager"/></picture><div data-rid="0447e6da-4daa-45d3-9a62-e362bd189db9" class="r-1uw12tn alchemy-rte"><span style="width:100%"><p>Only 13% pass 8th-grade civics</p></span></div></div></div><div data-rid="38de534d-40d8-4330-b3dd-eea3aef1ec85" class="r-1flq6vc"><picture data-rid="874ed288-bc1e-4786-bf3c-538e18a667af" class="r-9iddy"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/8bd760e6-8401-4019-bf8a-fba03ac07a6f?width=80" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/8bd760e6-8401-4019-bf8a-fba03ac07a6f?width=80" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/8bd760e6-8401-4019-bf8a-fba03ac07a6f?width=80" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/8bd760e6-8401-4019-bf8a-fba03ac07a6f" class="r-1upfnyv" loading="eager"/></picture><div data-rid="fc0f074e-5ce2-42be-92e8-3f325f75c938" class="r-1y7uhkv"><div data-rid="7953abed-2940-4162-9d80-299a0cb1dacc" class="r-kv0eg9 alchemy-rte"><span style="width:100%"><p>The Big Ideas They Never Get</p></span></div><div data-rid="182c86e5-adfc-42c2-98e7-8d495feef6e6" class="r-1f50gtz alchemy-rte"><span style="width:100%"><p>Supply and demand. Compound interest. How an argument is built and how a fallacy is spotted. These aren't advanced college concepts — they're the foundational operating system of adult life. School just doesn't teach them.</p></span></div></div><div data-rid="cd56cab3-28a4-4e28-a5f7-8602000997b8" class="r-1sdxsdw"><picture data-rid="3991d192-fc78-42e0-9887-970a35e21300" class="r-pfm3ji"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49?width=28" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/ea324e25-04f9-4e10-9397-2ed73a084a49" class="r-3tkoec" loading="eager"/></picture><div data-rid="04183c77-bfa4-4eab-9036-aa8d935d903d" class="r-1akbkle alchemy-rte"><span style="width:100%"><p>0 states require personal finance to graduate</p></span></div></div></div></div></div></div></div><div data-rid="91edee4b-b4e6-4298-850b-cee2e32eae95" data-alchemy-url-hashmark="lessons" tabindex="-1" id="lessons" data-alchemy-url-hashmark-ignore="true" class="r-1aldj53"><div data-rid="6a24f49b-2117-474a-8e47-7c0c45592318" class="r-1xb9li3"><div data-rid="1b799e6b-0d41-4f62-9fdd-b8a8bb5c4041" class="r-1brktwo"><div data-rid="2a8e0d29-4eaf-46ec-8520-1b80bde42ada" class="r-l64bzs alchemy-rte"><span style="width:100%"><h2>318 Lessons. Real Ideas. No Textbook Shortcuts.</h2></span></div><div data-rid="43b73356-5e7e-4aef-bb28-9a27103a4646" class="r-v18lo5 alchemy-rte"><span style="width:100%"><p>Not summaries. Not simplified. The actual Big Ideas — the economic principles, constitutional foundations, and logical frameworks that shape the real world — taught by the people who've spent careers mastering them.</p></span></div></div><div class="r-1kdp28v" data-rid="1"><div data-rid="0de2a61c-dfe7-4f5e-8971-ce55330e94a3" class="r-1quin87" data-orientation="vertical"><div data-rid="a02d87a2-470c-4f89-a83a-aa23447e1a7b" class="r-vgxso0"><div data-rid="0201891c-5582-4269-8182-30dc742d3527" class="r-1uvosni" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="b15a6ad7-f6c4-48aa-9327-a40fd60b303b" aria-expanded="false" aria-controls="replo-:R5lb2:" tabindex="0" role="button" class="r-10ipn29"><picture data-rid="0adb583c-f037-4292-9634-d30d55a9a4a9" class="r-x59of1"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b14d0516-732b-4ee1-83eb-0dafcf72d3d7?width=48" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b14d0516-732b-4ee1-83eb-0dafcf72d3d7?width=64" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b14d0516-732b-4ee1-83eb-0dafcf72d3d7?width=64" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/b14d0516-732b-4ee1-83eb-0dafcf72d3d7" class="r-tnaqwv" loading="eager"/></picture><div data-rid="ce482c12-b46a-4ecc-b1c2-71c77db3b55b" class="r-d2fmjh alchemy-rte"><span style="width:100%"><p>The Psychology of Persuasion</p></span></div><div data-rid="80c29ab7-7c6f-4fa3-b2af-0969aaf9b07d" class="r-1ssaktv alchemy-rte"><span style="width:100%"><p>NEW</p></span></div><div data-rid="163e2ac8-c148-4a60-8c78-7b4e7e8fe3bf" class="r-nbb9zb" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1mrzkzs" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" id="replo-:R5lb2:"><div data-rid="728c3b64-123b-49f5-bcfd-e7b