            "button_label": "",
            "button_link": "",
            "button_style_secondary": false
          }
        },
        "text_column_Lfej6X": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<p>Based on Famous Books by <br/>Thought Leading Authors</p>",
            "text": "<p>Restore freedom of education and the values that make our society great</p>",
            "text_large": true,
            "button_label": "",
            "button_link": "",
            "button_style_secondary": false
          }
        },
        "text_column_NwrePG": {
          "type": "text_column",
          "settings": {
            "color_scheme": "scheme-1",
            "heading": "<p>Easy to Understand Language <br/>for Kids About Big Ideas</p>",
