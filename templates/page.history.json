    "ssky_two_columns_custom_block_x3UTHr": {
      "type": "ssky-two-columns-custom-block",
      "blocks": {
        "text_with_icon_B8QawL": {
          "type": "text_with_icon",
          "settings": {
            "text_size": "medium",
            "text_weight": "regular",
            "text": "<p>Focus on superficial facts, such as dates and names of places and battles</p>",
            "custom_color": "",
            "text_b": "<p>Help young readers understand history more deeply by immersing them in the stories around the events</p>",
            "custom_color_b": ""
          }
        },
        "text_with_icon_6fj7Pq": {
          "type": "text_with_icon",
          "settings": {
            "text_size": "medium",
            "text_weight": "regular",
            "text": "<p>Gloss over the Founding Fathers' ideas that revolutionized America and the world</p>",
            "custom_color": "",
            "text_b": "<p>Teach the inspiring ideas of America's founding and how those ideas are relevant to their lives today</p>",
            "custom_color_b": ""
          }
        },
        "text_with_icon_GCkTfU": {
          "type": "text_with_icon",
          "settings": {
            "text_size": "medium",
            "text_weight": "regular",
            "text": "<p>Don't help young readers understand why what happened 250 years ago is relevant to our world today</p>",
            "custom_color": "",
            "text_b": "<p>Challenge your children to learn from the past and apply those ideas to our world</p>",
