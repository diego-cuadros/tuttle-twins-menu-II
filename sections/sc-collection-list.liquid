{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
 
{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
 
{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
 

{{ 'collection-list-style.css' | asset_url | stylesheet_tag }}
<section class="sc-collection-list"> 
  
  <div class="top-bar">
      <div class="container page-width">
        {% if section.settings.main-title != blank %}
            <h2 class="main-title"> {{ section.settings.main-title }}</h2>
        {% endif %}

        <div class="collection-title-list">
            {% for block in section.blocks %}
                {% assign selected_collection1 = block.settings.collection %}
                {%  if block.settings.tab-title != blank %}
                    <div class="collection-title" style="background-color: {{ block.settings.bg-color }}; color: {{ block.settings.color }};">
                        <a class="collection_trigger" href="#{{- selected_collection1.url | remove:'collections' | remove:'/' -}}"> {{ block.settings.tab-title }} </a>
                    </div>
                {% else %}
                    <div class="collection-title" style="background-color: {{ block.settings.bg-color }}; color: {{ block.settings.color }};">
                        <a class="collection_trigger" href="#{{- selected_collection1.url | remove:'collections' | remove:'/' -}}" data-title="{{ selected_collection1.title | handleize }}"> {{ selected_collection1.title }} </a>
                    </div>
                {% endif %}
            {% endfor %}
        </div>


    </div>
  </div>

  <div class="collection-body-block">
    <div class="container page-width">
        {% for block in section.blocks %}
      {% assign selected_collection = block.settings.collection %}

      {% if selected_collection != blank %}
        <div class="collection-block" id="{{ selected_collection.url | remove:'collections' | remove:'/' }}">
        
          <div class="collection-details-header">
            {% if block.settings.section-title != blank %}
                <h2 class="collection-title">
                {{ block.settings.section-title }}
                </h2>
            {% else %}
                <h2 class="collection-title">
                  {{ selected_collection.title }}
                </h2>
            {%  endif %}    

            {% if block.settings.section-subtitle != blank %}
                <div class="sub-title"> {{ block.settings.section-subtitle }} </div>
            {% endif %}
          </div>

          <div class="collection-details-body">
            <ul
              id="product-grid-{{ block.id }}"
              data-id="{{ section.id }}"
              class="
                grid product-grid
                grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >

              {% for product in selected_collection.products limit: block.settings.products_limit %}
                {% assign lazy_load = false %}
                {% if forloop.index > 2 %}
                  {% assign lazy_load = true %}
                {% endif %}

                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >

                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: false,
                    quick_add: section.settings.quick_add,
                    section_id: section.id
                  %}

                </li>

              {% endfor %}
            </ul>
          </div>

        </div>
      {% endif %}
    {% endfor %}


      </div>

  </div>
</section>

<script>
  document.querySelectorAll('.collection-title-list .collection-title').forEach(function(item) {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      const trigger = this.querySelector('.collection_trigger');
      if (!trigger) return;
      let href = trigger.getAttribute('href');
      if (href.startsWith('#')) {
        href = href.substring(1);
      }
      const target = document.querySelector('.collection-block[id="' + href + '"]');
      if (!target) return;
      const offset = 100;
      const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth'
      });
    });
  });
</script>

{% schema %}
{
