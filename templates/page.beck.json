        },
        "text_with_icon_cmyLRi": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "medium",
            "text_weight": "regular",
            "icon": "shopify://shop_images/Group_101525.png",
            "text": "<p><strong>Be Confident as a Parent as you Teach Your Children Your Values </strong>Storytelling and fun illustrations unpack big concepts for easy understanding</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_ndtk6d": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "medium",
            "text_weight": "regular",
            "icon": "shopify://shop_images/Group_101525.png",
            "text": "<p><strong>Fix Your Own Political and Economic Education Gaps </strong>Learn big ideas together as a family in a simple and engaging way</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_j44KU4": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "medium",
            "text_weight": "regular",
            "icon": "shopify://shop_images/Group_101525.png",
            "text": "<p><strong>Give Your Children a Leg Up in Life </strong>Encouraging critical thinking and truth seeking will set them apart</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_LykGVh": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "medium",
            "text_weight": "regular",
            "icon": "shopify://shop_images/Group_101525.png",
            "text": "<p><strong>Raise Well Rounded Children </strong>So they are prepared and understand what’s going on in the world</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_with_icon_MrED8P": {
          "type": "text_with_icon",
          "settings": {
            "alignment": "left",
            "text_size": "medium",
            "text_weight": "regular",
            "icon": "shopify://shop_images/Group_101525.png",
            "text": "<p><strong>Bond as a Family and Strengthen Your Values </strong>Elevate family discussions with powerful ideas and current events</p>",
            "custom_color": "",
            "text_b": "",
            "custom_color_b": ""
          }
        },
        "text_znNGft": {
          "type": "text",
          "settings": {
            "max_width": 75,
            "custom_color": "rgba(0,0,0,0)",
            "alignment": "center",
            "text": "<p><strong>If you want a way to educate and equip your children for the future, we are glad you found us — because something new and important is happening here.</strong></p>",
            "text_size": "medium",
            "text_weight": "semibold"
          }
        }
