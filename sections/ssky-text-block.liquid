{% comment %}
  DO NOT modify this file, its classes, or CSS. It is a universal module.
{% endcomment %}
{%- liquid
  assign merging_with_section_below = false
  assign show_as_card = false
  assign narrow_width = false
  assign text_button_split = false
  if section.settings.merging_with_section_below == true
    assign merging_with_section_below = true
  elsif section.settings.show_as_card == true
    assign show_as_card = true
    if section.settings.narrow_width == true
      assign narrow_width = true
    endif
    if section.settings.text_button_split == true
      assign text_button_split = true
    endif
  endif
  assign background_block = false
  for block in section.blocks
    case block.type
      when 'background'
        assign background_block = true
    endcase
  endfor
-%}
{%- style -%}
  .ssky-text-block-{{ section.id }} .ssky-text-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .ssky-text-block-{{ section.id }} .ssky-text-block__blocks:not(.ssky-text-block__divider) {
    max-width: 60rem;
  }
  .ssky-text-block-{{ section.id }} .ssky-text-block__text-with-icons {
    max-width: {{ section.settings.twi_max_width }}rem !important;
    margin-top: {{ section.settings.twi_margin }}px;
    row-gap: {{ section.settings.twi_margin }}px
  }
  @media screen and (min-width: 750px) {
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .ssky-text-block-{{ section.id }} .ssky-text-block__blocks:not(.ssky-text-block__divider, .ssky-text-block__buttons) {
      max-width: {{ section.settings.max_width }}rem;
    }
    .ssky-text-block-{{ section.id }} .ssky-text-block__blocks .ssky-text-block__checkbox--individual,
    .ssky-text-block-{{ section.id }} .ssky-text-block__blocks .ssky-text-block__checkbox--with-icon {
      max-width: {{ section.settings.max_width | minus: 6.4 }}rem;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if merging_with_section_below -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      z-index: 1;
    }
    .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    }
    .ssky-text-block-{{ section.id }} .ssky-text-block__layout-merging-color {
      background-color: {{ section.settings.merging_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'caption' -%}
        {%- if block.settings.custom_color != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__caption[{{ block.shopify_attributes | replace: '"', "'" }}] {
            color: {{ block.settings.custom_color }} !important;
          }
        {%- endif -%}
      {%- when 'heading' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__heading[{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
      {%- when 'text' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__text[{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
      {%- when 'text_with_icon' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__text-with-icon [{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
        {%- if block.settings.custom_color_b != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__text-with-icon-b [{{ block.shopify_attributes | replace: '"', "'" }}] {
            color: {{ block.settings.custom_color_b }} !important;
          }
        {%- endif -%}
      {%- when 'checkbox_individual' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__checkbox--individual[{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
      {%- when 'checkbox' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__checkbox[{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
      {%- when 'checkbox_with_icon' -%}
        {%- if block.settings.custom_color != blank or block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__checkbox--with-icon[{{ block.shopify_attributes | replace: '"', "'" }}] {
            {%- if block.settings.custom_color != blank -%}
              color: {{ block.settings.custom_color }} !important;
            {%- endif -%}
            {%- if block.settings.alignment != blank -%}
              text-align: {{ block.settings.alignment }} !important;
            {%- endif -%}
          }
        {%- endif -%}
      {%- when 'highlights' -%}
        {%- if block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] {
            text-align: {{ block.settings.alignment }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_a != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(1) {
            color: {{ block.settings.custom_color_a }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_b != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(2) {
            color: {{ block.settings.custom_color_b }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_c != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(3) {
            color: {{ block.settings.custom_color_c }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_d != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(4) {
            color: {{ block.settings.custom_color_d }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_e != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(5) {
            color: {{ block.settings.custom_color_e }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_f != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(6) {
            color: {{ block.settings.custom_color_f }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_g != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(7) {
            color: {{ block.settings.custom_color_g }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_h != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(8) {
            color: {{ block.settings.custom_color_h }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_i != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(9) {
            color: {{ block.settings.custom_color_i }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color_j != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__highlights[{{ block.shopify_attributes | replace: '"', "'" }}] .ssky-text-block__highlight:nth-child(10) {
            color: {{ block.settings.custom_color_j }} !important;
          }
        {%- endif -%}
      {%- when 'button' -%}
        {%- if block.settings.alignment != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__buttons[{{ block.shopify_attributes | replace: '"', "'" }}] {
            text-align: {{ block.settings.alignment }} !important;
          }
        {%- endif -%}
        {%- if block.settings.custom_color != blank -%}
          #shopify-section-{{ section.id }} .ssky-text-block__text-below-buttons[{{ block.shopify_attributes | replace: '"', "'" }}] {
            color: {{ block.settings.custom_color }} !important;
          }
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endstyle -%}
<div 
  class="ssky-text-block-{{ section.id }}" 
  {% if section.settings.custom_id != blank %}id="{{ section.settings.custom_id | escape }}"{% endif %}
>
  <div class="ssky-text-block content-container color-{{ section.settings.color_scheme }} gradient">
    {%- if merging_with_section_below -%}
      <div class="ssky-text-block__layout-merging page-width{%- if section.settings.merge_with_section_above %} ssky-text-block__layout-merging-above{%- endif -%}">
        <div class="color-{{ section.settings.color_scheme_layout_merging }} gradient">
    {%- endif -%}
    {%- if show_as_card -%}
      <div class="page-width{%- if text_button_split %} ssky-text-block__layout-split{%- endif -%}">
    {%- endif -%}
    <div class="ssky-text-block__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-text-block__blocks ssky-text-block__background {{ section.settings.content_alignment }}{%- if background_block == true %} color-scheme-1{%- endif -%}{%- if text_button_split %} ssky-text-block__blocks--split{%- endif -%}">
        {%- if text_button_split -%}<div class="ssky-text-block__blocks left">{%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'caption' -%}
              <div
                class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.caption | escape }}
              </div>
            {%- when 'heading' -%}
              {%- assign heading_length = block.settings.heading | size -%}
              <{{ block.settings.heading_tag }}
                class="ssky-text-block__heading rte {{ block.settings.heading_size }} {{ block.settings.alignment }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% if block.settings.center %} center{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </{{ block.settings.heading_tag }}>

            {%- when 'text' -%}
              <div
                class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="rte {{ block.settings.alignment }}" style="max-width:{{ block.settings.max_width }}rem;margin-inline: auto;">
                  {{ block.settings.text }}
                </div>
              </div>
            {%- when 'text_with_icon' -%}
              <div class="ssky-text-block__text-with-icons{%- if block.settings.text_b != blank %} ssky-text-block__text-with-icon-b{%- endif -%}">
                <div class="ssky-text-block__text-with-icon">
                  {%- if block.settings.icon != blank -%}
                    <div
                      class="ssky-text-block__icon{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {{ block.shopify_attributes }}
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      <img src="{{ block.settings.icon | image_url: width: nil }}">
                    </div>
                  {%- endif -%}
                  <div
                    class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.text }}
                  </div>
                </div>
                {%- if block.settings.text_b != blank -%}
                  <div class="ssky-text-block__text-with-icon">
                    {%- if block.settings.icon_b != blank -%}
                      <div
                        class="ssky-text-block__icon{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {{ block.shopify_attributes }}
                        {% if settings.animations_reveal_on_scroll %}
                          data-cascade
                          style="--animation-order: {{ forloop.index }};"
                        {% endif %}
                      >
                        <img src="{{ block.settings.icon_b | image_url: width: nil }}">
                      </div>
                    {%- endif -%}
                    <div
                      class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {{ block.shopify_attributes }}
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {{ block.settings.text_b }}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- when 'divider' -%}
              <div
                class="ssky-text-block__divider"
                style="margin:{{ block.settings.margin }}px auto;{%- if block.settings.contrast -%}border-color:rgb(var(--color-foreground));{%- endif -%}"
              ></div>
            {%- when 'icon' -%}
              {%- if block.settings.icon != blank -%}
                <div
                  class="ssky-text-block__icon{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  <img src="{{ block.settings.icon | image_url: width: nil }}">
                </div>
              {%- endif -%}
            {%- when 'image' -%}
              <div
                class="ssky-text-block__image{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="ssky-text-block__image--mobile">
                  {%- if block.settings.image_mobile != blank -%}
                    {%- assign widths = '360, 535, 750, 1070' -%}
                    {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                    {{
                      block.settings.image_mobile
                      | image_url: width: 1070
                      | image_tag: sizes: sizes, widths: widths, fetchpriority: 'auto'
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="ssky-text-block__image--desktop">
                  {%- if block.settings.image != blank -%}
                    {%- assign widths = '1500, 1780, 2000, 3000, 3840' -%}
                    {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'full_width' -%}{%- endcapture -%}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag: sizes: sizes, widths: widths, fetchpriority: 'auto'
                    }}
                  {%- else -%}
                    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            {%- when 'background' -%}
              {%- style -%}
                .ssky-text-block-{{ section.id }} .ssky-text-block__background {
                  position: relative;
                  background-image: url('{{ block.settings.image | image_url: width: 3840 }}');
                  background-position: center center;
                  background-repeat: no-repeat;
                  background-size: cover;
                  border-radius: 45px;
                  background-color: {{ block.settings.background }};
                  padding: 20px;
                  padding-top: {{ block.settings.padding_top }}px;
                  padding-bottom: {{ block.settings.padding_bottom }}px;
                }
                @media screen and (min-width: 750px) {
                  .ssky-text-block-{{ section.id }} .ssky-text-block__background {
                    padding-right: 50px;
                    padding-left: 50px;
                  }
                }
                {%- if block.settings.background_overlay > 0 -%}
                  .ssky-text-block-{{ section.id }} .ssky-text-block__background > * {
                    position: relative;
                    z-index: 2;
                  }
                  .ssky-text-block-{{ section.id }} .ssky-text-block__background-overlay {
                    position: absolute;
                    top: 0;
                    right: 0;
                    bottom: 0;
                    left: 0;
                    display: block;
                    max-width: unset !important;
                    margin-top: unset;
                    border-radius: 45px;
                    background-color: {{ block.settings.background }};
                    opacity: {{ block.settings.background_overlay | divided_by: 100.0 }};
                    z-index: 1;
                  }
                {%- endif -%}
                {%- if block.settings.ultra_wide_background -%}
                  .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
                    max-width: calc(24rem + var(--page-width));
                  }
                  @media screen and (min-width: 990px) {
                    .ssky-text-block-{{ section.id }} .ssky-text-block__background {
                      padding-right: 120px;
                      padding-left: 120px;
                    }
                  }
                {%- elsif block.settings.wide_background -%}
                  .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
                    max-width: calc(14rem + var(--page-width));
                  }
                  @media screen and (min-width: 990px) {
                    .ssky-text-block-{{ section.id }} .ssky-text-block__background {
                      padding-right: 70px;
                      padding-left: 70px;
                    }
                  }
                {%- endif -%}
              {%- endstyle -%}
              {%- if block.settings.background_overlay > 0 -%}
                <div class="ssky-text-block__background-overlay"></div>
              {%- endif -%}
            {%- when 'checkbox_individual' -%}
              <div
                class="ssky-text-block__checkbox ssky-text-block__checkbox--individual left{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                <div class="rte">
                  {{ block.settings.text }}
                </div>
              </div>
            {%- when 'checkbox_with_icon' -%}
              <div
                class="ssky-text-block__checkbox ssky-text-block__checkbox--with-icon left{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                {%- if block.settings.icon != blank -%}
                  <div
                    class="ssky-text-block__icon{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <img src="{{ block.settings.icon | image_url: width: nil }}">
                  </div>
                {%- endif -%}
                <div>
                  <div class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}">
                    {{ block.settings.text }}
                  </div>
                  <div class="ssky-text-block__text rte{%- if block.settings.text_large %} text-body-large{%- endif -%}">
                    {{ block.settings.text_b }}
                  </div>
                </div>
              </div>
            {%- when 'checkbox' -%}
              {%- assign checkbox_block = true -%}
            {%- when 'highlights' -%}
              {%- assign highlights_block = true -%}
            {%- when 'button' -%}
              {% if block.settings.button_last %}
                {%- assign button_block = true -%}
              {% else %}
                {%- assign button_block = false -%}
                {%- if block.settings.product != blank -%}
                  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  {%- if block.settings.show_price -%}
                    <div class="ssky-text-block__price">
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                <div
                  class="ssky-text-block__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} ssky-text-block__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%- if block.settings.product != blank -%}
                    {%- render 'buy-buttons',
                      block: block,
                      product: block_product,
                      product_form_id: product_form_id,
                      section_id: section.id,
                      is_button_large: block.settings.button_large,
                      is_button_full: block.settings.button_full,
                      button_label: block.settings.product_button_label
                    -%}
                  {%- else -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
  {% if block.settings.button_link == blank %}
    role="link" aria-disabled="true"
  {% else %}
    href="{{ block.settings.button_link }}"
    {% if block.settings.button_link_new_window %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
  {% endif %}
  class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
>
  {{- block.settings.button_label | escape -}}
</a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_2 }}"
                        {% endif %}
                        class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if block.settings.text_below_buttons != blank -%}
                  <div class="ssky-text-block__text-below-buttons rte">
                    {{ block.settings.text_below_buttons }}
                  </div>
                {%- endif -%}                
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}
        {%- if checkbox_block == true -%}
          <div class="ssky-text-block__checkbox-con">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'checkbox' -%}
                  <div
                    class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    <div class="rte">
                      {{ block.settings.text }}
                    </div>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if highlights_block == true -%}
          <div class="ssky-text-block__highlights-con">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'highlights' -%}
                  <div
                    class="ssky-text-block__highlights{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {%- if block.settings.highlight_a != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_a }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_b != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_b }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_c != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_c }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_d != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_d }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_e != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_e }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_f != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_f }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_g != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_g }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_h != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_h }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_i != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_i }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_j != blank -%}
                      <div class="ssky-text-block__highlight">
                        <div class="rte">{{ block.settings.highlight_j }}</div>
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if text_button_split -%}</div>{%- endif -%}
        {%- if text_button_split -%}<div class="ssky-text-block__blocks">{%- endif -%}
        {%- if button_block == true -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'button' -%}
                {%- if block.settings.product != blank -%}
                  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
                  {%- assign block_product = block.settings.product -%}
                  {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
                  {%- if block.settings.show_price -%}
                    <div class="ssky-text-block__price">
                      {% render 'price', product: block_product, show_compare_at_price: true %}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                <div
                  class="ssky-text-block__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} ssky-text-block__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%- if block.settings.product != blank -%}
                    {%- render 'buy-buttons',
                      block: block,
                      product: block_product,
                      product_form_id: product_form_id,
                      section_id: section.id,
                      is_button_large: block.settings.button_large,
                      is_button_full: block.settings.button_full,
                      button_label: block.settings.product_button_label
                    -%}
                  {%- else -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if block.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link }}"
                        {% endif %}
                        class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if block.settings.button_label_2 != blank -%}
                      <a
                        {% if block.settings.button_link_2 == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_2 }}"
                        {% endif %}
                        class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{%- if block.settings.button_full %} button--full-width{%- endif -%}{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                      >
                        {{- block.settings.button_label_2 | escape -}}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- if block.settings.text_below_buttons != blank -%}
                  <div class="ssky-text-block__text-below-buttons rte">
                    {{ block.settings.text_below_buttons }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if text_button_split -%}</div>{%- endif -%}
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
    {%- if merging_with_section_below -%}
      </div>
      </div>
      <div
        class="ssky-text-block__layout-merging-color {%- if section.settings.merge_with_section_above %} ssky-text-block__layout-merging-above{%- endif -%}"
      ></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
