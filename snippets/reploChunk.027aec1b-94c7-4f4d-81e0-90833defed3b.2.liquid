="r-1gustxm" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-19br1vy" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Ramb2:"><div data-rid="350e71e7-0ae0-412d-9c1a-4be613fe6ef0" class="r-myc5bh"><div data-rid="76748e82-938c-4f9b-8368-b1199c92d922" class="r-1b2ewea alchemy-rte"><span style="width:100%"><p>These stories introduce kids to freedom-based ideas like critical thinking, economics, personal responsibility, entrepreneurship, and real-world history—wrapped up in fun, age-appropriate adventures.</p></span></div></div></div></div><div data-rid="7d5fb561-2845-4aae-a5fd-78f76ad407b8" class="r-1a4mm36" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="f2873048-a86f-40ee-af37-3be55631fa42" aria-expanded="false" aria-controls="replo-:Remb2:" tabindex="0" role="button" class="r-1pklcd2"><div data-rid="9b995591-b2da-4990-a40d-8699bff1581f" class="r-5lxydw alchemy-rte"><span style="width:100%"><p>Are the activity workbooks downloadable or printed?</p></span></div><div data-rid="07309cca-4999-4e54-9564-b507654ecd1b" class="r-b9qfvq" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1c9vjfn" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Remb2:"><div data-rid="b136a3bc-8365-40dc-ac17-68fb1960926a" class="r-q8cfz1"><div data