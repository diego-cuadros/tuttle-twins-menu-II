{%- liquid
  assign show_as_card = false
  if section.settings.show_as_card == true
    assign show_as_card = true
  endif
-%}
{%- style -%}
  .ssky-text-block-{{ section.id }} .ssky-text-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .ssky-text-block-{{ section.id }} .ssky-text-block__blocks > *:not(.ssky-text-block__divider) {
    max-width: 60rem;
  }
  @media screen and (min-width: 750px) {
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .ssky-text-block-{{ section.id }} .ssky-text-block__blocks > *:not(.ssky-text-block__divider, .ssky-text-block__buttons) {
      max-width: 88rem;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-text-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-text-block-{{ section.id }} .ssky-text-block__wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-text-block-{{ section.id }}">
  <div class="ssky-text-block content-container color-{{ section.settings.color_scheme }} gradient">
    {%- if show_as_card -%}<div class="page-width">{%- endif -%}
    <div class="ssky-text-block__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-text-block__blocks center">
        {%- for graphic_novels_start_collection in shop.metaobjects.graphic_novels_start_collection.values limit: 1 -%}
          {%- assign heading_length = graphic_novels_start_collection.heading | metafield_text | size -%}
          <h2
            class="ssky-text-block__heading rte h2 weight-semibold{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 1"
            {% endif %}
          >
            {{ graphic_novels_start_collection.heading }}
          </h2>
          <div
            class="ssky-text-block__text rte text-large{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 2"
            {% endif %}
          >
            {{ graphic_novels_start_collection.description | metafield_tag }}
          </div>
          {%- if graphic_novels_start_collection.link_add_to_cart_button != blank -%}
            {%- assign section_product = graphic_novels_start_collection.link_add_to_cart_button.value -%}
            {%- assign product_form_id = 'product-form-' | append: section.id | append: section_product.id -%}
            <div
              class="ssky-text-block__buttons{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: 3"
              {% endif %}
            >
              {%- render 'buy-buttons',
                product: section_product,
                product_form_id: product_form_id,
                section_id: section.id,
                button_label: graphic_novels_start_collection.add_to_cart_button_label
              -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TTm Graphic novels coll.",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Graphic novels coll."
    }
  ]
}
{% endschema %}
