</p>

<script>
function getOrdinal(n) {
  let s = ["th","st","nd","rd"],
      v = n % 100;
  return n + (s[(v-20)%10] || s[v] || s[0]);
}

function formatDate(date) {
  const month = date.toLocaleString('en-US', { month: 'long' });
  const day = getOrdinal(date.getDate());
  return `${month} ${day}`;
}

let today = new Date();

let startDate = new Date();
startDate.setDate(today.getDate() + 0);

let endDate = new Date();
endDate.setDate(today.getDate() + 1);

document.getElementById("start-date").innerText = formatDate(startDate);
document.getElementById("end-date").innerText = formatDate(endDate);
</script></div></div></div><button data-rid="cef7f790-e890-4f1e-b34a-5455524ab5a7" data-replo-add-product-variant-to-cart="" tabindex="0" role="button" class="text r-1r1o9yj alchemy-rte"><div data-rid="6514665f-2377-45eb-9ac0-9c1d2cd931b2" class="r-1900lpi alchemy-rte"><span style="width:100%"><p>Add To Cart</p></span></div></button><div data-rid="1ec9f77b-829f-4e34-8108-fea5abbc1cd3" class="r-1rz2lg3"><div data-rid="daa47465-397a-4536-8b14-79bd747e36a5" class="r-g9li5i"><picture data-rid="90237a98-4031-4cd4-bb9b-b497d21e23d6" class="r-1w4phi5"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/bc419613-3001-4d4a-bcfd-dab6d6029761?width=36" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/bc419613-3001-4d4a-bcfd-dab6d6029761?width=36" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/bc419613-3001-4d4a-bcfd-dab6d6029761?width=36" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/bc419613-3001-4d4a-bcfd-dab6d6029761" class="r-1o6801j" loading="eager"/></picture><div data-rid="62d9b1e0-b43d-463a-945a-7a84f3d6b2c3" class="r-1jpt94h alchemy-rte"><span style="width:100%"><p>100% Money-Back Guarantee</p></span></div></div><div data-rid="ca74e091-4f2c-48f9-b855-9747980ab4cf" class="r-g0kk7y"><picture data-rid="b98a20b1-687a-4ae3-b8bf-0541180a8fb7" class="r-fnn5h9"><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/27424fd6-0eae-4463-8000-d5d126cb2bc8?width=36" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8bd9d26aa/27424fd6-0eae-4463-8000-d5d126cb2bc8?width=36" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/39afbdbf-870a-4720-a8f6-e9e8