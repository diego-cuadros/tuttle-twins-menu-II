{% doc %}
  @prompt
    I need an exact copy of the TT Courses block., This is great! Instead of buttons, can you make a listicle of urls that will be pop up videos when clicked?, Go back to the original version., Let's start over. I need an exact copy of the TT Courses block., Great. Instead of the Button Text and Button URL, can you make a button for a popup modal that displays an embedded video?, Can you make the courses in a slider instead of two rows? There should be left and right buttons on either side to move through any extra courses that aren't on the first page, I'd like for it to be able to scroll continuously. So once you get to the 6th course, you can just slide right to the first one, Only make it scrollable to the end of the 6th. Then they'll have to scroll back left to get back to the first slide, On mobile, can you make the slider buttons on the bottom so the column isn't so squished?, I need buttons on mobile at the bottom of the block to scroll left and right, I need there to be buttons at the bottom of the block for the mobile view so people can scroll left and right, The shadow in the background of the cards are squared off and not rounded so it looks funny. Like it's cut off

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .tt-courses-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .tt-courses__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .tt-courses__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin-bottom: 16px;
    color: {{ block.settings.heading_color }};
  }

  .tt-courses__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    max-width: 800px;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .tt-courses__slider-container-{{ ai_gen_id }} {
    position: relative;
    padding: 0 50px;
  }

  .tt-courses__slider-{{ ai_gen_id }} {
    display: flex;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    gap: 25px;
    padding-top: 10px;
  }

  .tt-course-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    width: calc(33.333% - 20px);
    min-width: calc(33.333% - 20px);
  }

  .tt-course-card-{{ ai_gen_id }} {
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background_color }};
    transition: transform 0.3s ease;
    height: 98%;
    width: 98%;
    display: flex;
    flex-direction: column;
    /* Apply box-shadow to match border radius */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .tt-course-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .tt-course-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    position: relative;
    overflow: hidden;
  }

  .tt-course-card__image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tt-course-card__image-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;background-color: #f4f4f4;
  }

  .tt-course-card__content-{{ ai_gen_id }} {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .tt-course-card__title-{{ ai_gen_id }} {
    font-size: 20px;
    margin-bottom: 10px;
    color: {{ block.settings.card_title_color }};
    text-align: center;
  }

  .tt-course-card__description-{{ ai_gen_id }} {
    font-size: 14px;
    margin-bottom: 20px;
    color: {{ block.settings.card_text_color }};
    flex-grow: 1;
  }

  .tt-course-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    text-align: center;
    transition: background-color 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .tt-course-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--prev {
    left: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--next {
    right: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }

  /* Modal styles */
  .tt-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tt-modal-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .tt-modal__content-{{ ai_gen_id }} {
    position: relative;
    width: 90%;
    max-width: 800px;
    background-color: #fff;
    border-radius: 8px;
    overflow: hidden;
  }

  .tt-modal__close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    z-index: 10;
    border: none;
  }

  .tt-modal__video-container-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
  }

  .tt-modal__video-container-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (max-width: 990px) {
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 15px);
      width: calc(50% - 15px);
      min-width: calc(50% - 15px);
    }
  }

  @media screen and (max-width: 749px) {
    .tt-courses__slider-container-{{ ai_gen_id }} {
      padding: 0;
    }
    
    .tt-courses__nav-button-{{ ai_gen_id }} {
      display: none; /* Hide side buttons on mobile */
    }
    
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
      display: flex; /* Show bottom buttons on mobile */
    }
    
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
    }

    .tt-courses__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | minus: 6 }}px;
    }

    .tt-courses__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | minus: 2 }}px;
    }
    
    /* Ensure mobile nav buttons are properly styled */
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} .tt-courses__nav-button-{{ ai_gen_id }} {
      display: flex;
      position: static;
      transform: none;
      margin: 0 5px;
    }
  }
{% endstyle %}

<div class="tt-courses-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="page-width">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="tt-courses__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="tt-courses__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="tt-courses__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="tt-courses__slider-container-{{ ai_gen_id }}">
      <button 
        class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--prev" 
        aria-label="Previous slide"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="tt-courses__slider-{{ ai_gen_id }}">
        {% comment %} Create an array of enabled courses {% endcomment %}
        {% assign enabled_courses = '' %}
        {% for i in (1..6) %}
          {% assign course_enabled_key = 'course_' | append: i | append: '_enabled' %}
          {% if block.settings[course_enabled_key] %}
            {% assign enabled_courses = enabled_courses | append: i | append: ',' %}
          {% endif %}
        {% endfor %}
        
        {% assign enabled_courses_array = enabled_courses | split: ',' %}
        {% assign total_enabled_courses = enabled_courses_array.size %}

        {% comment %} Display courses {% endcomment %}
        {% for i in (1..6) %}
          {% assign course_enabled_key = 'course_' | append: i | append: '_enabled' %}
          {% assign course_image_key = 'course_' | append: i | append: '_image' %}
          {% assign course_title_key = 'course_' | append: i | append: '_title' %}
          {% assign course_description_key = 'course_' | append: i | append: '_description' %}
          {% assign course_button_text_key = 'course_' | append: i | append: '_button_text' %}
          {% assign course_video_url_key = 'course_' | append: i | append: '_video_url' %}

          {% if block.settings[course_enabled_key] %}
            <div class="tt-course-slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
              <div class="tt-course-card-{{ ai_gen_id }}">
                <div class="tt-course-card__image-{{ ai_gen_id }}">
                  {% if block.settings[course_image_key] %}
                    <img 
                      src="{{ block.settings[course_image_key] | image_url: width: 600 }}" 
                      alt="{{ block.settings[course_title_key] }}"
                      loading="lazy"
                      width="{{ block.settings[course_image_key].width }}"
                      height="{{ block.settings[course_image_key].height }}"
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="tt-course-card__content-{{ ai_gen_id }}">
                  <h3 class="tt-course-card__title-{{ ai_gen_id }}">{{ block.settings[course_title_key] }}</h3>
                  <div class="tt-course-card__description-{{ ai_gen_id }}">{{ block.settings[course_description_key] }}</div>
                  {% if block.settings[course_button_text_key] != blank and block.settings[course_video_url_key] != blank %}
                    <button 
                      class="tt-course-card__button-{{ ai_gen_id }}" 
                      data-modal-trigger="{{ ai_gen_id }}-{{ i }}"
                      aria-label="Open video for {{ block.settings[course_title_key] }}"
                    >
                      {{ block.settings[course_button_text_key] }}
                    </button>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button 
        class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--next" 
        aria-label="Next slide"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      
      <!-- Mobile navigation buttons (at bottom) -->
      <div class="tt-courses__nav-buttons-mobile-{{ ai_gen_id }}">
        <button 
          class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--prev-mobile" 
          aria-label="Previous slide"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        
        <button 
          class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--next-mobile" 
          aria-label="Next slide"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Video Modals -->
{% for i in (1..6) %}
  {% assign course_enabled_key = 'course_' | append: i | append: '_enabled' %}
  {% assign course_title_key = 'course_' | append: i | append: '_title' %}
  {% assign course_video_url_key = 'course_' | append: i | append: '_video_url' %}

  {% if block.settings[course_enabled_key] and block.settings[course_video_url_key] != blank %}
    <div id="modal-{{ ai_gen_id }}-{{ i }}" class="tt-modal-{{ ai_gen_id }}">
      <div class="tt-modal__content-{{ ai_gen_id }}">
        <button class="tt-modal__close-{{ ai_gen_id }}" data-modal-close="{{ ai_gen_id }}-{{ i }}" aria-label="Close video">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M1 1L13 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="tt-modal__video-container-{{ ai_gen_id }}" data-video-container="{{ ai_gen_id }}-{{ i }}" data-video-url="{{ block.settings[course_video_url_key] }}">
          <!-- Video will be loaded here via JavaScript -->
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}

<script>
  (function() {
    const slider = document.querySelector('.tt-courses__slider-{{ ai_gen_id }}');
    const prevButton = document.querySelector('.tt-courses__nav-button-{{ ai_gen_id }}--prev');
    const nextButton = document.querySelector('.tt-courses__nav-button-{{ ai_gen_id }}--next');
    const prevButtonMobile = document.querySelector('.tt-courses__nav-button-{{ ai_gen_id }}--prev-mobile');
    const nextButtonMobile = document.querySelector('.tt-courses__nav-button-{{ ai_gen_id }}--next-mobile');
    const slides = document.querySelectorAll('.tt-course-slide-{{ ai_gen_id }}');
    
    if (!slides.length) return;
    
    let currentIndex = 0;
    let slidesPerView = 3;
    let slideWidth = 0;
    let totalSlides = slides.length;
    
    // Update slidesPerView based on screen width
    function updateSlidesPerView() {
      if (window.innerWidth <= 749) {
        slidesPerView = 1;
      } else if (window.innerWidth <= 990) {
        slidesPerView = 2;
      } else {
        slidesPerView = 3;
      }
      
      // Calculate slide width
      slideWidth = (slider.clientWidth - ((slidesPerView - 1) * 30)) / slidesPerView;
      
      // Update navigation buttons state
      updateNavButtons();
    }
    
    // Scroll to specific slide
    function scrollToSlide(index) {
      if (index < 0) {
        index = 0;
      } else if (index > totalSlides - slidesPerView) {
        index = totalSlides - slidesPerView;
      }
      
      currentIndex = index;
      const scrollPosition = index * (slideWidth + 30);
      slider.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });
      
      updateNavButtons();
    }
    
    // Update navigation buttons state (enable/disable)
    function updateNavButtons() {
      // Update both desktop and mobile buttons
      const allPrevButtons = [prevButton, prevButtonMobile];
      const allNextButtons = [nextButton, nextButtonMobile];
      
      // Disable prev button if at the beginning
      if (currentIndex <= 0) {
        allPrevButtons.forEach(btn => {
          if (btn) {
            btn.classList.add('disabled');
            btn.setAttribute('aria-disabled', 'true');
          }
        });
      } else {
        allPrevButtons.forEach(btn => {
          if (btn) {
            btn.classList.remove('disabled');
            btn.setAttribute('aria-disabled', 'false');
          }
        });
      }
      
      // Disable next button if at the end
      if (currentIndex >= totalSlides - slidesPerView) {
        allNextButtons.forEach(btn => {
          if (btn) {
            btn.classList.add('disabled');
            btn.setAttribute('aria-disabled', 'true');
          }
        });
      } else {
        allNextButtons.forEach(btn => {
          if (btn) {
            btn.classList.remove('disabled');
            btn.setAttribute('aria-disabled', 'false');
          }
        });
      }
    }
    
    // Initialize slider
    function initSlider() {
      updateSlidesPerView();
      
      // Event listeners for desktop buttons
      if (prevButton) {
        prevButton.addEventListener('click', () => {
          if (!prevButton.classList.contains('disabled')) {
            scrollToSlide(currentIndex - 1);
          }
        });
      }
      
      if (nextButton) {
        nextButton.addEventListener('click', () => {
          if (!nextButton.classList.contains('disabled')) {
            scrollToSlide(currentIndex + 1);
          }
        });
      }
      
      // Event listeners for mobile buttons
      if (prevButtonMobile) {
        prevButtonMobile.addEventListener('click', () => {
          if (!prevButtonMobile.classList.contains('disabled')) {
            scrollToSlide(currentIndex - 1);
          }
        });
      }
      
      if (nextButtonMobile) {
        nextButtonMobile.addEventListener('click', () => {
          if (!nextButtonMobile.classList.contains('disabled')) {
            scrollToSlide(currentIndex + 1);
          }
        });
      }
      
      // Handle window resize
      window.addEventListener('resize', () => {
        updateSlidesPerView();
        
        // Ensure we're not scrolled past the end after resize
        if (currentIndex > totalSlides - slidesPerView) {
          scrollToSlide(totalSlides - slidesPerView);
        }
      });
      
      // Handle scroll end to update current index
      slider.addEventListener('scroll', () => {
        clearTimeout(slider.scrollEndTimer);
        slider.scrollEndTimer = setTimeout(() => {
          // Calculate current index based on scroll position
          currentIndex = Math.round(slider.scrollLeft / (slideWidth + 30));
          updateNavButtons();
        }, 100);
      });
    }
    
    // Initialize slider when DOM is loaded
    if (slider && slides.length > 0) {
      initSlider();
    }
    
    // Modal functionality
    const modalTriggers = document.querySelectorAll('[data-modal-trigger]');
    const modalCloseButtons = document.querySelectorAll('[data-modal-close]');
    const videoContainers = document.querySelectorAll('[data-video-container]');
    
    // Function to extract YouTube ID from URL
    function getYoutubeId(url) {
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : null;
    }
    
    // Function to extract Vimeo ID from URL
    function getVimeoId(url) {
      const regExp = /^.*(vimeo\.com\/)((channels\/[A-z]+\/)|(groups\/[A-z]+\/videos\/))?([0-9]+)/;
      const match = url.match(regExp);
      return match ? match[5] : null;
    }
    
    // Function to create embed iframe based on URL
    function createVideoEmbed(url) {
      const youtubeId = getYoutubeId(url);
      if (youtubeId) {
        return `<iframe src="https://www.youtube.com/embed/${youtubeId}?autoplay=1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
      }
      
      const vimeoId = getVimeoId(url);
      if (vimeoId) {
        return `<iframe src="https://player.vimeo.com/video/${vimeoId}?autoplay=1" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
      }
      
      // If not YouTube or Vimeo, try to embed as generic video
      return `<iframe src="${url}" allowfullscreen></iframe>`;
    }
    
    // Open modal and load video
    modalTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-trigger');
        const modal = document.getElementById(`modal-${modalId}`);
        const videoContainer = modal.querySelector('[data-video-container]');
        const videoUrl = videoContainer.getAttribute('data-video-url');
        
        // Load the video only when opening the modal
        videoContainer.innerHTML = createVideoEmbed(videoUrl);
        
        // Show modal
        modal.classList.add('active');
        document.body.style.overflow = 'hidden'; // Prevent scrolling
      });
    });
    
    // Close modal and stop video
    modalCloseButtons.forEach(button => {
      button.addEventListener('click', () => {
        const modalId = button.getAttribute('data-modal-close');
        const modal = document.getElementById(`modal-${modalId}`);
        const videoContainer = modal.querySelector('[data-video-container]');
        
        // Clear the video to stop playback
        videoContainer.innerHTML = '';
        
        // Hide modal
        modal.classList.remove('active');
        document.body.style.overflow = ''; // Restore scrolling
      });
    });
    
    // Close modal when clicking outside content
    document.addEventListener('click', (event) => {
      if (event.target.classList.contains(`tt-modal-{{ ai_gen_id }}`)) {
        const modal = event.target;
        const videoContainer = modal.querySelector('[data-video-container]');
        
        // Clear the video to stop playback
        videoContainer.innerHTML = '';
        
        // Hide modal
        modal.classList.remove('active');
        document.body.style.overflow = ''; // Restore scrolling
      }
    });
    
    // Close modal with Escape key
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const activeModal = document.querySelector(`.tt-modal-{{ ai_gen_id }}.active`);
        if (activeModal) {
          const videoContainer = activeModal.querySelector('[data-video-container]');
          
          // Clear the video to stop playback
          videoContainer.innerHTML = '';
          
          // Hide modal
          activeModal.classList.remove('active');
          document.body.style.overflow = ''; // Restore scrolling
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "TT Courses",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Our Courses"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section description",
      "default": "<p>Explore our educational courses designed for children and families to learn important concepts in a fun and engaging way.</p>"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
