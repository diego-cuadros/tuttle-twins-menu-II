{%- if block.settings.youtube_id != blank -%}
 {%- style -%}
    .banner__content-video-{{block.id}} {
      margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }  
    @media screen and (min-width: 750px) {
      .banner__content-video-{{block.id}} {
        margin-top: {{ block.settings.margin_top }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
    }
    {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.banner__content-video-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
  {%- endstyle -%}
  <div class="banner__content-video banner__content-video-{{block.id}}">
    <div class="banner__video-container">
      <iframe 
        width="100%"
        height="100%"
        src="https://www.youtube.com/embed/{{ block.settings.youtube_id }}?rel=0&showinfo=0&controls=1&autoplay={{ block.settings.autoplay }}" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
        allowfullscreen
        title="YouTube video"
      ></iframe>
    </div>
  </div>
{%- endif -%}
{% schema %}
  {
    "name": "YouTube Video",
    "settings": [
      {
        "type": "text",
        "id": "youtube_id",
        "label": "YouTube Video ID",
        "info": "The part after v= in the YouTube URL (e.g., dQw4w9WgXcQ)"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay video",
        "default": false,
        "info": "Note: Autoplay may not work on all devices due to browser restrictions"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "YouTube Video" }
    ]
  }
{% endschema %}