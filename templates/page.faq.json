        "faq_Ez6tpb": {
          "type": "faq",
          "settings": {
            "text": "<p>How do I purchase more than one magazine subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Order once, creating an account…..after checking out, go to my-account and sign in to your new account. After logging in, go to <a href=\"/pages/magazine\" title=\"A Monthly Magazine for Curious Kids\">https://tuttletwins.com/pages/magazine</a> and purchase another subscription.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_7qGdTp": {
          "type": "faq",
          "settings": {
            "text": "<p>Does my Tuttle Times magazine subscription auto-renew?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes, but if you would like it to NOT auto-renew please email us so we can set it to manually renew.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_jjfJzB": {
          "type": "faq",
          "settings": {
            "text": "<p>How do I access the Tuttle Times Plus Pack?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>You will receive an email each month with the Plus Pack or you can login on this website for access. </p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_niJNjd": {
          "type": "faq",
          "settings": {
            "text": "<p>As a Tuttle Times Plus Pack subscriber, how do I access the PDFs of past issues?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>You can login on this website for access to all the past issues. </p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_tdhYqQ": {
          "type": "faq",
          "settings": {
            "text": "<p>How do I upgrade my Tuttle Times magazine subscription to receive the Plus Pack?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<ol><li>Log in to your account<br/>Log in to your account. (If you don’t recall your password, click “Forgot Your Password” and follow the prompts.<br/>Then click the “manage your subscription” link in the last sentence.<br/><br/></li><li>Review your subscription<br/>On this page you can see your magazine subscription. Click on the subscription number to edit it.<br/><br/></li><li>Click “Upgrade or Downgrade” button<br/>Scroll down to the “Subscription totals” section and hit the button that says “Upgrade or Downgrade.”<br/><br/></li><li>Select the Magazine PLUS option<br/>You will be taken to the magazine product page. From there, select Magazine PLUS then click the “Switch Subscription” button.<br/><br/></li><li>Follow the remaining instructions<br/>Depending on the time you do this during your subscription, you may see a prorated amount being applied from your previous magazine subscription.</li></ol>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_rzRGLn": {
          "type": "faq",
          "settings": {
            "text": "<p>Can I purchase the magazine as an international customer?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>You may purchase the Plus subscription as an international customer, but you will need to send the physical magazine to someone in the United States.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_x98WpJ": {
          "type": "faq",
          "settings": {
            "text": "<p>How do I change or cancel my Tuttle Times magazine subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>You can email us at <a href=\"mailto:info@tuttletwins.com\" target=\"_blank\" title=\"mailto:info@tuttletwins.com\">info@tuttletwins.com</a> to update the status of your subscription or you may log in to your account </p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        }
      },
