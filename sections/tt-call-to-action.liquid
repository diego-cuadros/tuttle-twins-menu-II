{{ 'ssky-product-order-block.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign show_as_card = false
  assign narrow_width = false
  if section.settings.show_as_card == true
    assign show_as_card = true
    if section.settings.narrow_width == true
      assign narrow_width = true
    endif
  endif
-%}
{%- style -%}
  .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block__order-block {
    max-width: 60rem;
  }
  @media screen and (min-width: 750px) {
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block__order-block {
      max-width: {{ section.settings.max_width }}rem;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-pdorder-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-pdorder-block-{{ section.id }} .ssky-pdorder-block__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-pdorder-block-{{ section.id }}">
  <div class="ssky-pdorder-block content-container color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
    {%- if show_as_card -%}
      <div class="page-width">
    {%- endif -%}
    <div class="ssky-pdorder-block__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-text-block__blocks {{ section.settings.content_alignment }}">
        <div class="ssky-pdorder-block__order-block ssky-pdorder-block__order-block--three">
            <div class="ssky-pdorder-block__order-block-left ssky-text-block__blocks">
                {%- if section.settings.heading != blank -%}
                {%- assign heading_length = section.settings.heading | metafield_text | size -%}
                <h2
                    class="ssky-text-block__heading rte h3 weight-semibold{%- if heading_length > 35 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                >
                    {{ section.settings.heading }}
                </h2>
                {%- endif -%}
                {%- if section.settings.description != blank -%}
                <div
                    class="ssky-text-block__text rte text-medium{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                >
                    <div class="rte">
                    {{ section.settings.description | metafield_tag }}
                    </div>
                </div>
                {%- endif -%}
                {%- if section.settings.button_label != blank -%}
                <div
                    class="ssky-text-block__buttons{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                >
                    {%- assign section_product = section.settings.product -%}
                    {%- assign product_form_id = 'product-form-' | append: section.id | append: section_product.id -%}
                    {%- render 'buy-buttons',
                    product: section_product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    button_label: section.settings.button_label
                    -%}
                </div>
                {%- endif -%}
                {%- if section.settings.text_below_button != blank -%}
                <div class="ssky-text-block__text weight-medium rte">
                    {{ section.settings.text_below_button }}
                </div>
                {%- endif -%}
            </div>
            <div class="ssky-pdorder-block__order-block-right ssky-text-block__blocks">
                <div
                class="ssky-pdorder-block__price{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                {% endif %}
                >
                <div class="ssky-pdorder-block__price-compare">
                    {%- if section.settings.price_label != blank -%}
                    <div>{{ section.settings.price_label }}</div>
                    {%- endif -%}
                    {% render 'price', product: section_product, show_compare_at_price: true, hide_currency_code: true %}
                </div>
                <div class="ssky-pdorder-block__price-regular">
                    {% render 'price', product: section_product, show_compare_at_price: true, hide_currency_code: true %}
                </div>
                </div>
            </div>
        </div> 
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TT Call to action",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },  
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "richtext",
      "id": "text_below_button",
      "label": "Text below button"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "For Only"
    },
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 72,
      "max": 120,
      "step": 1,
      "label": "t:sections.ssky_text_block.settings.max_width.label",
      "default": 120
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.extension.narrow",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.custom_class.header"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_class.label",
      "info": "t:sections.all.custom_class.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TT Call to action"
    }
  ]
}
{% endschema %}
