{{ 'ssky-product-breakdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign show_as_card = false
  assign narrow_width = false
  if section.settings.show_as_card == true
    assign show_as_card = true
    if section.settings.narrow_width == true
      assign narrow_width = true
    endif
  endif
-%}
{%- style -%}
  .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-product-breakdown-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
  {%- if show_as_card -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown__wrapper {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      border-radius: 45px;
    }
    @media screen and (min-width: 750px) {
      .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown__wrapper {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if narrow_width -%}
    .ssky-product-breakdown-{{ section.id }} .ssky-product-breakdown__wrapper {
      max-width: 1100px;
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-product-breakdown-{{ section.id }}">
  <div class="ssky-product-breakdown content-container color-{{ section.settings.color_scheme }} gradient">
    {%- if show_as_card -%}<div class="page-width">{%- endif -%}
    <div class="ssky-product-breakdown__wrapper ssky-text-block__wrapper page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
      <div class="ssky-product-breakdown__product center">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'product' -%}
              {%- assign block_product = block.settings.product -%}
              {%- assign product_form_id = 'product-form-' | append: section.id | append: block_product.id -%}
              <div
                class="ssky-text-block__blocks{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div
                  class="ssky-product-breakdown__image media{%- if block.settings.image_fit %} image-fit{%- endif -%}"
                  {%- if block.settings.image != blank -%}
                    style="padding-bottom:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 120 }}%;"
                  {%- elsif block_product != blank -%}
                    style="padding-bottom:{{ 1 | divided_by: block_product.featured_image.aspect_ratio | times: 100 | at_most: 120 }}%;"
                  {%- else -%}
                    style="padding-bottom:100%;"
                  {%- endif -%}
                >
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 560 | image_tag }}
                  {%- elsif block_product != blank -%}
                    {{ block_product.featured_image | image_url: width: 560 | image_tag }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>

                <div class="ssky-product-breakdown__price">
                  {%- if block.settings.price != blank -%}
                    {{ block.settings.price }}
                  {%- else -%}
                    {% render 'price', product: block_product, show_compare_at_price: true %}
                  {%- endif -%}
                </div>

                {%- if block.settings.button_link != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{%- if block.settings.button_large %} button--large{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- else -%}
                  {%- render 'buy-buttons',
                    block: block,
                    product: block_product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    is_product_column: true,
                    is_button_large: block.settings.button_large,
                    button_label: block.settings.button_label
                  -%}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="ssky-product-breakdown__content ssky-text-block__blocks {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'caption' -%}
              <div
                class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.caption | escape }}
              </div>
            {%- when 'heading' -%}
              {%- assign heading_length = block.settings.heading | size -%}
              <h2
                class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div
                class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="rte" style="max-width:{{ block.settings.max_width }}rem;">
                  {{ block.settings.text }}
                </div>
              </div>
            {%- when 'highlights' -%}
              {%- assign highlights_block = true -%}
            {%- when 'checkbox' -%}
              <div
                class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                <div class="rte">
                  {{ block.settings.text }}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if highlights_block == true -%}
          <div class="ssky-text-block__highlights-con">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'highlights' -%}
                  <div
                    class="ssky-text-block__highlights{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {%- if block.settings.highlight_a != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_a }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_b != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_b }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_c != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_c }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_d != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_d }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_e != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_e }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_f != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_f }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_g != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_g }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.highlight_h != blank -%}
                      <div class="ssky-text-block__highlight">
                        <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
                        <div class="rte">{{ block.settings.highlight_h }}</div>
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if show_as_card -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "TT Product breakdown",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 72,
      "max": 120,
      "step": 1,
      "label": "t:sections.ssky_text_block.settings.max_width.label",
      "default": 100
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.extension.narrow",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "image_fit",
          "label": "Switch between image fill or fit.",
          "default": true,
          "info": "Fill covers the container, while fit fits within the container."
        },
        {
          "type": "header",
          "content": "Overwrite Product Info"
        },
        {
          "type": "paragraph",
          "content": "Product info will be pre-filled. If you need to overwrite it, add the details below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overwrite the product's featured image."
        },
        {
          "type": "inline_richtext",
          "id": "price",
          "label": "Price",
          "info": "Overwrite the product price."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_label.label",
          "default": "Buy the book",
          "info": "Overwrite the buy now button label."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_link.label",
          "info": "Overwrite the buy now button link."
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_style_secondary.label",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "button_large",
          "default": false,
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_large.label"
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.ssky_text_block.blocks.caption.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "t:sections.ssky_text_block.blocks.caption.settings.text.default",
          "label": "t:sections.ssky_text_block.blocks.caption.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "small-semibold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__0.label"
            },
            {
              "value": "small-bold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__1.label"
            },
            {
              "value": "medium-semibold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__2.label"
            },
            {
              "value": "large-semibold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__3.label"
            },
            {
              "value": "large-bold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__4.label"
            },
            {
              "value": "extra-large-bold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__5.label"
            },
            {
              "value": "extra-extra-large-bold",
              "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.options__6.label"
            }
          ],
          "default": "small-bold",
          "label": "t:sections.ssky_text_block.blocks.caption.settings.text_style.label",
          "info": "t:sections.ssky_text_block.blocks.caption.settings.text_style.info"
        },
        {
          "type": "text",
          "id": "color_class",
          "label": "t:sections.all.ssky_color_class.label",
          "default": "t:sections.all.ssky_color_class.default",
          "info": "t:sections.all.ssky_color_class.info"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.ssky_text_block.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "t:sections.ssky_text_block.blocks.heading.settings.heading.label",
          "default": "t:sections.ssky_text_block.blocks.heading.settings.heading.default"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h4",
              "label": "t:sections.all.heading_size.options__0.label"
            },
            {
              "value": "h3",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h4",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "select",
          "id": "heading_weight",
          "options": [
            {
              "value": "medium",
              "label": "t:sections.all.heading_weight.options__1.label"
            },
            {
              "value": "semibold",
              "label": "t:sections.all.heading_weight.options__2.label"
            },
            {
              "value": "bold",
              "label": "t:sections.all.heading_weight.options__3.label"
            }
          ],
          "default": "semibold",
          "label": "t:sections.all.heading_weight.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.ssky_text_block.blocks.text.name",
      "limit": 6,
      "settings": [
        {
          "type": "range",
          "id": "max_width",
          "min": 64,
          "max": 120,
          "step": 1,
          "label": "t:sections.ssky_text_block.blocks.text.settings.max_width.label",
          "default": 100,
          "info": "t:sections.ssky_text_block.blocks.text.settings.max_width.info"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.ssky_text_block.blocks.text.settings.text.label",
          "default": "t:sections.ssky_text_block.blocks.text.settings.text.default"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "regular",
              "label": "t:sections.all.text_size.options__0.label"
            },
            {
              "value": "medium",
              "label": "t:sections.all.text_size.options__1.label"
            },
            {
              "value": "large",
              "label": "t:sections.all.text_size.options__2.label"
            },
            {
              "value": "extra-large",
              "label": "t:sections.all.text_size.options__3.label"
            }
          ],
          "default": "regular",
          "label": "t:sections.all.text_size.label"
        },
        {
          "type": "select",
          "id": "text_weight",
          "options": [
            {
              "value": "regular",
              "label": "t:sections.all.text_weight.options__0.label"
            },
            {
              "value": "medium",
              "label": "t:sections.all.text_weight.options__1.label"
            },
            {
              "value": "semibold",
              "label": "t:sections.all.text_weight.options__2.label"
            },
            {
              "value": "bold",
              "label": "t:sections.all.text_weight.options__3.label"
            }
          ],
          "default": "regular",
          "label": "t:sections.all.text_weight.label"
        }
      ]
    },
    {
      "type": "highlights",
      "name": "t:sections.ssky_text_block.blocks.highlight.name",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "highlight_a",
          "label": "t:sections.ssky_text_block.blocks.highlight.settings.label",
          "default": "t:sections.ssky_text_block.blocks.highlight.settings.default"
        },
        {
          "type": "richtext",
          "id": "highlight_b",
          "label": "t:sections.ssky_text_block.blocks.highlight.settings.label",
          "default": "t:sections.ssky_text_block.blocks.highlight.settings.default"
        },
        {
