    "ssky_faqs_6m96qr": {
      "type": "ssky-faqs",
      "blocks": {
        "heading_JpMTBM": {
          "type": "heading",
          "settings": {
            "heading": "<p>Frequently Asked Questions</p>",
            "heading_size": "h1",
            "heading_weight": "bold"
          }
        },
        "faq_MMqWEV": {
          "type": "faq",
          "settings": {
            "text": "<p>What ages are the Tuttle Twins book series appropriate for?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>The Tuttle Twins books are generally best for ages 5–12, though younger kids enjoy them as read-alouds and older teens often dive deeper into the ideas.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_yxY6JD": {
          "type": "faq",
          "settings": {
            "text": "<p>Do the Tuttle Twins books need to be read in order?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Nope! We ship them in order, but each story stands on its own—so your child can jump in anywhere.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_p4ENRB": {
          "type": "faq",
          "settings": {
            "text": "<p>What do I get each month with my subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Each month, your child receives two Tuttle Twins books—delivered in order—packed with fun stories and big ideas.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_PCQeCn": {
          "type": "faq",
          "settings": {
            "text": "<p>Can I purchase the books without a subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes! You can absolutely buy the books individually or in bundles without subscribing. The subscription is just a convenient option for receiving two books each month in order—but all titles are also available for one-time purchase.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_Qa4Ftj": {
          "type": "faq",
          "settings": {
            "text": "<p>How can I continue the series after canceling my subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>If you’d like to restart your subscription after already receiving a few months, just reach out to our customer service team at <a><strong>info@tuttletwins.com</strong></a> and we’ll help you pick back up. If you prefer to not re-subscribe, you can purchase the next books in the series as one-time buys.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_xhTgdi": {
          "type": "faq",
          "settings": {
            "text": "<p>How easy is it to cancel my subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes! It’s super easy to unsubscribe. Please email info@tuttletwins.com or login to your Tuttle Twins account page and click “Manage subscriptions” to update your settings. </p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_g7ApaH": {
          "type": "faq",
          "settings": {
            "text": "<p>How Does the Tuttle Twins Book Subscription Work?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Once you sign up, you’ll receive new books from the Tuttle Twins series each month. Every book is designed to be age-appropriate and packed with lessons that teach kids about freedom, responsibility, merit, and economics, to name a few.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        },
        "faq_9LbBBR": {
          "type": "faq",
          "settings": {
            "text": "<p>Can I Gift a Tuttle Twins Book Subscription?</p>",
            "text_size": "medium",
            "text_weight": "bold",
            "answer": "<p>Yes, our book subscription makes an excellent gift! It’s a perfect way to introduce children to important concepts and provide them with a fun, educational reading experience.</p>",
            "text_size_b": "medium",
            "text_weight_b": "regular"
          }
        }
      },
