{%- style -%}
  .ssky-text-block__checkbox--individual-{{ block.id }} {
    color:{{ block.settings.custom_color }};
    text-align:{{ block.settings.alignment }};
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }   
  @media screen and (min-width: 750px) {
    .ssky-text-block__checkbox--individual-{{ block.id }} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__checkbox--individual-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
<div
  class="ssky-text-block__checkbox ssky-text-block__checkbox--individual ssky-text-block__checkbox--individual-{{ block.id }} left{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {{ block.shopify_attributes }}>
  <span class="svg-wrapper">
    {{- 'icon-checkmark.svg' | inline_asset_content -}}
  </span>
  <div class="rte">
    {{ block.settings.text }}
  </div>
</div>

{% schema %}
  {
    "name": "Checkbox individual",
    "settings": [
      {
        "type": "richtext",
        "id": "text",
        "label": "t:sections.ssky_text_block.blocks.checkbox_individual.settings.text.label",
        "default": "t:sections.ssky_text_block.blocks.checkbox_individual.settings.text.default"
      },
      {
        "type": "checkbox",
        "id": "text_large",
        "label": "t:sections.all.ssky_text_large.label",
        "default": true
      },
      {
        "type": "color",
        "id": "custom_color",
        "label": "Custom text color"
      },
      {
        "type": "select",
        "id": "alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "label": "Text alignment"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Checkbox individual" }
    ]
  }
{% endschema %}