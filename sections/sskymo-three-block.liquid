{%- style -%}
  .ssky-three-block-{{ section.id }} .ssky-three-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-three-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="ssky-three-block-{{ section.id }}">
  <div class="ssky-three-block gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="ssky-three-block__blocks">
        <div class="ssky-three-block__block-left">
          {%- for three_block_category in shop.metaobjects.three_block_category.values limit: 3 -%}
            {% case forloop.index %}
              {%- when 1 -%}
                <div class="ssky-three-block__block gradient color-scheme-2">
                  <h3 class="ssky-three-block__heading h4">
                    {{ three_block_category.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if three_block_category.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                  >
                    {{ three_block_category.description | metafield_tag }}
                  </div>
                  {%- if three_block_category.button_label != blank -%}
                    {% capture link_value %}{% render 'ssky-button-link', type: three_block_category %}{% endcapture %}
                    <a
                      {% if link_value == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ link_value | strip }}"
                      {% endif %}
                      class="ssky-three-block__button button button--primary"
                    >
                      {{ three_block_category.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if three_block_category.image != blank -%}
                    <div class="ssky-three-block__image">
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        three_block_category.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
              {%- when 2 -%}
                <div class="ssky-three-block__block gradient color-scheme-3">
                  <h3 class="ssky-three-block__heading h4">
                    {{ three_block_category.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if three_block_category.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                  >
                    {{ three_block_category.description | metafield_tag }}
                  </div>
                  {%- if three_block_category.button_label != blank -%}
                    {% capture link_value %}{% render 'ssky-button-link', type: three_block_category %}{% endcapture %}
                    <a
                      {% if link_value == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ link_value | strip }}"
                      {% endif %}
                      class="ssky-three-block__button button button--primary"
                    >
                      {{ three_block_category.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if three_block_category.image != blank -%}
                    <div class="ssky-three-block__image">
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        three_block_category.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="ssky-three-block__block-right">
          {%- for three_block_category in shop.metaobjects.three_block_category.values limit: 3 -%}
            {% case forloop.index %}
              {%- when 3 -%}
                <div class="ssky-three-block__block gradient color-scheme-4">
                  <h3 class="ssky-three-block__heading h4">
                    {{ three_block_category.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if three_block_category.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                  >
                    {{ three_block_category.description | metafield_tag }}
                  </div>
                  {%- if three_block_category.button_label != blank -%}
                    {% capture link_value %}{% render 'ssky-button-link', type: three_block_category %}{% endcapture %}
                    <a
                      {% if link_value == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ link_value | strip }}"
                      {% endif %}
                      class="ssky-three-block__button button button--primary"
                    >
                      {{ three_block_category.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if three_block_category.image != blank -%}
                    <div class="ssky-three-block__image">
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        three_block_category.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TTm Three block category",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_round_corners.heading",
      "info": "t:sections.all.ssky_round_corners.info"
    },
    {
      "type": "checkbox",
      "id": "top_left",
      "label": "t:sections.all.ssky_round_corners.top_left",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "top_right",
      "label": "t:sections.all.ssky_round_corners.top_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_right",
      "label": "t:sections.all.ssky_round_corners.bottom_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_left",
      "label": "t:sections.all.ssky_round_corners.bottom_left",
      "default": false
    },
    {
      "type": "color",
      "id": "corner_color",
      "label": "t:sections.all.ssky_round_corners.corner_color"
    }
  ],
  "presets": [
    {
      "name": "TTm Three block category"
    }
  ]
}
{% endschema %}
