    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "button_large", "label": "Large", "default": true },
        { "type": "checkbox", "id": "button_full", "label": "Full width", "default": true },
        { "type": "text", "id": "button_label", "label": "Label", "default": "Primary CTA" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "checkbox", "id": "button_style_secondary", "label": "Use secondary style", "default": false }
      ]
    },
    {
      "type": "milestones",
