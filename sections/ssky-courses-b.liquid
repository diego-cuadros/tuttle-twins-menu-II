{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .tt-courses-{{ ai_gen_id }} {
    padding: {{ section.settings.section_padding }}px 0;
  }

  .tt-courses__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .tt-courses__title-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 16px;
    color: {{ section.settings.heading_color }};
  }

  .tt-courses__description-{{ ai_gen_id }} {
    font-size: {{ section.settings.text_size }}px;
    max-width: 800px;
    margin: 0 auto;
    color: {{ section.settings.text_color }};
  }

  .tt-courses__slider-container-{{ ai_gen_id }} {
    position: relative;
    padding: 0 50px;
  }

  .tt-courses__slider-{{ ai_gen_id }} {
    display: flex;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    gap: 25px;
    padding-top: 10px;
    align-items: stretch; /* make slides equal height */
  }

  .tt-course-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    width: calc(33.333% - 20px);
    min-width: calc(33.333% - 20px);
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;   /* room for bottom shadow */
  }

  .tt-course-card-{{ ai_gen_id }} {
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.card_background_color }};
    transition: transform 0.3s ease;
    height: 100%;
    width: 98%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .tt-course-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .tt-course-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 */
    position: relative;
    overflow: hidden;
  }

  .tt-course-card__image-{{ ai_gen_id }} img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tt-course-card__image-{{ ai_gen_id }} svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
  }

  .tt-course-card__content-{{ ai_gen_id }} {
    padding: 20px;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .tt-course-card__title-{{ ai_gen_id }} {
    font-size: 20px;
    margin-bottom: 10px;
    color: {{ section.settings.card_title_color }};
    text-align: center;
  }

  /* Description: fixed visual height so listicles start aligned */
  .tt-course-card__description-{{ ai_gen_id }} {
    font-size: 14px;
    margin-bottom: 16px;
    color: {{ section.settings.card_text_color }};
    line-height: 1.4;
    min-height: 80px;
    max-height: 110px;
    overflow: hidden;

    /* Optional, nicer truncation for modern browsers */
    display: -webkit-box;
    -webkit-line-clamp: 5;          /* roughly 4 lines */
    -webkit-box-orient: vertical;
  }

  .tt-course-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-weight: 500;
    text-align: center;
    transition: background-color 0.3s ease;
    cursor: pointer;
    border: none;
    margin-top: auto; /* anchor button to bottom of content */
  }

  .tt-course-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--prev {
    left: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--next {
    right: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }

  .tt-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tt-modal-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .tt-modal__content-{{ ai_gen_id }} {
    position: relative;
    width: 90%;
    max-width: 800px;
    background-color: #fff;
    border-radius: 8px;
    overflow: hidden;
  }

  .tt-modal__close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    z-index: 10;
    border: none;
  }

  .tt-modal__video-container-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }

  .tt-modal__video-container-{{ ai_gen_id }} iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (max-width: 990px) {
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 15px);
      width: calc(50% - 15px);
      min-width: calc(50% - 15px);
    }
  }

  @media screen and (max-width: 749px) {
    .tt-courses__slider-container-{{ ai_gen_id }} {
      padding: 0;
    }
    
    .tt-courses__nav-button-{{ ai_gen_id }} {
      display: none;
    }
    
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
      display: flex;
    }
    
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
    }

    .tt-courses__title-{{ ai_gen_id }} {
      font-size: {{ section.settings.heading_size | minus: 6 }}px;
    }

    .tt-courses__description-{{ ai_gen_id }} {
      font-size: {{ section.settings.text_size | minus: 2 }}px;
    }
    
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} .tt-courses__nav-button-{{ ai_gen_id }} {
      display: flex;
      position: static;
      transform: none;
      margin: 0 5px;
    }
  }
{% endstyle %}

<div class="tt-courses-{{ ai_gen_id }} hs-courses-carousel" {{ section.shopify_attributes }}>
  <div class="page-width">
    {% if section.settings.title != blank or section.settings.description != blank %}
      <div class="tt-courses__header-{{ ai_gen_id }}">
        {% if section.settings.title != blank %}
          <h2 class="tt-courses__title-{{ ai_gen_id }}">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="tt-courses__description-{{ ai_gen_id }}">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="tt-courses__slider-container-{{ ai_gen_id }}">
      <button 
        class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--prev" 
        aria-label="Previous slide"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="tt-courses__slider-{{ ai_gen_id }}">
        {% assign course_index = 0 %}
        {% for course_block in section.blocks %}
          {% if course_block.type == 'course' %}
            {% assign course_index = course_index | plus: 1 %}
            <div class="tt-course-slide-{{ ai_gen_id }}" data-slide-index="{{ course_index | minus: 1 }}">
              <div class="tt-course-card-{{ ai_gen_id }}">
                <div class="tt-course-card__image-{{ ai_gen_id }}">
                  {% if course_block.settings.course_image %}
                    <img 
                      src="{{ course_block.settings.course_image | image_url: width: 600 }}" 
                      alt="{{ course_block.settings.course_title }}"
                      loading="lazy"
                      width="{{ course_block.settings.course_image.width }}"
                      height="{{ course_block.settings.course_image.height }}"
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>

                <div class="tt-course-card__content-{{ ai_gen_id }}">

                  {% if course_block.settings.course_icon %}
                    <div class="tt-course-card__content-icon-{{ ai_gen_id }} ssky-courses-icon-section">
                      {{ course_block.settings.course_icon | image_url: width: 300 | image_tag: class: 'ssky-courses-icon' }}
                    </div>
                  {% endif %}

                  <h3 class="tt-course-card__title-{{ ai_gen_id }}">{{ course_block.settings.course_title }}</h3>

                  <div class="tt-course-card__description-{{ ai_gen_id }}">
                    {{ course_block.settings.course_description }}
                  </div>

                  {% if course_block.settings.listicle_text_1 != blank or course_block.settings.listicle_text_2 != blank or course_block.settings.listicle_text_3 != blank or course_block.settings.listicle_text_4 != blank %}
