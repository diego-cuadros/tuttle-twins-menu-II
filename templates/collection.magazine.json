    "ssky_text_block_bV7r9c": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_yyL9Px": {
          "type": "heading",
          "settings": {
            "heading": "<p>Spark Curiosity With Magazine Subscriptions For Kids</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_M3d7HY": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>It can sometimes feel impossible to inspire your kids today with all of life's distractions. But what better way to motivate your child than with easy-to-read magazines that spark curiosity about how the world works?<br/><br/>Each monthly issue is made for kids aged 5 to 12 and includes:</p>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        },
        "checkbox_individual_RceYBa": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>An original Tuttle Twins short story that makes them think</strong></p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_irUUdq": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Articles about real-life issues like free markets and civic responsibility</strong></p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_pnzcD3": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Profiles of real-life young entrepreneurs</strong></p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_ECgkbE": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Activities including puzzles, games, and hands-on work</strong></p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_individual_NqCCqW": {
          "type": "checkbox_individual",
          "settings": {
            "text": "<p><strong>Parent Guide (PDF) for important conversations at the dinner table</strong></p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "text_RMGMfB": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>Our goal is to help children become independent thinkers who understand the principles that make a free society – all while having fun!</p><p>If you're a homeschooling parent or want to inspire your child, our membership offers engaging, story-based learning that teaches concepts like personal responsibility, free markets, and civic freedom, which are lessons that children don’t usually learn in school.</p>",
            "text_size": "regular",
            "text_weight": "regular"
          }
        }
