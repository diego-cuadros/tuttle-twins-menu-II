{{ 'ssky-timeline-block.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign parent_color_scheme = section.settings.color_scheme | downcase
  assign year_color_scheme_bottom = 'color-scheme-2'
  if parent_color_scheme == 'scheme-2'
    assign year_color_scheme_bottom = 'color-scheme-3'
  elsif parent_color_scheme == 'scheme-3'
    assign year_color_scheme_bottom = 'color-scheme-4'
  endif
-%}
{%- style -%}
  {%- if section.settings.merge_year_top and section.settings.year_top != blank -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      padding-top: 0;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block__year-top {
      margin-top: -{{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
        padding-top: 0;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
      .ssky-timeline-block-{{ section.id }} .ssky-timeline-block__year-top {
        margin-top: -{{ section.settings.padding_top }}px;
      }
    }
  {%- else -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
  {%- if section.settings.top_left -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-timeline-block-{{ section.id }} .ssky-timeline-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-timeline-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}
<div class="ssky-timeline-block-{{ section.id }}">
  <div class="ssky-timeline-block content-container color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'section_header' -%}
          <div class="ssky-timeline-block__section-header page-width" {{ block.shopify_attributes }}>
            <div class="ssky-text-block__blocks center">
              {%- if block.settings.caption != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.section_heading != blank -%}
                {%- assign section_heading_length = block.settings.section_heading | size -%}
                <h2
                  class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if section_heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.section_heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style_subheading }} {{ block.settings.color_class_subheading }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.subheading | escape }}
                </div>
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
    {%- if section.settings.year_top != blank -%}
      <div class="ssky-timeline-block__year-top-con page-width">
        <div class="ssky-timeline-block__year-top color-{{ section.settings.color_scheme_year_top }} gradient">
          {{ section.settings.year_top }}
        </div>
      </div>
    {%- endif -%}
    <div class="ssky-timeline-block__wrapper {{ section.settings.content_alignment }} page-width">
      {%- assign timeline_column_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'timeline_column' -%}
            {%- assign timeline_column_count = timeline_column_count | plus: 1 -%}
            <div class="ssky-timeline-block__column block-{{ timeline_column_count }} ssky-text-block__blocks color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="ssky-timeline-block__image-con image-size-ssky-{{ section.settings.image_size }}">
                  <div class="ssky-timeline-block__image">
                    <div
                      class="media{%- if block.settings.image_fit %} image-fit{%- endif -%}"
                      style="padding-bottom:{%- if block.settings.image_size == 'small' -%}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 150 }}%;{%- else -%}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | at_most: 100 }}%;{%- endif -%}"
                    >
                      {%- assign widths = '360, 535, 750, 1070, 1500' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        block.settings.image
                        | image_url: width: 1500
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  </div>
                </div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                {%- assign heading_length = block.settings.heading | size -%}
                <h2
                  class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.caption_b != blank -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style_b }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption_b | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
              {%- if block.settings.text_b != blank -%}
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size_b }} weight-{{ block.settings.text_weight_b }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.text_b }}
                </div>
              {%- endif -%}
            </div>
            {%- if section.settings.year_top != blank and timeline_column_count == 2 -%}
              <div class="ssky-timeline-block__divider"></div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.year_bottom != blank -%}
      <div class="ssky-timeline-block__year-bottom-con page-width">
        <div class="ssky-timeline-block__year-bottom {{ year_color_scheme_bottom }} gradient">
          {{ section.settings.year_bottom }}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "TT Timeline block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
