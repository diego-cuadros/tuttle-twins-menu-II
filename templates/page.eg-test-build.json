    "ssky_text_block_dKQQzt": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_MEdmjU": {
          "type": "heading",
          "settings": {
            "heading": "<p>Plus Activities to Bring the <br/>Learning to Life</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h0",
