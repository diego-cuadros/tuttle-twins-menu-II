            "title": "Spectacular Show Business",
            "description": "<p>Based on <em>Competition and Entrepreneurship by Israel Kirzner.</em></p>",
            "recommended_ages": "5-12",
            "popup_title": "The Tuttle Twins Learn About Competition & Entreprenuership",
            "popup_description": "<ul><li>Introduces kids to entrepreneurship, competition, and how businesses create value.</li><li>Follows Ethan and Emily as they learn what it takes to start a show—and succeed in the marketplace.</li><li>Teaches why competition, innovation, and customer choice make products and services better.</li></ul>"
          }
        }
