    "ssky_text_block_TJmTzi": {
      "type": "ssky-text-block",
      "blocks": {
        "heading_b3byJW": {
          "type": "heading",
          "settings": {
            "heading": "<h2>Educational Books for 7th Graders That Build Confident Thinkers</h2>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": false
          }
        },
        "text_XBeMcT": {
          "type": "text",
          "settings": {
            "max_width": 100,
            "custom_color": "",
            "alignment": "left",
            "text": "<p>Our books for 7th graders speak to kids who are ready for deeper ideas and stronger discussions. Middle school readers want stories that respect their growing independence. We write stories that connect <a href=\"https://tuttletwins.com/collections/american-history-for-kids\" title=\"https://tuttletwins.com/collections/american-history-for-kids\">American history</a>, <a href=\"https://www.tuttletwins.com/collections/economics-for-kids\" title=\"https://www.tuttletwins.com/collections/economics-for-kids\">economics</a>, personal responsibility, and character in ways kids can actually understand and talk about.<br/></p><p>Parents appreciate stories that lead naturally to good questions, and kids enjoy books that respect their age and intelligence. The result is reading kids enjoy now, and conversations that stick with them long after the chapter ends.<br/></p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        }
      },
      "block_order": [
        "heading_b3byJW",
        "text_XBeMcT"
      ],
      "name": "t:sections.ssky_text_block.name",
      "settings": {
        "content_alignment": "center",
        "max_width": 100,
        "color_scheme": "scheme-1",
        "twi_max_width": 120,
        "twi_margin": 20,
