{%- comment -%}Product-specific section only.{%- endcomment -%}
{%- if product.metafields.woo.cta_title != blank or product.metafields.woo.cta_description != blank -%}
  {%- liquid
    assign fetch_priority = 'auto'
    if section.index == 1
      assign fetch_priority = 'high'
    endif
    assign merging_with_section_below = false
    assign show_as_card = false
    assign narrow_width = false
    if section.settings.merging_with_section_below == true
      assign merging_with_section_below = true
    elsif section.settings.show_as_card == true
      assign show_as_card = true
    elsif section.settings.narrow_width == true
      assign narrow_width = true
    endif
  -%}
  {%- style -%}
    .product-ext-info-section-ssky .product-form__submit.button {
      min-width: 240px;
    }
    .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    {%- if section.settings.top_left -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        border-radius: 15vw 0 0 0;
      }
    {%- elsif section.settings.top_right -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        border-radius: 0 15vw 0 0;
      }
    {%- elsif section.settings.bottom_right -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        border-radius: 0 0 15vw 0;
      }
    {%- elsif section.settings.bottom_left -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        border-radius: 0 0 0 15vw;
      }
    {%- endif -%}
    {%- if section.settings.corner_color != blank -%}
      .ssky-text-image-block-{{ section.id }} {
        background-color: {{ section.settings.corner_color }};
      }
    {%- endif -%}
    {%- if merging_with_section_below -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block {
        z-index: 1;
      }
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      }
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__layout-merging-color {
        background-color: {{ section.settings.merging_color }};
      }
      {%- if section.settings.overflow_image > 0 -%}
        @media screen and (min-width: 1140px) {
          .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__layout-merging {
            padding-top: {{ section.settings.overflow_image |  divided_by: 2 }}px
          }
          .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
            overflow: unset;
            padding-top: 0 !important;
          }
          .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__image {
            margin-top: -{{ section.settings.overflow_image }}px;
          }
          .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__blocks {
            padding-top: 3.2rem;
          }
        }
      {%- endif -%}
      {%- if section.settings.remove_bottom_space -%}
        @media screen and (min-width: 990px) {
          .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
            padding-bottom: 0;
          }
        }
      {%- endif -%}
    {%- endif -%}
    {%- if show_as_card -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
        border-radius: 45px;
      }
      @media screen and (min-width: 750px) {
        .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
    {%- endif -%}
    {%- if narrow_width -%}
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__section-header {
        margin-bottom: 2rem;
      }
      .ssky-text-image-block-{{ section.id }} .ssky-text-image-block__wrapper {
        max-width: 1100px;
      }
    {%- endif -%}
  {%- endstyle -%}
  <div class="ssky-text-image-block-{{ section.id }}">
    <div class="ssky-text-image-block content-container product-ext-info-section-ssky color-{{ section.settings.color_scheme }} gradient {{ section.settings.custom_class }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'section_header' -%}
            <div class="ssky-text-image-block__section-header page-width" {{ block.shopify_attributes }}>
              <div class="ssky-text-block__blocks center">
                {%- if block.settings.caption != blank -%}
                  <div
                    class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.caption | escape }}
                  </div>
                {%- endif -%}
                {%- if block.settings.section_heading != blank -%}
                  {%- assign section_heading_length = block.settings.section_heading | size -%}
                  <h2
                    class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if section_heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.section_heading }}
                  </h2>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <div
                    class="ssky-text-block__caption {{ block.settings.text_style_subheading }} {{ block.settings.color_class_subheading }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.subheading | escape }}
                  </div>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
      {%- if merging_with_section_below -%}
        <div class="ssky-text-image-block__layout-merging{%- if section.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above page-width{%- endif -%}">
          <div class="color-{{ section.settings.color_scheme_layout_merging }} gradient">
      {%- endif -%}
      {%- if show_as_card -%}<div class="page-width">{%- endif -%}
      <div class="ssky-text-image-block__wrapper {{ section.settings.image_position }} image-size-ssky-{{ section.settings.image_size }} page-width{%- if show_as_card %} color-{{ section.settings.color_scheme_show_as_card }} gradient{%- endif -%}">
        <div class="ssky-text-image-block__image">
          <div
            class="{%- if section.settings.image != blank %}media{%- else %}placeholder{%- endif -%}{%- if section.settings.image_fit %} image-fit{%- endif -%}"
            style="padding-bottom:{%- if merging_with_section_below or narrow_width -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- elsif section.settings.image_size == 'small' -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 150 }}%;{%- else -%}{{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | at_most: 120 }}%;{%- endif -%}"
          >
            {% comment %}padding-bottom limit increased from 100% to 120% for normal conditions, on trial for sometime.{% endcomment %}
            {%- if section.settings.image != blank -%}
              {%- assign widths = '360, 535, 750, 1070, 1500' -%}
              {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="ssky-text-image-block__blocks ssky-text-block__blocks {{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'caption' -%}
                <div
                  class="ssky-text-block__caption {{ block.settings.text_style }} {{ block.settings.color_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.caption | escape }}
                </div>
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  {%- assign heading_length = block.settings.heading | size -%}
                  <h2
                    class="ssky-text-block__heading rte {{ block.settings.heading_size }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}

              {%- when 'text' -%}
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ product.metafields.woo.cta_description }}
                </div>
                <div
                  class="ssky-text-block__text rte text-{{ block.settings.text_size }} weight-{{ block.settings.text_weight }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {{ block.settings.text }}
                </div>
              {%- when 'icon' -%}
                <div
                  class="ssky-text-block__icon{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  <img src="{{ block.settings.icon | image_url: width: nil }}">
                </div>
              {%- when 'checkbox' -%}
                {%- if product.metafields.custom.section_ext_info_checkbox != blank -%}
                  {%- for checkbox in product.metafields.custom.section_ext_info_checkbox.value -%}
                    <div
                      class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {{ block.shopify_attributes }}
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-checkmark.svg' | inline_asset_content -}}
                      </span>
                      <div class="rte">
                        {{ checkbox }}
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div
                    class="ssky-text-block__checkbox{%- if block.settings.text_large %} text-body-large{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    <div class="rte">
                      {{ block.settings.text }}
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'button' -%}
  <div
    class="ssky-text-block__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} ssky-text-block__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {{ block.shopify_attributes }}
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
      style="--animation-order: {{ forloop.index }};"
    {% endif %}
  >
    {%- unless block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
      {%- comment -%}
        Only render the default Add to Cart when NO custom button labels are set.
      {%- endcomment -%}
      <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
      {%- assign section_product = product -%}
      {%- assign product_form_id = 'product-form-' | append: section.id | append: section_product.id -%}
      {%- render 'buy-buttons',
        product: section_product,
        product_form_id: product_form_id,
        section_id: section.id,
        is_button_large: true
      -%}
    {%- endunless -%}

    {%- if block.settings.button_label != blank -%}
      <a
        {% if block.settings.button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ block.settings.button_link }}"
        {% endif %}
        class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
      >
        {{- block.settings.button_label | escape -}}
      </a>
    {%- endif -%}

    {%- if block.settings.button_label_2 != blank -%}
      <a
        {% if block.settings.button_link_2 == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ block.settings.button_link_2 }}"
        {% endif %}
        class="button{%- if block.settings.button_large %} button--large{%- elsif block.settings.button_medium %} button--medium{%- endif -%}{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
      >
        {{- block.settings.button_label_2 | escape -}}
      </a>
    {%- endif -%}
  </div>

              {%- when 'number_counter' -%}
                <div class="ssky-text-block__ncounter-blocks" {{ block.shopify_attributes }}>
                  {%- if block.settings.text_a != blank -%}
                    <div class="ssky-text-block__ncounter-block">
                      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_a }}">
                        {{ block.settings.number_a }}
                      </div>
                      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_a }}</div>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text_b != blank -%}
                    <div class="ssky-text-block__ncounter-block">
                      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_b }}">
                        {{ block.settings.number_b }}
                      </div>
                      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_b }}</div>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text_c != blank -%}
                    <div class="ssky-text-block__ncounter-block">
                      <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_c }}">
                        {{ block.settings.number_c }}
                      </div>
                      <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_c }}</div>
                    </div>
                  {%- endif -%}
                  <script>
                    document.addEventListener('DOMContentLoaded', function () {
                      const sskyncounterIst = document.querySelector(
                        '.ssky-text-image-block-{{ section.id }} .ssky-text-block__ncounter'
                      );
                      const sskyncounters = document.querySelectorAll(
                        '.ssky-text-image-block-{{ section.id }} .ssky-text-block__ncounter'
                      );
                      const windowHeight = window.innerHeight;
                      const duration = 2000;
                      const countFunction = (sskyncounter, startTime) => {
                        const countValue = +sskyncounter.getAttribute('data-target');
                        const currentTime = Date.now();
                        const elapsedTime = currentTime - startTime;
                        const progress = Math.min(elapsedTime / duration, 1);
                        const count = Math.ceil(progress * countValue);
                        sskyncounter.innerText = count;
                        if (progress < 1) {
                          requestAnimationFrame(() => countFunction(sskyncounter, startTime));
                        }
                      };
                      const starCount = () => {
                        let sskyncounterIstPosition = sskyncounterIst.getBoundingClientRect().top;
                        if (sskyncounterIstPosition < windowHeight - 200) {
                          window.removeEventListener('scroll', starCount);
                          const startTime = Date.now();
                          sskyncounters.forEach((sskyncounter) => {
                            countFunction(sskyncounter, startTime);
                          });
                        }
                      };
                      window.addEventListener('scroll', starCount);
                    });
                  </script>
                </div>
              {%- when 'collection' -%}
                {%- assign collection_block = true -%}
              {%- when 'divider' -%}
                {%- assign divider_block = true -%}
            {%- endcase -%}
          {%- endfor -%}
          {%- if collection_block == true -%}
            <div class="ssky-text-block__collections">
              <ul>
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'collection' -%}
                      <li class="ssky-text-block__collection primary-orange text-body-large">
                        <a href="{{ block.settings.collection.url }}">{{ block.settings.collection.title }}</a>
                      </li>
                  {%- endcase -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- if show_as_card -%}</div>{%- endif -%}
      {%- if merging_with_section_below -%}
        </div>
        </div>
        <div
          class="ssky-text-image-block__layout-merging-color {%- if section.settings.merge_with_section_above %} ssky-text-image-block__layout-merging-above{%- endif -%}"
        ></div>
      {%- endif -%}
    </div>
    {%- if divider_block == true -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'divider' -%}
            <div class="page-width">
              <div class="ssky-text-image-block__divider" style="margin:{{ block.settings.margin }}px auto;"></div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "TTp Extended Info",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Visibility",
      "info": "Visible only when the 'Section Ext. Info:...' metafields has any value."
    },
    {
      "type": "paragraph",
      "content": "t:sections.all.ssky_layouts.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_fit",
      "label": "t:sections.all.image_fit.label",
      "default": true,
      "info": "t:sections.all.image_fit.info"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "image-left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "image-right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "image-left",
      "label": "Image position"
    },
    {
      "type": "select",
      "id": "image_size",
      "options": [
        {
          "value": "small",
          "label": "SM"
        },
        {
          "value": "smallplus",
          "label": "SM+"
        },
        {
          "value": "medium",
          "label": "MD"
        },
        {
          "value": "large",
          "label": "LG"
        }
      ],
      "default": "smallplus",
      "label": "Image size"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.ssky_text_block.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.ssky_text_block.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.narrow"
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.card"
    },
    {
      "type": "checkbox",
      "id": "show_as_card",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_show_as_card",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.ssky_layouts.merging"
    },
    {
      "type": "checkbox",
      "id": "merging_with_section_below",
      "label": "t:sections.all.ssky_layouts.activate",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_layout_merging",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "merging_color",
      "label": "Merging color",
      "default": "#bcecf6"
    },
    {
      "type": "range",
      "id": "overflow_image",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Overflow image from above",
      "info": "Use this when the text content is smaller than the image. Desktop only.",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "merge_with_section_above",
      "label": "t:sections.all.ssky_layouts.extension.merging_above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_space",
