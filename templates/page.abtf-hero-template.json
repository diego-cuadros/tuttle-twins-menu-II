    "ssky_text_image_block_hcrAJa": {
      "type": "ssky-text-image-block",
      "blocks": {
        "heading_geGL6T": {
          "type": "heading",
          "settings": {
            "heading": "<p>Parent with Confidence</p>",
            "heading_size": "h2",
            "heading_weight": "bold",
            "heading_tag": "h2"
          }
        },
        "caption_8XFT9d": {
          "type": "caption",
          "settings": {
            "caption": "Share Big Ideas and Powerful Truths in a Way Your Child Will Understand",
            "text_style": "medium-semibold",
            "color_class": ""
          }
        },
        "text_gf87aN": {
          "type": "text",
          "settings": {
            "text": "<p>Struggling to explain current events and complex world topics to your kids?<br/><br/>Experiencing some gaps in your own political and economic knowledge, and don’t have the time to catch up?<br/><br/>All you want is to ensure your values are passed on to your children to give them a foundation of truth to survive in today’s crazy world.<br/><br/><strong>The Tuttle Twins are here to help you.</strong></p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        }
