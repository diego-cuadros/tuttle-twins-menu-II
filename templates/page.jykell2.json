    "ssky_text_image_block_LHBb7C": {
      "type": "ssky-text-image-block",
      "blocks": {
        "section_header_yJzdHT": {
          "type": "section_header",
          "settings": {
            "section_heading": "<p>What Is Inflation?<br/>How Can We Fight Against It?</p>",
            "heading_size": "h1",
            "heading_weight": "semibold",
            "heading_tag": "h2",
            "subheading": "",
            "text_style_subheading": "large-bold",
            "color_class_subheading": "primary-blue",
            "caption": "",
            "text_style": "large-bold",
            "color_class": "primary-blue"
          }
        },
        "text_9mKbia": {
          "type": "text",
          "settings": {
            "text": "<p>Learning how money really works is one of the most important (and difficult) things to teach.</p><p>The Tuttle Twins use stories and illustrations to present these concepts in a fun and interesting way that children can easily understand.</p><p>In our book, inflation and markets come to life as Ethan and Emily explore a farmer’s market and county fair to understand just how controlling the “Creature from Jekyll Island” (the inflation monster) can be.</p><p>But what is the creature—and why can it raise prices and steal people’s money? And what exactly is money, anyway? Your children will discover the answers to these and other questions in this engaging and energetic book!</p><p><span style=\"text-decoration:underline\"><strong>And for a limited time, it’s yours—free.</strong></span> All you need to pay is the shipping cost!</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        }
      },
