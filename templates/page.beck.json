    "ssky_text_block_RWFiwN": {
      "type": "ssky-text-block",
      "blocks": {
        "caption_a9iwKC": {
          "type": "caption",
          "settings": {
            "caption": "Inspiring the Next Generation of Free Thinkers",
            "custom_color": "",
            "text_style": "small-semibold",
            "color_class": "white-center"
          }
        },
        "heading_eAfxhX": {
          "type": "heading",
          "settings": {
            "heading": "<p>What’s Inside<br/>The Tuttle Twins Book Series?</p>",
            "custom_color": "",
            "alignment": "center",
            "heading_size": "h1",
            "heading_weight": "bold",
            "heading_tag": "h2",
            "center": true
          }
        },
        "text_bPERJN": {
          "type": "text",
          "settings": {
            "max_width": 80,
            "custom_color": "",
            "alignment": "center",
            "text": "<p>There is no better way to teach your children about liberty than to read these books with them. They will learn how the world really works, including…</p>",
            "text_size": "medium",
            "text_weight": "regular"
          }
        },
        "checkbox_W9AL7b": {
          "type": "checkbox",
          "settings": {
            "text": "<p>Why a free <strong>market economy </strong>is the greatest way to lift people out of poverty and make the world better for everyone.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_eDk34z": {
          "type": "checkbox",
          "settings": {
            "text": "<p>How <strong>property rights </strong>allow us to decide what’s best for us and make better decisions for our family.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_nTMzNr": {
          "type": "checkbox",
          "settings": {
            "text": "<p>Why the world is a better place because of <strong>entrepreneurs </strong>who create businesses to help serve us and improve our lives.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_ppryTT": {
          "type": "checkbox",
          "settings": {
            "text": "<p>What <strong>true laws </strong>are, and why the government should protect our rights.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_Hjhe44": {
          "type": "checkbox",
          "settings": {
            "text": "<p>What <strong>socialism </strong>is and why it is so destructive to our freedoms and well-being.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_8ezL6K": {
          "type": "checkbox",
          "settings": {
            "text": "<p>How the <strong>Golden Rule </strong>encourages people to get along with one another, no matter where we live, what we look like, or what we believe.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_6zmxk3": {
          "type": "checkbox",
          "settings": {
            "text": "<p>Why true <strong>education </strong>(not just memorizing facts) is so important and why children should be allowed to learn things they are interested in.</p>",
            "text_large": true,
            "custom_color": "",
            "alignment": "left"
          }
        },
        "checkbox_LgULTC": {
          "type": "checkbox",
          "settings": {
            "text": "<p>…and so much more!</p>",
            "text_large": true,
