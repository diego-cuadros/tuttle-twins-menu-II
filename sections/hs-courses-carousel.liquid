{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .tt-courses-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .tt-courses__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .tt-courses__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin-bottom: 16px;
    color: {{ block.settings.heading_color }};
  }

  .tt-courses__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    max-width: 800px;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .tt-courses__slider-container-{{ ai_gen_id }} {
    position: relative;
    padding: 0 50px;
  }

  .tt-courses__slider-{{ ai_gen_id }} {
    display: flex;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    gap: 25px;
    padding-top: 10px;
  }

  .tt-course-slide-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 20px);
    scroll-snap-align: start;
    width: calc(33.333% - 20px);
    min-width: calc(33.333% - 20px);
  }

  .tt-course-card-{{ ai_gen_id }} {
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background_color }};
    transition: transform 0.3s ease;
    height: 98%;
    width: 98%;
    display: flex;
    flex-direction: column;
    /* Apply box-shadow to match border radius */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .tt-course-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .tt-course-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    position: relative;
    overflow: hidden;
  }

  .tt-course-card__image-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tt-course-card__image-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;background-color: #f4f4f4;
  }

  .tt-course-card__content-{{ ai_gen_id }} {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .tt-course-card__title-{{ ai_gen_id }} {
    font-size: 20px;
    margin-bottom: 10px;
    color: {{ block.settings.card_title_color }};
    text-align: center;
  }

  .tt-course-card__description-{{ ai_gen_id }} {
    font-size: 14px;
    margin-bottom: 20px;
    color: {{ block.settings.card_text_color }};
    flex-grow: 1;
  }

  .tt-course-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    text-align: center;
    transition: background-color 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .tt-course-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--prev {
    left: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}--next {
    right: 0;
  }

  .tt-courses__nav-button-{{ ai_gen_id }}.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
  }

  /* Modal styles */
  .tt-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tt-modal-{{ ai_gen_id }}.active {
    display: flex;
    opacity: 1;
  }

  .tt-modal__content-{{ ai_gen_id }} {
    position: relative;
    width: 90%;
    max-width: 800px;
    background-color: #fff;
    border-radius: 8px;
    overflow: hidden;
  }

  .tt-modal__close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    z-index: 10;
    border: none;
  }

  .tt-modal__video-container-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
  }

  .tt-modal__video-container-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (max-width: 990px) {
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 15px);
      width: calc(50% - 15px);
      min-width: calc(50% - 15px);
    }
  }

  @media screen and (max-width: 749px) {
    .tt-courses__slider-container-{{ ai_gen_id }} {
      padding: 0;
    }
    
    .tt-courses__nav-button-{{ ai_gen_id }} {
      display: none; /* Hide side buttons on mobile */
    }
    
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} {
      display: flex; /* Show bottom buttons on mobile */
    }
    
    .tt-course-slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
    
    }

    .tt-courses__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | minus: 6 }}px;
    }

    .tt-courses__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | minus: 2 }}px;
    }
    
    /* Ensure mobile nav buttons are properly styled */
    .tt-courses__nav-buttons-mobile-{{ ai_gen_id }} .tt-courses__nav-button-{{ ai_gen_id }} {
      display: flex;
      position: static;
      transform: none;
      margin: 0 5px;
    }
  }
{% endstyle %}

<div class="tt-courses-{{ ai_gen_id }} hs-courses-carousel" {{ block.shopify_attributes }}>
  <div class="page-width">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="tt-courses__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="tt-courses__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="tt-courses__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="tt-courses__slider-container-{{ ai_gen_id }}">
      <button 
        class="tt-courses__nav-button-{{ ai_gen_id }} tt-courses__nav-button-{{ ai_gen_id }}--prev" 
        aria-label="Previous slide"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.5 9L4.5 6L7.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

