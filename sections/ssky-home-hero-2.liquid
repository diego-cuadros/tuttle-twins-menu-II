        { "type": "url", 
          "id": "button_link_b", 
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_link.label" 
        },
        { "type": "text", 
          "id": "button_label_c", 
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_label.label", 
          "info": "t:sections.ssky_text_block.blocks.button.settings.button_label.info" 
        },
        { "type": "url", 
          "id": "button_link_c", 
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_link.label" 
        },
        { "type": "checkbox", 
          "id": "button_style_secondary", 
          "label": "t:sections.ssky_text_block.blocks.button.settings.button_style_secondary.label", 
          "default": false },
        { "type": "checkbox",
          "id": "button_style_teal",
          "label": "Use teal button style (Hero 2)",
