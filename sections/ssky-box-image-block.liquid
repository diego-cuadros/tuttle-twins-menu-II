                        <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_b }}">
                          {{ block.settings.number_b }}
                        </div>
                        <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_b }}</div>
                      </div>
                    {%- endif -%}
                    {%- if block.settings.text_c != blank -%}
                      <div class="ssky-text-block__ncounter-block">
                        <div class="ssky-text-block__ncounter" data-target="{{ block.settings.number_c }}">
                          {{ block.settings.number_c }}
                        </div>
                        <div class="ssky-text-block__ncounter-text rte">{{ block.settings.text_c }}</div>
                      </div>
                    {%- endif -%}
                    <script>
                      document.addEventListener('DOMContentLoaded', function () {
                        const sskyncounterIst = document.querySelector(
                          '.ssky-box-image-block-{{ section.id }} .ssky-text-block__ncounter'
                        );
                        const sskyncounters = document.querySelectorAll(
                          '.ssky-box-image-block-{{ section.id }} .ssky-text-block__ncounter'
                        );
                        const windowHeight = window.innerHeight;
                        const duration = 2000;
                        const countFunction = (sskyncounter, startTime) => {
                          const countValue = +sskyncounter.getAttribute('data-target');
                          const currentTime = Date.now();
                          const elapsedTime = currentTime - startTime;
                          const progress = Math.min(elapsedTime / duration, 1);
                          const count = Math.ceil(progress * countValue);
                          sskyncounter.innerText = count;
                          if (progress < 1) {
                            requestAnimationFrame(() => countFunction(sskyncounter, startTime));
                          }
                        };
                        const starCount = () => {
                          let sskyncounterIstPosition = sskyncounterIst.getBoundingClientRect().top;
                          if (sskyncounterIstPosition < windowHeight - 200) {
                            window.removeEventListener('scroll', starCount);
                            const startTime = Date.now();
                            sskyncounters.forEach((sskyncounter) => {
                              countFunction(sskyncounter, startTime);
                            });
                          }
                        };
                        window.addEventListener('scroll', starCount);
                      });
                    </script>
