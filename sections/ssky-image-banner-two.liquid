                    </div>
                  {%- when 'stats_block' -%}
                    <div class="banner__content-text">
                      <div 
                        class="ssky-testimonials__stats-block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" 
                        {{ block.shopify_attributes }}
                        {% if settings.animations_reveal_on_scroll %}
                          data-cascade
