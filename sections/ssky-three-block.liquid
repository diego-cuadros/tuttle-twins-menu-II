{%- style -%}
  .ssky-three-block-{{ section.id }} .ssky-three-block {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  {%- if section.settings.top_left -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 15vw 0 0 0;
    }
  {%- elsif section.settings.top_right -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 15vw 0 0;
    }
  {%- elsif section.settings.bottom_right -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 0 15vw 0;
    }
  {%- elsif section.settings.bottom_left -%}
    .ssky-three-block-{{ section.id }} .ssky-three-block {
      border-radius: 0 0 0 15vw;
    }
  {%- endif -%}
  {%- if section.settings.corner_color != blank -%}
    .ssky-three-block-{{ section.id }} {
      background-color: {{ section.settings.corner_color }};
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
<div class="ssky-three-block-{{ section.id }}">
  <div class="ssky-three-block gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <div class="ssky-three-block__blocks">
        <div class="ssky-three-block__block-left">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'block_one' -%}
                <div class="ssky-three-block__block gradient color-{{ block.settings.color_scheme }}">
                  <h3 class="ssky-three-block__heading h4" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if block.settings.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="ssky-three-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    <div class="ssky-three-block__image" {{ block.shopify_attributes }}>
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
              {%- when 'block_two' -%}
                <div class="ssky-three-block__block gradient color-{{ block.settings.color_scheme }}">
                  <h3 class="ssky-three-block__heading h4" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if block.settings.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="ssky-three-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    <div class="ssky-three-block__image" {{ block.shopify_attributes }}>
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="ssky-three-block__block-right">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'block_three' -%}
                <div class="ssky-three-block__block gradient color-{{ block.settings.color_scheme }}">
                  <h3 class="ssky-three-block__heading h4" {{ block.shopify_attributes }}>
                    {{ block.settings.heading }}
                  </h3>
                  <div
                    class="ssky-three-block__text rte"
                    {%- if block.settings.image == blank %}
                      style="max-width:100%;"
                    {%- endif -%}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="ssky-three-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_b != blank -%}
                    <div class="ssky-three-block__button-two">
                      <a
                        {% if block.settings.button_link_b == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.button_link_b }}"
                        {% endif %}
                        class="ssky-three-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.button_label_b | escape }}
                      </a>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.image != blank -%}
                    <div class="ssky-three-block__image" {{ block.shopify_attributes }}>
                      {%- assign widths = '360, 535, 600' -%}
                      {%- capture sizes -%}{%- render 'ssky-sizes-attr', width: 'half_width' -%}{%- endcapture -%}
                      {{
                        block.settings.image
                        | image_url: width: 600
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                      }}
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

